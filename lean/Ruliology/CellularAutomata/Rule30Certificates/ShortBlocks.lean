theorem all_short (t r : Nat) (he : Enc 14 t 0 r) (hr : Rule30FrontBound.Sstar.testBit r=true) :
    ∀ j : Nat, j<9 → ¬ (∀ i : Nat, i<14 → cell (t+j) (1+(i:Int))=true) := by
  have e0 := he
  have m0 := init r he.1 hr

  have e1 := enc_step e0

  have m1 := covers_sound (edge0 (cell (t+0) 0)) m0 (cell (t+0) (0+1+14))

  have e2 := enc_step e1

  have m2 := covers_sound (edge1 (cell (t+1) 0)) m1 (cell (t+1) (0+1+14))

  have e3 := enc_step e2

  have m3 := covers_sound (edge2 (cell (t+2) 0)) m2 (cell (t+2) (0+1+14))

  have e4 := enc_step e3

  have m4 := covers_sound (edge3 (cell (t+3) 0)) m3 (cell (t+3) (0+1+14))

  have e5 := enc_step e4

  have m5 := covers_sound (edge4 (cell (t+4) 0)) m4 (cell (t+4) (0+1+14))

  have e6 := enc_step e5

  have m6 := covers_sound (edge5 (cell (t+5) 0)) m5 (cell (t+5) (0+1+14))

  have e7 := enc_step e6

  have m7 := covers_sound (edge6 (cell (t+6) 0)) m6 (cell (t+6) (0+1+14))

  have e8 := enc_step e7

  have m8 := covers_sound (edge7 (cell (t+7) 0)) m7 (cell (t+7) (0+1+14))

  intro j hj

  by_cases h0 : j=0
  · subst j;exact noBlack14_sound (by decide : 14≤14) (by simpa using e0) m0 safe0

  by_cases h1 : j=1
  · subst j;exact noBlack14_sound (by decide : 14≤14) (by simpa using e1) m1 safe1

  by_cases h2 : j=2
  · subst j;exact noBlack14_sound (by decide : 14≤14) (by simpa using e2) m2 safe2

  by_cases h3 : j=3
  · subst j;exact noBlack14_sound (by decide : 14≤14) (by simpa using e3) m3 safe3

  by_cases h4 : j=4
  · subst j;exact noBlack14_sound (by decide : 14≤14) (by simpa using e4) m4 safe4

  by_cases h5 : j=5
  · subst j;exact noBlack14_sound (by decide : 14≤14) (by simpa using e5) m5 safe5

  by_cases h6 : j=6
  · subst j;exact noBlack14_sound (by decide : 14≤14) (by simpa using e6) m6 safe6

  by_cases h7 : j=7
  · subst j;exact noBlack14_sound (by decide : 14≤14) (by simpa using e7) m7 safe7

  by_cases h8 : j=8
  · subst j;exact noBlack14_sound (by decide : 14≤14) (by simpa using e8) m8 safe8

  omega
