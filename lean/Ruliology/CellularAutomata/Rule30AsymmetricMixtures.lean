theorem profile1 (i : Nat) : Const 10
    (applyWord 10 (List.replicate i false) (applyWord 10 (List.replicate 1 true) A4)) (decide (2≤i)) := by
  apply white_profile (by decide : 0<10) (d:=2) ?_ i
  intro j hj

  by_cases h0 : j=0
  · subst j

    exact const_sub (sub_trans (word_mono 10 black1 _) profile1_0) (constCheck_sound const1_0)

  by_cases h1 : j=1
  · subst j

    exact const_sub (sub_trans (word_mono 10 black1 _) profile1_1) (constCheck_sound const1_1)

  have he : j=2 := by omega
  subst j

  exact const_sub (sub_trans (word_mono 10 black1 _) profile1_2) (constCheck_sound const1_2)

