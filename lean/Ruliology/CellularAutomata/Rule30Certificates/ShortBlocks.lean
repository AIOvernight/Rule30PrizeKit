-- One rank per odd state; ordinary arithmetic, rechecked by the kernel.
def ranks : Nat := 
def rank (s : Nat) : Nat := (ranks >>> (6*(s/2))) % 64

theorem rank_verified :
    allBelow (Rule30RankCapture.point 14 46 Sstar rank) 8192 = true := by decide +kernel

theorem hcap : Sub (applyWord 14 (List.replicate 46 false) M1) Sstar := by
  apply Rule30RankCapture.capture rank_verified (by decide)
  intro s hs
  simpa only [M1, testBit_oddMaskAux, Bool.and_eq_true, decide_eq_true_eq] using hs

