import Rule30Equivalents.TFunctionCycles

/-!
# Rule 30's automaton group 2369: the states and the light cone

Read from the least significant bit, the integer step `Φ(x) = x ⊕ (2x ∨ 4x)` of rule 30 is a
3-state invertible Mealy automaton: `c = (c, a)`, `a = σ(b, a)`, `b = σ(c, a)`, with `c = Φ`
(`TFunction`). The group these states generate is automaton group 2369 in the classification of
groups generated by 3-state automata over a 2-letter alphabet (Bondarenko, Grigorchuk, Kravchenko,
Muntyan, Nekrashevych, Savchuk, Šunić, 2008), which lists it as self-replicating and not
contracting and leaves its isomorphism type open.

The three states are one rule-30 step of the half-line with the two cells beyond its edge frozen:
`PhiS s x = x ⊕ (2x ∨ 4x ∨ s)` with `s = 0` (white, white) for `c`, `s = 1` (white, black) for `b`
and `s = 3` (black, any) for `a`.

* `PhiS_zero`, `PhiS_one`, `PhiS_three`: `c = Φ`, `b = σ ∘ Φ` and `a = τ ∘ Φ`, where `σ` flips bit
  `0` and `τ` flips bit `0`, and bit `1` when bit `0` is `0`. Both change only the two lowest bits,
  so the group is `⟨Φ, σ, τ⟩`, and `⟨σ, τ⟩` is the 8-element automorphism group of the depth-2
  binary tree.
* `testBit_orbit_eq_of_agree` (**the light cone**): if `x` and `y` agree on every bit `≥ d`, then
  `Φⁿ(x)` and `Φⁿ(y)` agree on every bit `≥ d + 2n`. Bit `i` of `Φ(x)` reads only bits `i`, `i - 1`
  and `i - 2` of `x`.
* `conj_finitary`: so for every map `f` that changes only bits `< d`, the conjugate `Φⁿ f Φ⁻ⁿ`
  changes only bits `< d + 2n`: it is finitary of depth at most `d + 2n`.
* `orbit_zero`, `testBit_orbit_one_two_mul`: `Φⁿ σ Φ⁻ⁿ` sends `0 = Φⁿ(0)` to `Φⁿ(1)`, row `n` of
  the seed, whose bit `2n` is set; so its depth is exactly `2n + 1`, and these conjugates are
  pairwise distinct.

**Consequence** (proved in the notes, not here): the conjugates `Φⁿ f Φ⁻ⁿ` (`n ≥ 0`, `f ∈ ⟨σ, τ⟩`)
generate a group `L` of finitary automorphisms, which is locally finite, with `Φ L Φ⁻¹ ⊆ L`. The
normal closure of `⟨σ, τ⟩` is the ascending union of the `Φ⁻ᵐ L Φᵐ`, a locally finite 2-group,
and `Φ` has infinite order. So group 2369 is an ascending HNN extension of a locally finite
2-group: it is (locally finite)-by-`ℤ`, hence elementary amenable, of exponential growth, and not
finitely presented. The argument is the one P. V. Silva and B. Steinberg use for reset automata
(Int. J. Algebra Comput. 15 (2005)); the automaton here is 2-definite rather than reset.
-/

namespace Rule30Equivalents.AutomatonGroup

open Rule30Equivalents.TFunction (Phi orbit low testBit_Phi low_congr testBit_orbit)
open IntegerRows (testBit_two_mul testBit_four_mul)

/-- One rule-30 step of the half-line with the two cells beyond its edge frozen to `s`:
`c = PhiS 0`, `b = PhiS 1`, `a = PhiS 3`. -/
def PhiS (s x : ℕ) : ℕ := x ^^^ ((2 * x) ||| (4 * x) ||| s)

theorem PhiS_zero (x : ℕ) : PhiS 0 x = Phi x := by
  simp [PhiS, Phi]

theorem testBit_one_eq (j : ℕ) : (1 : ℕ).testBit j = decide (j = 0) := by
  rcases j with _ | j
  · decide
  · simp [Nat.testBit_succ]

theorem testBit_three_eq (j : ℕ) : (3 : ℕ).testBit j = decide (j < 2) := by
  rcases j with _ | _ | j
  · decide
  · decide
  · simp [Nat.testBit_succ]

/-- **`b = σ ∘ Φ`**: the white-black boundary flips bit `0` of `Φ(x)`. -/
theorem PhiS_one (x : ℕ) : PhiS 1 x = Phi x ^^^ 1 := by
  apply Nat.eq_of_testBit_eq
  intro i
  simp only [PhiS, Phi, Nat.testBit_xor, Nat.testBit_or, testBit_two_mul, testBit_four_mul,
    testBit_one_eq]
  rcases i with _ | i
  · simp
  · simp

/-- **`a = τ ∘ Φ`**: the black boundary flips bit `0` of `Φ(x)`, and bit `1` when bit `0` of `x`
(which is bit `0` of `Φ(x)`) is `0`. -/
theorem PhiS_three (x : ℕ) : PhiS 3 x = Phi x ^^^ (if x % 2 = 0 then 3 else 1) := by
  apply Nat.eq_of_testBit_eq
  intro i
  have h0 : x.testBit 0 = decide (x % 2 = 1) := Nat.testBit_zero x
  by_cases h : x % 2 = 0
  · rw [if_pos h]
    have hx0 : x.testBit 0 = false := by rw [h0]; simp [h]
    simp only [PhiS, Phi, Nat.testBit_xor, Nat.testBit_or, testBit_two_mul, testBit_four_mul,
      testBit_three_eq]
    rcases i with _ | _ | i
    · simp
    · simp [hx0]
    · have hi : ¬ (i + 1 + 1 < 2) := by omega
      simp [hi]
  · rw [if_neg h]
    have hx0 : x.testBit 0 = true := by
      rw [h0]
      simp only [decide_eq_true_eq]
      omega
    simp only [PhiS, Phi, Nat.testBit_xor, Nat.testBit_or, testBit_two_mul, testBit_four_mul,
      testBit_one_eq, testBit_three_eq]
    rcases i with _ | _ | i
    · simp
    · simp [hx0]
    · have hi : ¬ (i + 1 + 1 < 2) := by omega
      simp [hi]

/-- **The light cone.** If `x` and `y` agree on every bit `≥ d`, then `Φⁿ(x)` and `Φⁿ(y)` agree on
every bit `≥ d + 2n`. -/
theorem testBit_orbit_eq_of_agree {x y d : ℕ} (h : ∀ i, d ≤ i → x.testBit i = y.testBit i) :
    ∀ n i, d + 2 * n ≤ i → (orbit x n).testBit i = (orbit y n).testBit i := by
  intro n
  induction n with
  | zero => intro i hi; exact h i (by omega)
  | succ n ih =>
    intro i hi
    show (Phi (orbit x n)).testBit i = (Phi (orbit y n)).testBit i
    rw [testBit_Phi, testBit_Phi, ih i (by omega)]
    congr 1
    unfold low
    rw [ih (i - 1) (by omega), ih (i - 2) (by omega)]

/-- **Forward conjugates are finitary.** If `f` changes only bits `< d`, then `Φⁿ ∘ f ∘ Φ⁻ⁿ`
changes only bits `< d + 2n`: `Φⁿ(f x)` and `Φⁿ(x)` agree on every bit `≥ d + 2n`. -/
theorem conj_finitary {f : ℕ → ℕ} {d : ℕ} (hf : ∀ x i, d ≤ i → (f x).testBit i = x.testBit i)
    (x n : ℕ) : ∀ i, d + 2 * n ≤ i → (orbit (f x) n).testBit i = (orbit x n).testBit i :=
  testBit_orbit_eq_of_agree (fun i hi => hf x i hi) n

theorem orbit_zero : ∀ n, orbit 0 n = 0
  | 0 => rfl
  | n + 1 => by
    show Phi (orbit 0 n) = 0
    rw [orbit_zero n]
    rfl

/-- Bit `2n` of `Φⁿ(1)` is the left edge of row `n` of the seed: black. -/
theorem testBit_orbit_one_two_mul (n : ℕ) : (orbit 1 n).testBit (2 * n) = true := by
  rw [testBit_orbit]
  have := Ruliology.CellularAutomata.Rule30FiniteConfigs.evol_left_edge (x := TFunction.row 1) (lo := 0)
    (by simp [TFunction.row]) (fun p hp => by
      simp only [TFunction.row]
      rw [if_pos (by omega), testBit_one_eq]
      simp only [decide_eq_false_iff_not]
      omega) n
  rw [show ((n : Int) - ((2 * n : ℕ) : Int)) = 0 - (n : Int) by omega]
  exact this

/-- **The conjugates `Φⁿ σ Φ⁻ⁿ` have depth exactly `2n + 1`**: they change only bits `≤ 2n`
(`conj_finitary` with `d = 1`), and on `Φⁿ(0) = 0` they change bit `2n`, since `σ 0 = 1` and
bit `2n` of `Φⁿ(1)` is set. -/
theorem conj_sigma_depth (n : ℕ) :
    (∀ x i, 2 * n + 1 ≤ i → (orbit (x ^^^ 1) n).testBit i = (orbit x n).testBit i) ∧
      (orbit (0 ^^^ 1) n).testBit (2 * n) ≠ (orbit 0 n).testBit (2 * n) := by
  refine ⟨fun x i hi => ?_, ?_⟩
  · refine conj_finitary (f := fun x => x ^^^ 1) (d := 1) (fun x i hi => ?_) x n i (by omega)
    obtain ⟨j, rfl⟩ : ∃ j, i = j + 1 := ⟨i - 1, by omega⟩
    show (x ^^^ 1).testBit (j + 1) = x.testBit (j + 1)
    rw [Nat.testBit_xor, testBit_one_eq]
    simp
  · rw [show (0 : ℕ) ^^^ 1 = 1 from rfl, testBit_orbit_one_two_mul, orbit_zero, Nat.zero_testBit]
    decide

end Rule30Equivalents.AutomatonGroup
