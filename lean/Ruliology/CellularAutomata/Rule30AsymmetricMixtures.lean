def Controlled (w : List Bool) : Prop := ∀ i, i < w.length → ∃ b : Bool,
  ∀ r, r < 2^10 → (applyWord 10 (w.take i) A4).testBit r = true →
    (w.getD i false || r.testBit 0) = b

theorem controlled_driver (a : Nat × Nat) (ha : Good a) : Controlled (driver a) := by
  intro i hi
  by_cases hir : i<a.1
  · refine ⟨true, fun r hr hm => ?_⟩
    rw [driver, word_getD]; simp [hir]
  · have htake : (driver a).take i = List.replicate a.1 true ++ List.replicate (i-a.1) false := by
      have hi' : i-a.1 ≤ a.2 := by simp only [driver, word, List.length_append, List.length_replicate] at hi; omega
      simp [driver, word, List.take_append, List.take_replicate, Nat.min_eq_right (by omega : a.1≤i), Nat.min_eq_left hi']
    rcases ha with ⟨hr,hq⟩ | ⟨hr,hq⟩
    · refine ⟨decide (2≤i-1), fun r hs hm => ?_⟩
      rw [htake, apply_append, hr] at hm
      have hh := profile1 (i-1) r hs hm
      rw [driver, word_getD, hr]
      have hn : ¬i<1 := by omega
      simpa only [hn, decide_false, Bool.false_or] using hh
    · refine ⟨true, fun r hs hm => ?_⟩
      rw [htake, apply_append, hr] at hm
      have hh := profile2 (i-2) r hs hm
      rw [driver, word_getD, hr]
      have hn : ¬i<2 := by omega
      simpa only [hn, decide_false, Bool.false_or, Nat.zero_le, decide_true] using hh

theorem controlled_append (u v : List Bool) (hu : Controlled u) (hv : Controlled v)
    (hclosed : Sub (applyWord 10 u A4) A4) : Controlled (u++v) := by
  intro i hi
  by_cases hleft : i < u.length
  · obtain ⟨b,hb⟩ := hu i hleft
    refine ⟨b, fun r hr hm => ?_⟩
    have ht : (u++v).take i = u.take i := by
      simp [List.take_append, Nat.sub_eq_zero_of_le (Nat.le_of_lt hleft)]
    have hg : (u++v).getD i false = u.getD i false := by
      simp [List.getD_eq_getElem?_getD, List.getElem?_append, hleft]
    rw [ht] at hm
    rw [hg]
    exact hb r hr hm
  · have hlen : u.length ≤ i := by omega
    have hright : i-u.length < v.length := by simp only [List.length_append] at hi; omega
    obtain ⟨b,hb⟩ := hv (i-u.length) hright
    refine ⟨b, fun r hr hm => ?_⟩
    have ht : (u++v).take i = u ++ v.take (i-u.length) := by
      simp [List.take_append, List.take_of_length_le hlen]
    have hg : (u++v).getD i false = v.getD (i-u.length) false := by
      simp [List.getD_eq_getElem?_getD, List.getElem?_append, hleft]
    rw [ht, apply_append] at hm
    have hs := word_mono 10 hclosed (v.take (i-u.length)) r hm
    rw [hg]
    exact hb r hr hs

theorem all_blocks_stable (B : Nat)
    (one : ∀ a, Good a → Sub (applyWord 10 (driver a) B) B)
    (as : List (Nat × Nat)) (ha : Admissible as) : Sub (applyWord 10 (blocks as) B) B := by
  induction as with
  | nil => exact sub_refl B
  | cons a as ih =>
    have ha0 := ha a (by simp)
    have has : Admissible as := fun b hb => ha b (by simp [hb])
    change Sub (applyWord 10 (driver a ++ blocks as) B) B
    rw [apply_append]
    exact sub_trans (word_mono 10 (one a ha0) (blocks as)) (ih has)

theorem blocks_progress (A B : Nat)
    (one : ∀ a, Good a → Sub (applyWord 10 (driver a) A) B)
    (stable : ∀ a, Good a → Sub (applyWord 10 (driver a) B) B)
    (as : List (Nat × Nat)) (hne : as≠[]) (ha : Admissible as) :
    Sub (applyWord 10 (blocks as) A) B := by
  cases as with
  | nil => exact (hne rfl).elim
  | cons a as =>
    change Sub (applyWord 10 (driver a ++ blocks as) A) B
    rw [apply_append]
    exact sub_trans (word_mono 10 (one a (ha a (by simp))) (blocks as))
      (all_blocks_stable B stable as (fun b hb => ha b (by simp [hb])))


theorem stable1 (a : Nat × Nat) (ha : Good a) : Sub (applyWord 10 (driver a) A1) A1 := sub_trans (stage1 a ha) nested2

theorem stable2 (a : Nat × Nat) (ha : Good a) : Sub (applyWord 10 (driver a) A2) A2 := sub_trans (stage2 a ha) nested3

theorem stable3 (a : Nat × Nat) (ha : Good a) : Sub (applyWord 10 (driver a) A3) A3 := sub_trans (stage3 a ha) nested4

theorem blocks_warm (as : List (Nat × Nat)) (hne : as≠[]) (ha : Admissible as) :
    Sub (iterW 10 (blocks as) 4 (fullSet 10)) A4 := by
  have h0 := blocks_progress A0 A1 stage0 stable1 as hne ha
  have h1 := blocks_progress A1 A2 stage1 stable2 as hne ha
  have h2 := blocks_progress A2 A3 stage2 stable3 as hne ha
  have h3 := blocks_progress A3 A4 stage3 stage4 as hne ha
  have hh := sub_trans (word_mono 10 (sub_trans (word_mono 10 (sub_trans (word_mono 10 h0 _) h1) _) h2) _) h3
  have full_A0 : fullSet 10 = A0 := by decide +kernel
  simpa only [iterW, full_A0] using hh

theorem controlled_blocks (as : List (Nat × Nat)) (ha : Admissible as) :
    Controlled (blocks as) := by
  induction as with
  | nil => intro i hi; exact (Nat.not_lt_zero _ hi).elim
  | cons a as ih =>
    have ha0 := ha a (by simp)
    have has : Admissible as := fun b hb => ha b (by simp [hb])
    exact controlled_append _ _ (controlled_driver a ha0)
      (ih has) (stage4 a ha0)


theorem blocks_length_pos (as : List (Nat × Nat)) (hne : as≠[]) (ha : Admissible as) :
    0<(blocks as).length := by
  cases as with
  | nil => exact (hne rfl).elim
  | cons a as =>
    have hh := ha a (by simp)
    change 0<(driver a ++ blocks as).length
    simp only [List.length_append, driver, word, List.length_replicate]
    rcases hh with ⟨hh,_⟩ | ⟨hh,_⟩ <;> omega

/-- Arbitrary mixtures of single black runs with gaps >=10 and double black
runs with gaps >=8 are excluded, with arbitrary onset and block count. -/
theorem not_eventually_asymmetric_mixtures (as : List (Nat × Nat)) (hne : as≠[])
    (ha : ∀ a∈as, (a.1=1 ∧ 10≤a.2) ∨ (a.1=2 ∧ 8≤a.2)) :
    ¬ EventuallyWord (as.flatMap (fun a => List.replicate a.1 true ++ List.replicate a.2 false)) := by
  classical
  change ¬ EventuallyWord (blocks as)
  have hc := controlled_blocks as ha
  let g : Nat → Bool := fun i => if hi : i<(blocks as).length then Classical.choose (hc i hi) else false
  apply no_word_of_invariant 10 (by decide) (blocks as) A4 4 g (blocks_length_pos as hne ha)
    (blocks_warm as hne ha) (all_blocks_stable A4 stage4 as ha)
  intro i hi
  simpa only [g, dite_eq_left hi] using Classical.choose_spec (hc i hi)
end Ruliology.CellularAutomata.Rule30AsymmetricMixtures
