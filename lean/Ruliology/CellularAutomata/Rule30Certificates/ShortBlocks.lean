  have e5 : Enc 14 (t+5) (5:Int) (coreStep 16 r4) := by simpa using enc_core_step e4

  let r5 := coreStep 16 r4

  have m5 := core_sound edge4 m4

  have e6 : Enc 12 (t+6) (6:Int) (coreStep 14 r5) := by simpa using enc_core_step e5

  let r6 := coreStep 14 r5

  have m6 := core_sound edge5 m5

  have e7 : Enc 10 (t+7) (7:Int) (coreStep 12 r6) := by simpa using enc_core_step e6

  let r7 := coreStep 12 r6

  have m7 := core_sound edge6 m6

  have e8 : Enc 8 (t+8) (8:Int) (coreStep 10 r7) := by simpa using enc_core_step e7

  let r8 := coreStep 10 r7

  have m8 := core_sound edge7 m7

  intro j hj

  by_cases h0 : j=0
  · subst j;exact noBlack_sound (by decide : 14≤24) (by decide : 0+14≤14) e0 m0 safe0

  by_cases h1 : j=1
  · subst j;exact noBlack_sound (by decide : 13≤22) (by decide : 1+13≤14) e1 m1 safe1

  by_cases h2 : j=2
  · subst j;exact noBlack_sound (by decide : 12≤20) (by decide : 2+12≤14) e2 m2 safe2

