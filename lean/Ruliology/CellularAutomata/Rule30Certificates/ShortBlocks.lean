namespace Ruliology.CellularAutomata.Rule30FrontFrame
open Rule30StripCertificates Rule30Jen Rule30FrontClock
theorem physical_clock (t n : Nat) (d : Int) (hn : 33≤n) (hd : (n:Int)<d)
    (hf : Front t d) (hc : ∀ i, i<n → cell (t+i) 0=false) :
    ∃ r, r∈C33 ∧ Enc 24 (t+n) (d-(n:Int)-1) r := by
  let r0 := encRow t (d-1) 24
  have he := enc_encRow 24 t (d-1)
  have hbit : r0.testBit 0=true := by
    change (encRow t (d-1) 24).testBit 0=true
    rw [he.2 0 (by decide)]
    simpa using hf.1
  have hm := sync24_forever r0 hbit (n-33)
  have hni : n-33+33=n := by omega
  rw [hni] at hm
  exact ⟨_,hm,enc_front_iter hd hf he hc⟩


end Ruliology.CellularAutomata.Rule30FrontFrame


