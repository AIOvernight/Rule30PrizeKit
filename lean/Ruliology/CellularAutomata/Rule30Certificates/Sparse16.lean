module

public import Lean
public import Ruliology.CellularAutomata.Rule30PeriodTwoSideways
public import Ruliology.CellularAutomata.Rule30Prize
public import Ruliology.CellularAutomata.Rule30ZeroBoundaryLanes

/-!
# Sparse16: exhaustive packed boundary-history certificate

This module contains the scalar semantics, proved stable compaction, exact decoder and
112 kernel-checked frontiers for the budget-16, depth-111 boundary-history search.
Every finite boundary history satisfying the required even observations is accounted for;
the cost is the number of black cells reconstructed in the first 111 initial positions.
The terminal frontier is empty. No bound on the rest of the initial half-line is imposed.
The universal exclusion and its five consequences are in `Rule30Sparse16`.

Research and formalization by OpenAI Codex for @AIOvernight. The finite computation is verified by the
ordinary Lean kernel; no external execution or unproved compaction premise is trusted.
-/

@[expose] public section

set_option Elab.async false
namespace Ruliology.CellularAutomata.Rule30Sparse16
namespace PackedDigits
/-- Little-endian radix digits, used as a mathematical reference for packed lanes. -/
def pack (radix : Nat) : List Nat → Nat
 | [] => 0
 | a :: xs => a + radix * pack radix xs

def Bounded (radix : Nat) (xs : List Nat) : Prop := ∀ a ∈ xs, a < radix

theorem pack_lt {radix : Nat} {xs : List Nat} (h : Bounded radix xs) :
    pack radix xs < radix ^ xs.length := by
  induction xs with
  | nil => simp [pack]
  | cons a xs ih =>
    have ha : a < radix := h a (by simp)
    have ht : Bounded radix xs := by intro b hb; exact h b (by simp [hb])
    have hh := ih ht
    have hm := Nat.mul_le_mul_left radix (Nat.succ_le_of_lt hh)
    simp only [Nat.mul_succ] at hm
    simp only [pack, List.length_cons, Nat.pow_succ]
    have hsum : a + radix * pack radix xs < radix * radix ^ xs.length := by omega
    simpa [Nat.mul_comm] using hsum

theorem pack_head {radix a : Nat} (xs : List Nat) (ha : a < radix) :
    pack radix (a :: xs) % radix = a := by
  simp [pack, Nat.add_mod, Nat.mod_eq_of_lt ha]

theorem pack_tail {radix a : Nat} (xs : List Nat) (ha : a < radix) :
    pack radix (a :: xs) / radix = pack radix xs := by
  have hr : 0 < radix := Nat.lt_of_le_of_lt (Nat.zero_le _) ha
  simp [pack, Nat.add_mul_div_left, Nat.div_eq_of_lt ha, hr]

/-- Radix addition acts pointwise whenever equal-length digit lists are paired.
Boundedness is required later for interpreting the resulting digits. -/
theorem pack_zip_add {radix : Nat} {xs ys : List Nat} (hlen : xs.length = ys.length) :
    pack radix (List.zipWith (· + ·) xs ys) = pack radix xs + pack radix ys := by
  induction xs generalizing ys with
  | nil => cases ys <;> simp_all [pack]
  | cons a xs ih =>
    cases ys with
    | nil => simp at hlen
    | cons b ys =>
      have hh : xs.length = ys.length := by simpa using hlen
      simp only [List.zipWith, pack, ih hh, Nat.mul_add]
      omega

def digit (radix value index : Nat) : Nat := value / radix ^ index % radix

/-- The radix digit observed at an index is exactly its list payload. -/
theorem pack_digit {radix : Nat} {xs : List Nat} (h : Bounded radix xs) :
    ∀ index, digit radix (pack radix xs) index = (xs[index]?).getD 0 := by
  induction xs with
  | nil => intro index; simp [pack, digit]
  | cons a xs ih =>
    have ha : a < radix := h a (by simp)
    have ht : Bounded radix xs := by intro b hb; exact h b (by simp [hb])
    intro index
    cases index with
    | zero => simpa [digit] using pack_head xs ha
    | succ index =>
      have he : (pack radix (a :: xs) / radix) / radix ^ index =
          pack radix (a :: xs) / radix ^ (index + 1) := by
        rw [Nat.div_div_eq_div_mul, Nat.pow_succ, Nat.mul_comm radix]
      simp only [digit]
      rw [← he, pack_tail xs ha]
      simpa [digit] using ih ht index

/-- With bounded digit sums, addition has exactly the pointwise sum digits;
no carry can leak from an earlier packed lane into a later lane. -/
theorem add_digit_no_carry {radix : Nat} {xs ys : List Nat}
    (hlen : xs.length = ys.length)
    (hsum : Bounded radix (List.zipWith (· + ·) xs ys)) (index : Nat) :
    digit radix (pack radix xs + pack radix ys) index =
      ((List.zipWith (· + ·) xs ys)[index]?).getD 0 := by
  rw [← pack_zip_add hlen]
  exact pack_digit hsum index

theorem pack_append (radix : Nat) (xs ys : List Nat) :
    pack radix (xs ++ ys) = pack radix xs + radix ^ xs.length * pack radix ys := by
  induction xs with
  | nil => simp [pack]
  | cons a xs ih =>
    simp only [List.cons_append, pack, ih, List.length_cons, Nat.pow_succ,
      Nat.mul_add, Nat.mul_assoc]
    rw [Nat.mul_left_comm radix (radix ^ xs.length) (pack radix ys)]
    omega

theorem pack_zeros (radix count : Nat) : pack radix (List.replicate count 0) = 0 := by
  induction count with
  | zero => simp [pack]
  | succ count ih => simp [List.replicate_succ, pack, ih]

/-- Left shifts insert empty lanes, expressed without bitwise assumptions. -/
theorem pack_shift (radix count : Nat) (xs : List Nat) :
    pack radix (List.replicate count 0 ++ xs) = radix ^ count * pack radix xs := by
  rw [pack_append, pack_zeros]
  simp

/-- Cutting off high lanes is exactly modulus by the corresponding radix power. -/
theorem pack_take {radix : Nat} {xs : List Nat} (h : Bounded radix xs) (count : Nat) :
    pack radix (xs.take count) = pack radix xs % radix ^ count := by
  induction count generalizing xs with
  | zero => simp [pack, Nat.mod_one]
  | succ count ih =>
    cases xs with
    | nil => simp [pack]
    | cons a xs =>
      have ha : a < radix := h a (by simp)
      have ht : Bounded radix xs := by intro b hb; exact h b (by simp [hb])
      rw [Nat.pow_succ, Nat.mul_comm (radix ^ count) radix, Nat.mod_mul]
      rw [pack_head xs ha, pack_tail xs ha]
      simp only [List.take_succ_cons, pack, ih ht]
theorem pack_shift_bits (width count : Nat) (xs : List Nat) :
    pack (2^width) (List.replicate count 0 ++ xs) =
      pack (2^width) xs <<< (width * count) := by
  rw [pack_shift, Nat.shiftLeft_eq, ← Nat.pow_mul]
  exact Nat.mul_comm _ _

theorem pack_mask_bits {width : Nat} {xs : List Nat}
    (h : Bounded (2^width) xs) (count : Nat) :
    pack (2^width) (xs.take count) =
      pack (2^width) xs &&& ((1 <<< (width * count)) - 1) := by
  rw [Nat.one_shiftLeft, Nat.and_two_pow_sub_one_eq_mod, Nat.pow_mul]
  exact pack_take h count

theorem bounded_zero_append {radix : Nat} {xs : List Nat}
    (hr : 0 < radix) (h : Bounded radix xs) (count : Nat) :
    Bounded radix (List.replicate count 0 ++ xs) := by
  intro a ha
  rcases List.mem_append.mp ha with hz | hx
  · have he : a = 0 := (List.mem_replicate.mp hz).2
    simpa [he] using hr
  · exact h a hx

/-- List-level reference for one parallel prefix-sum doubling operation. -/
def prefixStep (step : Nat) (xs : List Nat) : List Nat :=
    List.zipWith (· + ·) xs ((List.replicate step 0 ++ xs).take xs.length)

/-- The actual shift/mask/add primitive computes precisely its list-level
reference. Bounded resulting digits are a separate no-carry invariant. -/
theorem prefixStep_packed {width : Nat} {xs : List Nat}
    (h : Bounded (2^width) xs) (step : Nat) :
    pack (2^width) (prefixStep step xs) = pack (2^width) xs +
      ((pack (2^width) xs <<< (width * step)) &&&
        ((1 <<< (width * xs.length)) - 1)) := by
  unfold prefixStep
  have hlen : xs.length = ((List.replicate step 0 ++ xs).take xs.length).length := by
    simp only [List.length_take, List.length_append, List.length_replicate]
    omega
  rw [pack_zip_add hlen]
  have hb := bounded_zero_append (Nat.two_pow_pos width) h step
  rw [pack_mask_bits hb xs.length, pack_shift_bits]
/-- Sliding count window, expressed by cumulative counts rather than list sums. -/
def window (c : Nat → Nat) (span index : Nat) : Nat :=
    c (index + 1) - c ((index + 1) - span)

theorem window_double {c : Nat → Nat}
    (hz : c 0 = 0) (hm : ∀ i j, i ≤ j → c i ≤ c j) (span index : Nat) :
    window c (2 * span) index = window c span index +
      (if span ≤ index then window c span (index - span) else 0) := by
  unfold window
  by_cases h : span ≤ index
  · simp only [ite_eq_left h]
    have he : index - span + 1 = index + 1 - span := by omega
    have he' : index + 1 - span - span = index + 1 - 2 * span := by omega
    rw [he, he']
    have h1 := hm (index + 1 - 2 * span) (index + 1 - span) (by omega)
    have h2 := hm (index + 1 - span) (index + 1) (by omega)
    omega
  · have he : index + 1 - span = 0 := by omega
    have he' : index + 1 - 2 * span = 0 := by omega
    simp [h, he, he', hz]

theorem cumulative_le_index {c : Nat → Nat} (hz : c 0 = 0)
    (hs : ∀ i, c (i+1) ≤ c i + 1) : ∀ i, c i ≤ i := by
  intro i
  induction i with
  | zero => simp [hz]
  | succ i ih => have hh := hs i; omega

theorem window_lt_radix {c : Nat → Nat} {radix n span index : Nat}
    (hz : c 0 = 0) (hs : ∀ i, c (i+1) ≤ c i + 1)
    (hn : n < radix) (hi : index < n) : window c span index < radix := by
  have hc := cumulative_le_index hz hs (index + 1)
  unfold window
  omega

def windows (c : Nat → Nat) (span n : Nat) : List Nat :=
    (List.range n).map (window c span)

theorem windows_length (c : Nat → Nat) (span n : Nat) :
    (windows c span n).length = n := by simp [windows]

theorem windows_get {c : Nat → Nat} {span n index : Nat} (hi : index < n) :
    (windows c span n)[index]? = some (window c span index) := by
  simp [windows, List.getElem?_range hi]

theorem windows_bounded {c : Nat → Nat} {radix span n : Nat}
    (hz : c 0 = 0) (hs : ∀ i, c (i+1) ≤ c i + 1) (hn : n < radix) :
    Bounded radix (windows c span n) := by
  intro a ha
  simp only [windows, List.mem_map] at ha
  obtain ⟨i, hi, rfl⟩ := ha
  exact window_lt_radix hz hs hn (List.mem_range.mp hi)
theorem prefixStep_windows {c : Nat → Nat}
    (hz : c 0 = 0) (hm : ∀ i j, i ≤ j → c i ≤ c j) (span n : Nat) :
    prefixStep span (windows c span n) = windows c (2 * span) n := by
  apply List.ext_getElem?
  intro index
  unfold prefixStep
  rw [List.getElem?_zipWith]
  by_cases hi : index < n
  · rw [windows_get hi, windows_get hi]
    simp only [windows_length]
    rw [List.getElem?_take_of_lt hi]
    by_cases hs : span ≤ index
    · rw [List.getElem?_append_right (by simpa using hs)]
      simp only [List.length_replicate]
      rw [windows_get (by omega : index - span < n)]
      simp only
      rw [window_double hz hm span index]
      simp [hs]
    · have hlt : index < span := by omega
      rw [List.getElem?_append_left (by simpa using hlt)]
      rw [List.getElem?_replicate_of_lt hlt]
      simp only
      rw [window_double hz hm span index]
      simp [hs]
  · have hx : (windows c span n)[index]? = none :=
      List.getElem?_eq_none (by simpa [windows_length] using (Nat.le_of_not_gt hi))
    have hy : (windows c (2 * span) n)[index]? = none :=
      List.getElem?_eq_none (by simpa [windows_length] using (Nat.le_of_not_gt hi))
    rw [hx, hy]
/-- Actual packed prefix-count arithmetic, parameterized by lane width and size. -/
def prefixCounts (width : Nat) : Nat → Nat → Nat → Nat → Nat
 | 0, _, _, value => value
 | fuel+1, step, n, value =>
   prefixCounts width fuel (step * 2) n
     (value + ((value <<< (width * step)) &&& ((1 <<< (width * n)) - 1)))

/-- Every doubling stage has the intended cumulative-window semantics. The only
size assumption is that total lane count fits in one radix digit. -/
theorem prefixCounts_windows {c : Nat → Nat} {width n : Nat}
    (hz : c 0 = 0) (hm : ∀ i j, i ≤ j → c i ≤ c j)
    (hs : ∀ i, c (i+1) ≤ c i + 1) (hn : n < 2^width) (fuel span : Nat) :
    prefixCounts width fuel span n (pack (2^width) (windows c span n)) =
      pack (2^width) (windows c (2^fuel * span) n) := by
  induction fuel generalizing span with
  | zero => simp [prefixCounts]
  | succ fuel ih =>
    have hp := prefixStep_packed (windows_bounded hz hs hn (span := span)) span
    rw [prefixStep_windows hz hm] at hp
    simp only [windows_length] at hp
    have hp' : pack (2^width) (windows c (span * 2) n) =
        pack (2^width) (windows c span n) +
          ((pack (2^width) (windows c span n) <<< (width * span)) &&&
            ((1 <<< (width * n)) - 1)) := by
      simpa [Nat.mul_comm] using hp
    rw [prefixCounts, ← hp', ih]
    simp [Nat.pow_succ, Nat.mul_assoc, Nat.mul_comm]

theorem windows_full {c : Nat → Nat} {span n : Nat}
    (hz : c 0 = 0) (hspan : n ≤ span) :
    windows c span n = (List.range n).map (fun i => c (i+1)) := by
  unfold windows
  apply List.map_congr_left
  intro i hi
  have hh : i + 1 ≤ span := by have h := List.mem_range.mp hi; omega
  simp [window, Nat.sub_eq_zero_of_le hh, hz]

/-- Exact prefix-count soundness for zero/one deletion increments. No kernel
iteration is evaluated in this proof: it holds for all fuel, lane counts and widths. -/
theorem prefixCounts_correct {c : Nat → Nat} {width n fuel : Nat}
    (hz : c 0 = 0) (hm : ∀ i j, i ≤ j → c i ≤ c j)
    (hs : ∀ i, c (i+1) ≤ c i + 1) (hn : n < 2^width) (hf : n ≤ 2^fuel) :
    prefixCounts width fuel 1 n (pack (2^width) (windows c 1 n)) =
      pack (2^width) ((List.range n).map (fun i => c (i+1))) := by
  rw [prefixCounts_windows hz hm hs hn]
  simp only [Nat.mul_one]
  rw [windows_full hz hf]
/-- A physical bit of a packed integer is exactly the corresponding payload bit. -/
theorem pack_bit {width : Nat} {xs : List Nat}
    (h : Bounded (2^width) xs) (lane bit : Nat) (hb : bit < width) :
    (pack (2^width) xs).testBit (width * lane + bit) =
      ((xs[lane]?).getD 0).testBit bit := by
  rw [← pack_digit h lane]
  simp only [digit, ← Nat.pow_mul, Nat.testBit_mod_two_pow]
  simp [hb, Nat.testBit_div_two_pow, Nat.add_comm]

theorem zipWith_getD_zero (f : Nat → Nat → Nat) (hzero : f 0 0 = 0)
    {xs ys : List Nat} (hlen : xs.length = ys.length) (index : Nat) :
    ((List.zipWith f xs ys)[index]?).getD 0 =
      f ((xs[index]?).getD 0) ((ys[index]?).getD 0) := by
  induction xs generalizing ys index with
  | nil => cases ys <;> simp_all
  | cons a xs ih =>
    cases ys with
    | nil => simp at hlen
    | cons b ys =>
      have hh : xs.length = ys.length := by simpa using hlen
      cases index with
      | zero => simp
      | succ index => simpa using ih hh index

theorem zipWith_bounded (f : Nat → Nat → Nat) {radix : Nat}
    (hf : ∀ a b, a < radix → b < radix → f a b < radix)
    {xs ys : List Nat} (hx : Bounded radix xs) (hy : Bounded radix ys) :
    Bounded radix (List.zipWith f xs ys) := by
  induction xs generalizing ys with
  | nil => simp [Bounded]
  | cons a xs ih =>
    cases ys with
    | nil => simp [Bounded]
    | cons b ys =>
      have ha : a < radix := hx a (by simp)
      have hb : b < radix := hy b (by simp)
      have hxt : Bounded radix xs := by intro z hz; exact hx z (by simp [hz])
      have hyt : Bounded radix ys := by intro z hz; exact hy z (by simp [hz])
      intro z hz
      simp only [List.zipWith, List.mem_cons] at hz
      rcases hz with rfl | hz
      · exact hf a b ha hb
      · exact ih hxt hyt z hz

/-- Any bitwise operation preserving digit bounds commutes with packing. -/
theorem pack_zip_bitwise (f : Nat → Nat → Nat) (g : Bool → Bool → Bool)
    (hzero : f 0 0 = 0)
    (hbit : ∀ a b i, (f a b).testBit i = g (a.testBit i) (b.testBit i))
    {width : Nat} (hw : 0 < width)
    (hf : ∀ a b, a < 2^width → b < 2^width → f a b < 2^width)
    {xs ys : List Nat} (hlen : xs.length = ys.length)
    (hx : Bounded (2^width) xs) (hy : Bounded (2^width) ys) :
    pack (2^width) (List.zipWith f xs ys) = f (pack (2^width) xs) (pack (2^width) ys) := by
  apply Nat.eq_of_testBit_eq
  intro bit
  have hmod : bit % width < width := Nat.mod_lt _ hw
  have he : bit = width * (bit / width) + bit % width := by
    have hh := Nat.div_add_mod bit width
    omega
  rw [he, pack_bit (zipWith_bounded f hf hx hy) _ _ hmod]
  rw [zipWith_getD_zero f hzero hlen, hbit, hbit]
  rw [pack_bit hx _ _ hmod, pack_bit hy _ _ hmod]
theorem pack_zip_and {width : Nat} (hw : 0 < width) {xs ys : List Nat}
    (hlen : xs.length = ys.length)
    (hx : Bounded (2^width) xs) (hy : Bounded (2^width) ys) :
    pack (2^width) (List.zipWith (· &&& ·) xs ys) =
      pack (2^width) xs &&& pack (2^width) ys := by
  exact pack_zip_bitwise (· &&& ·) (· && ·) (by decide) Nat.testBit_and hw
    (fun a b _ hb => Nat.and_lt_two_pow a hb) hlen hx hy

theorem pack_zip_or {width : Nat} (hw : 0 < width) {xs ys : List Nat}
    (hlen : xs.length = ys.length)
    (hx : Bounded (2^width) xs) (hy : Bounded (2^width) ys) :
    pack (2^width) (List.zipWith (· ||| ·) xs ys) =
      pack (2^width) xs ||| pack (2^width) ys := by
  exact pack_zip_bitwise (· ||| ·) (· || ·) (by decide) Nat.testBit_or hw
    (fun _ _ ha hb => Nat.or_lt_two_pow ha hb) hlen hx hy

theorem pack_zip_xor {width : Nat} (hw : 0 < width) {xs ys : List Nat}
    (hlen : xs.length = ys.length)
    (hx : Bounded (2^width) xs) (hy : Bounded (2^width) ys) :
    pack (2^width) (List.zipWith (· ^^^ ·) xs ys) =
      pack (2^width) xs ^^^ pack (2^width) ys := by
  exact pack_zip_bitwise (· ^^^ ·) (fun a b => a != b) (by decide) Nat.testBit_xor hw
    (fun _ _ ha hb => Nat.xor_lt_two_pow ha hb) hlen hx hy

theorem pack_map_mul (radix multiplier : Nat) (xs : List Nat) :
    pack radix (xs.map (fun a => a * multiplier)) = pack radix xs * multiplier := by
  induction xs with
  | nil => simp [pack]
  | cons a xs ih => simp [pack, ih, Nat.add_mul, Nat.mul_assoc]

theorem pack_ones_mul {radix : Nat} (hr : 0 < radix) (count : Nat) :
    (radix - 1) * pack radix (List.replicate count 1) + 1 = radix ^ count := by
  induction count with
  | zero => simp [pack]
  | succ count ih =>
    simp only [List.replicate_succ, pack]
    have he : radix - 1 + 1 = radix := by omega
    calc
      (radix - 1) * (1 + radix * pack radix (List.replicate count 1)) + 1 =
          (radix - 1 + 1) + radix * ((radix - 1) * pack radix (List.replicate count 1)) := by
            simp [Nat.mul_add, Nat.mul_comm, Nat.mul_left_comm]
            omega
      _ = radix * ((radix - 1) * pack radix (List.replicate count 1) + 1) := by
            rw [he, Nat.mul_add, Nat.mul_one]
            omega
      _ = radix * radix ^ count := by rw [ih]
      _ = radix ^ (count + 1) := by rw [Nat.pow_succ, Nat.mul_comm]

/-- The geometric quotient used by the executable `rep` is the packed one mask. -/
theorem pack_ones_quotient {radix : Nat} (hr : 1 < radix) (count : Nat) :
    (radix ^ count - 1) / (radix - 1) = pack radix (List.replicate count 1) := by
  have hh := pack_ones_mul (Nat.lt_trans (by decide) hr) count
  have he : radix ^ count - 1 = (radix - 1) * pack radix (List.replicate count 1) := by omega
  rw [he, Nat.mul_div_cancel_left _ (by omega)]
/-- Selecting one bit at the same offset in every lane has pointwise semantics,
even though the raw right shift itself may cross lane boundaries. -/
theorem pack_pick_bit {width : Nat} (hw : 0 < width) {xs : List Nat}
    (hx : Bounded (2^width) xs) (offset : Nat) (hoff : offset < width) :
    ((pack (2^width) xs >>> offset) &&&
       pack (2^width) (List.replicate xs.length 1)) =
      pack (2^width) (xs.map (fun a => (a >>> offset) &&& 1)) := by
  have hone : 1 < 2^width := Nat.one_lt_two_pow (by omega)
  have ho : Bounded (2^width) (List.replicate xs.length 1) := by
    intro a ha
    have he : a = 1 := (List.mem_replicate.mp ha).2
    simpa [he] using hone
  have hm : Bounded (2^width) (xs.map (fun a => (a >>> offset) &&& 1)) := by
    intro a ha
    obtain ⟨b, _, rfl⟩ := List.mem_map.mp ha
    exact Nat.lt_of_le_of_lt Nat.and_le_right hone
  apply Nat.eq_of_testBit_eq
  intro bit
  have hr : bit % width < width := Nat.mod_lt _ hw
  have he : bit = width * (bit / width) + bit % width := by
    have hh := Nat.div_add_mod bit width
    omega
  rw [he, Nat.testBit_and, pack_bit ho _ _ hr, pack_bit hm _ _ hr]
  have honebit : (1 : Nat).testBit (bit % width) = decide (bit % width = 0) := by
    simpa using Nat.testBit_bool_toNat true (bit % width)
  by_cases hi : bit / width < xs.length
  · simp only [List.getElem?_replicate_of_lt hi, Option.getD_some]
    rw [honebit]
    have hmap : ((xs.map (fun a => (a >>> offset) &&& 1))[bit / width]?).getD 0 =
        (((xs[bit / width]?).getD 0) >>> offset) &&& 1 := by
      rw [List.getElem?_map]
      cases hh : xs[bit / width]? <;> simp
    rw [hmap, Nat.testBit_and, honebit]
    by_cases hz : bit % width = 0
    · simp only [hz, decide_true, Bool.and_true, Nat.add_zero]
      rw [Nat.testBit_shiftRight, Nat.testBit_shiftRight]
      have hadd : offset + width * (bit / width) = width * (bit / width) + offset := by omega
      rw [hadd, pack_bit hx _ _ hoff]
      simp
    · simp [hz]
  · simp [hi]
/-- Replicate the chosen bit into every bit of its lane, exactly as move masks do. -/
theorem pack_pick_mask {width : Nat} (hw : 0 < width) {xs : List Nat}
    (hx : Bounded (2^width) xs) (offset : Nat) (hoff : offset < width) :
    (((pack (2^width) xs >>> offset) &&&
       pack (2^width) (List.replicate xs.length 1)) * (2^width - 1)) =
      pack (2^width) (xs.map (fun a => ((a >>> offset) &&& 1) * (2^width - 1))) := by
  rw [pack_pick_bit hw hx offset hoff, ← pack_map_mul]
  simp only [List.map_map]
  rfl

theorem pick_mask_bounded {width : Nat} (xs : List Nat) (offset : Nat) :
    Bounded (2^width) (xs.map (fun a => ((a >>> offset) &&& 1) * (2^width - 1))) := by
  intro z hz
  obtain ⟨a, _, rfl⟩ := List.mem_map.mp hz
  have hh := Nat.mul_le_mul_right (2^width - 1) (Nat.and_le_right (n := a >>> offset) (m := 1))
  simp only [Nat.one_mul] at hh
  exact Nat.lt_of_le_of_lt hh (Nat.sub_lt (Nat.two_pow_pos width) (by decide))

/-- The all-field mask is exactly a list of maximal radix digits. -/
theorem pack_full_mask {radix : Nat} (hr : 0 < radix) (count : Nat) :
    pack radix (List.replicate count (radix - 1)) = radix ^ count - 1 := by
  have hh := pack_map_mul radix (radix - 1) (List.replicate count 1)
  simp only [List.map_replicate, Nat.one_mul] at hh
  rw [hh, Nat.mul_comm]
  have he := pack_ones_mul hr count
  omega
/-- Cumulative sum of a finite list, extended by zero increments past its end. -/
def cumulative (xs : List Nat) : Nat → Nat
 | 0 => 0
 | i+1 => cumulative xs i + (xs[i]?).getD 0

theorem cumulative_mono (xs : List Nat) :
    ∀ i j, i ≤ j → cumulative xs i ≤ cumulative xs j := by
  intro i j
  induction j generalizing i with
  | zero =>
    intro h
    have he : i = 0 := by omega
    simp [he]
  | succ j ih =>
    intro h
    by_cases hij : i ≤ j
    · have hh := ih i hij
      simp only [cumulative]
      omega
    · have he : i = j + 1 := by omega
      simp [he]

theorem getD_le_one {xs : List Nat} (h : ∀ a ∈ xs, a ≤ 1) (i : Nat) :
    (xs[i]?).getD 0 ≤ 1 := by
  by_cases hi : i < xs.length
  · rw [List.getElem?_eq_getElem hi]
    exact h _ (List.getElem_mem hi)
  · rw [List.getElem?_eq_none (by omega)]
    decide

theorem cumulative_step_le {xs : List Nat} (h : ∀ a ∈ xs, a ≤ 1) (i : Nat) :
    cumulative xs (i+1) ≤ cumulative xs i + 1 := by
  have hh := getD_le_one h i
  simp only [cumulative]
  omega

theorem windows_initial (xs : List Nat) :
    windows (cumulative xs) 1 xs.length = xs := by
  apply List.ext_getElem?
  intro i
  by_cases hi : i < xs.length
  · rw [windows_get hi, List.getElem?_eq_getElem hi]
    simp [window, cumulative, List.getElem?_eq_getElem hi]
  · rw [List.getElem?_eq_none (by simpa [windows_length] using Nat.le_of_not_gt hi),
        List.getElem?_eq_none (Nat.le_of_not_gt hi)]

/-- Unconditional instantiation for an arbitrary finite zero/one digit list. -/
theorem prefixCounts_zero_one {width fuel : Nat} {xs : List Nat}
    (hflags : ∀ a ∈ xs, a ≤ 1) (hn : xs.length < 2^width) (hf : xs.length ≤ 2^fuel) :
    prefixCounts width fuel 1 xs.length (pack (2^width) xs) =
      pack (2^width) ((List.range xs.length).map (fun i => cumulative xs (i+1))) := by
  have hh := prefixCounts_correct (c := cumulative xs) rfl (cumulative_mono xs)
    (cumulative_step_le hflags) hn hf
  rw [windows_initial] at hh
  exact hh
theorem prefixCounts_digit {width fuel : Nat} {xs : List Nat}
    (hflags : ∀ a ∈ xs, a ≤ 1) (hn : xs.length < 2^width) (hf : xs.length ≤ 2^fuel)
    (i : Nat) (hi : i < xs.length) :
    digit (2^width) (prefixCounts width fuel 1 xs.length (pack (2^width) xs)) i =
      cumulative xs (i+1) := by
  rw [prefixCounts_zero_one hflags hn hf]
  have hb : Bounded (2^width) ((List.range xs.length).map (fun j => cumulative xs (j+1))) := by
    intro a ha
    obtain ⟨j, hj, rfl⟩ := List.mem_map.mp ha
    have hc := cumulative_le_index (c := cumulative xs) rfl (cumulative_step_le hflags) (j+1)
    have hj' := List.mem_range.mp hj
    omega
  rw [pack_digit hb i]
  simp [List.getElem?_map, List.getElem?_range hi]

/-- The executable's shift/field-mask reads the proved cumulative count. -/
theorem prefixCounts_lane {width fuel : Nat} {xs : List Nat}
    (hflags : ∀ a ∈ xs, a ≤ 1) (hn : xs.length < 2^width) (hf : xs.length ≤ 2^fuel)
    (i : Nat) (hi : i < xs.length) :
    ((prefixCounts width fuel 1 xs.length (pack (2^width) xs) >>> (width * i)) &&&
       ((1 <<< width) - 1)) = cumulative xs (i+1) := by
  rw [Nat.one_shiftLeft, Nat.and_two_pow_sub_one_eq_mod, Nat.shiftRight_eq_div_pow]
  simpa [digit, Nat.pow_mul] using prefixCounts_digit hflags hn hf i hi

theorem cumulative_cons (a : Nat) (xs : List Nat) (i : Nat) :
    cumulative (a :: xs) (i+1) = a + cumulative xs i := by
  induction i with
  | zero => simp [cumulative]
  | succ i ih =>
    simp only [cumulative, List.getElem?_cons_succ] at *
    omega

theorem cumulative_length (xs : List Nat) : cumulative xs xs.length = xs.sum := by
  induction xs with
  | nil => simp [cumulative]
  | cons a xs ih => simpa [cumulative_cons] using congrArg (a + ·) ih

/-- The packed survivor-count formula equals length minus the number of deleted
zero/one flags. The nonempty hypothesis matches the executable's guarded branch. -/
theorem prefixCounts_survivors {width fuel : Nat} {xs : List Nat}
    (hflags : ∀ a ∈ xs, a ≤ 1) (hn : xs.length < 2^width) (hf : xs.length ≤ 2^fuel)
    (hpos : 0 < xs.length) :
    xs.length - ((prefixCounts width fuel 1 xs.length (pack (2^width) xs) >>>
       (width * (xs.length - 1))) &&& ((1 <<< width) - 1)) = xs.length - xs.sum := by
  rw [prefixCounts_lane hflags hn hf (xs.length - 1) (by omega)]
  have he : xs.length - 1 + 1 = xs.length := by omega
  rw [he, cumulative_length]
def chosenBits (width n offset value : Nat) : List Nat :=
    (List.range n).map (fun i => (value.testBit (width * i + offset)).toNat)

theorem chosenBits_bounded {width : Nat} (hw : 0 < width) (n offset value : Nat) :
    Bounded (2^width) (chosenBits width n offset value) := by
  intro a ha
  obtain ⟨i, _, rfl⟩ := List.mem_map.mp ha
  have hh : 1 < 2^width := Nat.one_lt_two_pow (by omega)
  cases h : value.testBit (width * i + offset) with
  | false => exact Nat.two_pow_pos width
  | true => exact hh

/-- Bit extraction against one-per-field masks is sound for any integer,
including sparse-scattered states with holes. -/
theorem pick_any_bits {width : Nat} (hw : 0 < width) (n offset value : Nat) :
    ((value >>> offset) &&& pack (2^width) (List.replicate n 1)) =
      pack (2^width) (chosenBits width n offset value) := by
  have hone : 1 < 2^width := Nat.one_lt_two_pow (by omega)
  have ho : Bounded (2^width) (List.replicate n 1) := by
    intro a ha
    have he : a = 1 := (List.mem_replicate.mp ha).2
    simpa [he] using hone
  apply Nat.eq_of_testBit_eq
  intro bit
  have hr : bit % width < width := Nat.mod_lt _ hw
  have he : bit = width * (bit / width) + bit % width := by
    have hh := Nat.div_add_mod bit width
    omega
  rw [he, Nat.testBit_and, pack_bit ho _ _ hr, pack_bit (chosenBits_bounded hw n offset value) _ _ hr]
  by_cases hi : bit / width < n
  · simp only [List.getElem?_replicate_of_lt hi, Option.getD_some]
    simp only [chosenBits, List.getElem?_map, List.getElem?_range hi, Option.map_some, Option.getD_some]
    rw [Nat.testBit_bool_toNat, Nat.testBit_shiftRight]
    have honebit : (1 : Nat).testBit (bit % width) = decide (bit % width = 0) := by
      simpa using Nat.testBit_bool_toNat true (bit % width)
    rw [honebit]
    by_cases hz : bit % width = 0
    · simp [hz, Nat.add_comm]
    · simp [hz]
  · simp [chosenBits, hi]
def moveMask (width n offset value : Nat) : Nat :=
    ((value >>> offset) &&& pack (2^width) (List.replicate n 1)) * (2^width - 1)

theorem moveMask_packed {width : Nat} (hw : 0 < width) (n offset value : Nat) :
    moveMask width n offset value = pack (2^width)
      ((chosenBits width n offset value).map (fun b => b * (2^width - 1))) := by
  unfold moveMask
  rw [pick_any_bits hw, ← pack_map_mul]

/-- Every bit of the broadcast move mask has its intended source-count bit. -/
theorem moveMask_field {width n address fieldBit : Nat} (hw : 0 < width)
    (ha : address < n) (hb : fieldBit < width) (offset value : Nat) :
    (moveMask width n offset value).testBit (width * address + fieldBit) =
      value.testBit (width * address + offset) := by
  rw [moveMask_packed hw]
  have hm : Bounded (2^width)
      ((chosenBits width n offset value).map (fun b => b * (2^width - 1))) := by
    intro a ha
    obtain ⟨b, hb, rfl⟩ := List.mem_map.mp ha
    obtain ⟨i, _, rfl⟩ := List.mem_map.mp hb
    cases hi : value.testBit (width * i + offset) with
    | false => simpa using Nat.two_pow_pos width
    | true =>
      simpa using (Nat.sub_lt (Nat.two_pow_pos width) (by decide : 0 < 1))
  rw [pack_bit hm _ _ hb]
  simp only [List.getElem?_map, chosenBits, List.getElem?_range ha, Option.map_some, Option.getD_some]
  cases value.testBit (width * address + offset) <;>
    simp [Nat.testBit_two_pow_sub_one, hb]
end PackedDigits

namespace RouteInvariant
/-- Intermediate destination after processing the low bits of a deletion count. -/
def position (i d radix : Nat) : Nat := i - d % radix

theorem position_decomposition {i d radix : Nat} (h : d ≤ i) :
    position i d radix = (i - d) + radix * (d / radix) := by
  unfold position
  have hd := Nat.mod_add_div d radix
  omega

/-- Strict survivor ranks and nondecreasing deletion counts ensure that every
intermediate routing stage is collision-free. This is independent of payloads. -/
theorem positions_strict {i j di dj radix : Nat}
    (hi : di ≤ i) (hj : dj ≤ j)
    (hd : di ≤ dj) (hrank : i - di < j - dj) :
    position i di radix < position j dj radix := by
  rw [position_decomposition hi, position_decomposition hj]
  have hdiv : di / radix ≤ dj / radix := Nat.div_le_div_right hd
  have hmul := Nat.mul_le_mul_left radix hdiv
  omega

theorem positions_strict_of_gap {i j di dj radix : Nat}
    (hij : i < j) (hi : di ≤ i) (hj : dj ≤ j)
    (hd : di ≤ dj) (hgap : dj - di < j - i) :
    position i di radix < position j dj radix := by
  apply positions_strict hi hj hd
  omega

/-- No intermediate position underflows or lies to the right of its source. -/
theorem position_bounds {i d radix : Nat} (h : d ≤ i) :
    i - d ≤ position i d radix ∧ position i d radix ≤ i := by
  unfold position
  have hm : d % radix ≤ d := Nat.mod_le _ _
  omega
/-- Processing the next deletion bit moves precisely its power-of-two distance. -/
theorem position_step (i d radix : Nat) :
    position i d (radix * 2) =
      position i d radix - radix * ((d / radix) % 2) := by
  unfold position
  rw [Nat.mod_mul]
  omega

/-- Pointwise semantics of low-to-high binary routing, independent of encoding. -/
def routePosition : Nat → Nat → Nat → Nat
 | 0, i, _ => i
 | b+1, i, d => routePosition b i d - 2^b * ((d / 2^b) % 2)

theorem routePosition_eq (b i d : Nat) :
    routePosition b i d = position i d (2^b) := by
  induction b with
  | zero => simp [routePosition, position, Nat.mod_one]
  | succ b ih =>
    rw [routePosition, ih, Nat.pow_succ, position_step]

theorem routePosition_finished {b i d : Nat} (h : d < 2^b) :
    routePosition b i d = i - d := by
  rw [routePosition_eq]
  simp [position, Nat.mod_eq_of_lt h]

/-- All intermediate stages preserve survivor order, hence no two moving or
stationary survivor payloads share a destination. -/
theorem routePosition_strict {b i j di dj : Nat}
    (hi : di ≤ i) (hj : dj ≤ j)
    (hd : di ≤ dj) (hrank : i - di < j - dj) :
    routePosition b i di < routePosition b j dj := by
  rw [routePosition_eq, routePosition_eq]
  exact positions_strict hi hj hd hrank
/-- A payload below 2^width has support only in its assigned lane. -/
theorem lane_bit_bounds {width pos payload bit : Nat}
    (hp : payload < 2^width)
    (hb : (payload <<< (width * pos)).testBit bit = true) :
    width * pos ≤ bit ∧ bit < width * (pos + 1) := by
  rw [Nat.testBit_shiftLeft] at hb
  have hlo : width * pos ≤ bit := by
    by_cases h : width * pos ≤ bit
    · exact h
    · simp [h] at hb
  have hbit : payload.testBit (bit - width * pos) = true := by
    simpa [hlo] using hb
  have hhi : bit - width * pos < width := by
    by_cases hw : width ≤ bit - width * pos
    · have hp' : payload < 2^(bit - width * pos) :=
        Nat.lt_of_lt_of_le hp (Nat.pow_le_pow_right (by decide) hw)
      have hf := Nat.testBit_lt_two_pow hp'
      rw [hf] at hbit
      contradiction
    · omega
  simp only [Nat.mul_add, Nat.mul_one]
  omega

/-- Distinct lane addresses have disjoint payload bits. -/
theorem lanes_disjoint {width i j a b : Nat}
    (ha : a < 2^width) (hb : b < 2^width) (hne : i ≠ j) :
    (a <<< (width * i)) &&& (b <<< (width * j)) = 0 := by
  apply Nat.eq_of_testBit_eq
  intro bit
  rw [Nat.testBit_and, Nat.zero_testBit]
  cases hx : (a <<< (width * i)).testBit bit with
  | false => simp
  | true =>
    cases hy : (b <<< (width * j)).testBit bit with
    | false => simp
    | true =>
      have hi := lane_bit_bounds ha hx
      have hj := lane_bit_bounds hb hy
      rcases Nat.lt_or_gt_of_ne hne with hij | hji
      · have hmul := Nat.mul_le_mul_left width (Nat.succ_le_of_lt hij)
        simp only [Nat.mul_succ] at hi hj hmul
        omega
      · have hmul := Nat.mul_le_mul_left width (Nat.succ_le_of_lt hji)
        simp only [Nat.mul_succ] at hi hj hmul
        omega

/-- Moving a lane left by a whole-lane displacement preserves its payload. -/
theorem lane_move_left (width pos displacement payload : Nat)
    (h : displacement ≤ pos) :
    (payload <<< (width * pos)) >>> (width * displacement) =
      payload <<< (width * (pos - displacement)) := by
  have he : width * pos = width * (pos - displacement) + width * displacement := by
    rw [← Nat.mul_add]
    congr 1
    omega
  rw [he, Nat.shiftLeft_add, Nat.shiftLeft_shiftRight]

/-- The pointwise routing invariant implies that two arbitrary payload lanes
cannot overwrite each other at any intermediate stage. -/
theorem routed_lanes_disjoint {width stage i j di dj a b : Nat}
    (ha : a < 2^width) (hb : b < 2^width)
    (hi : di ≤ i) (hj : dj ≤ j)
    (hd : di ≤ dj) (hrank : i - di < j - dj) :
    (a <<< (width * routePosition stage i di)) &&&
      (b <<< (width * routePosition stage j dj)) = 0 := by
  apply lanes_disjoint ha hb
  exact Nat.ne_of_lt (routePosition_strict hi hj hd hrank)
/-- A selected displacement bit can never move a survivor past lane zero. -/
theorem position_can_move {i d radix : Nat} (hi : d ≤ i)
    (hbit : d / radix % 2 = 1) : radix ≤ position i d radix := by
  have hm := Nat.mod_le d (radix * 2)
  rw [Nat.mod_mul, hbit, Nat.mul_one] at hm
  unfold position
  omega

theorem routePosition_can_move {stage i d : Nat} (hi : d ≤ i)
    (hbit : d / 2^stage % 2 = 1) : 2^stage ≤ routePosition stage i d := by
  rw [routePosition_eq]
  exact position_can_move hi hbit

/-- A mask constant on one payload lane either preserves or removes that lane. -/
theorem lane_and_constant {width pos payload mask : Nat} (active : Bool)
    (hp : payload < 2^width)
    (hm : ∀ bit, width * pos ≤ bit → bit < width * (pos+1) → mask.testBit bit = active) :
    (payload <<< (width * pos)) &&& mask =
      if active then payload <<< (width * pos) else 0 := by
  apply Nat.eq_of_testBit_eq
  intro bit
  rw [Nat.testBit_and]
  cases hb : (payload <<< (width * pos)).testBit bit with
  | false => cases active <;> simp [hb]
  | true =>
    have hh := lane_bit_bounds hp hb
    rw [hm bit hh.1 hh.2]
    cases active <;> simp [hb]

/-- One actual packed routing update moves precisely the selected payload lane.
The bit-constant mask hypotheses are paid separately by count/mask semantics. -/
theorem route_lane_step {width pos displacement payload full move : Nat} (active : Bool)
    (hp : payload < 2^width) (hpos : displacement ≤ pos)
    (hfull : ∀ bit, width * pos ≤ bit → bit < width * (pos+1) → full.testBit bit = true)
    (hmove : ∀ bit, width * pos ≤ bit → bit < width * (pos+1) → move.testBit bit = active) :
    (((payload <<< (width * pos)) &&& (full ^^^ move)) |||
      (((payload <<< (width * pos)) &&& move) >>> (width * displacement))) =
      if active then payload <<< (width * (pos - displacement))
      else payload <<< (width * pos) := by
  have hstay : ∀ bit, width * pos ≤ bit → bit < width * (pos+1) →
      (full ^^^ move).testBit bit = !active := by
    intro bit hlo hhi
    rw [Nat.testBit_xor, hfull bit hlo hhi, hmove bit hlo hhi]
    cases active <;> rfl
  rw [lane_and_constant (!active) hp hstay, lane_and_constant active hp hmove]
  cases active <;> simp [lane_move_left width pos displacement payload hpos]
theorem fullMask_on_lane {width n pos : Nat} (hp : pos < n) :
    ∀ bit, width * pos ≤ bit → bit < width * (pos+1) →
      ((1 <<< (width * n)) - 1).testBit bit = true := by
  intro bit _ hhi
  rw [Nat.one_shiftLeft, Nat.testBit_two_pow_sub_one]
  have hm := Nat.mul_le_mul_left width (Nat.succ_le_of_lt hp)
  simp only [Nat.mul_succ] at hm hhi
  have hbit : bit < width * n := by omega
  simp [hbit]

def routeValue (full move shift value : Nat) : Nat :=
    (value &&& (full ^^^ move)) ||| ((value &&& move) >>> shift)

theorem routeValue_or (full move shift a b : Nat) :
    routeValue full move shift (a ||| b) =
      routeValue full move shift a ||| routeValue full move shift b := by
  unfold routeValue
  rw [Nat.and_or_distrib_right, Nat.and_or_distrib_right, Nat.shiftRight_or_distrib]
  simp only [Nat.or_assoc]
  congr 1
  rw [← Nat.or_assoc, Nat.or_comm (b &&& (full ^^^ move)) ((a &&& move) >>> shift), Nat.or_assoc]

def scatter : List Nat → Nat
 | [] => 0
 | a :: xs => a ||| scatter xs

/-- Once the mask's meaning is proved per payload lane, the same update applies
to their entire OR-assembled packed representation. -/
theorem routeValue_scatter (full move shift : Nat) (xs : List Nat) :
    routeValue full move shift (scatter xs) =
      scatter (xs.map (routeValue full move shift)) := by
  induction xs with
  | nil => simp [scatter, routeValue]
  | cons a xs ih => simp [scatter, routeValue_or, ih]
/-- Reading one lane from a displaced payload sees that payload or zero. -/
theorem lane_testBit_at {width pos address payload offset : Nat}
    (hp : payload < 2^width) (ho : offset < width) :
    (payload <<< (width * pos)).testBit (width * address + offset) =
      if pos = address then payload.testBit offset else false := by
  by_cases he : pos = address
  · subst pos
    simp [Nat.testBit_shiftLeft]
  · have hf : (payload <<< (width * pos)).testBit (width * address + offset) = false := by
      cases hb : (payload <<< (width * pos)).testBit (width * address + offset) with
      | false => rfl
      | true =>
        have hh := lane_bit_bounds hp hb
        rcases Nat.lt_or_gt_of_ne he with hpa | hap
        · have hm := Nat.mul_le_mul_left width (Nat.succ_le_of_lt hpa)
          simp only [Nat.mul_succ] at hh hm
          omega
        · have hm := Nat.mul_le_mul_left width (Nat.succ_le_of_lt hap)
          simp only [Nat.mul_succ] at hh hm
          omega
    simp [he, hf]

def scatterEntries (width : Nat) : List (Nat × Nat) → Nat
 | [] => 0
 | (pos, payload) :: xs => (payload <<< (width * pos)) ||| scatterEntries width xs

theorem scatterEntries_testBit (width : Nat) (xs : List (Nat × Nat)) (bit : Nat) :
    (scatterEntries width xs).testBit bit = true ↔
      ∃ entry ∈ xs, (entry.2 <<< (width * entry.1)).testBit bit = true := by
  induction xs with
  | nil => simp [scatterEntries]
  | cons e xs ih =>
    rcases e with ⟨pos, payload⟩
    simp [scatterEntries, Nat.testBit_or, ih]

/-- Sparse OR-scattered entries have exact field reads when each occupied address
has one payload. No densely packed list or numeric evaluation is assumed. -/
theorem scatterEntries_field {width address payload : Nat} {xs : List (Nat × Nat)}
    (hb : ∀ e ∈ xs, e.2 < 2^width) (hmem : (address, payload) ∈ xs)
    (hu : ∀ e ∈ xs, e.1 = address → e.2 = payload)
    (offset : Nat) (ho : offset < width) :
    (scatterEntries width xs).testBit (width * address + offset) = payload.testBit offset := by
  have hi : (scatterEntries width xs).testBit (width * address + offset) = true ↔
      payload.testBit offset = true := by
    constructor
    · intro hh
      obtain ⟨e, he, hp⟩ := (scatterEntries_testBit width xs _).mp hh
      rw [lane_testBit_at (hb e he) ho] at hp
      have ha : e.1 = address := by
        by_cases ha : e.1 = address
        · exact ha
        · simp [ha] at hp
      simpa [ha, hu e he ha] using hp
    · intro hh
      apply (scatterEntries_testBit width xs _).mpr
      refine ⟨(address, payload), hmem, ?_⟩
      rw [lane_testBit_at (hb _ hmem) ho]
      simpa using hh
  cases h1 : (scatterEntries width xs).testBit (width * address + offset) <;>
    cases h2 : payload.testBit offset <;> simp_all
theorem route_lane_step_safe {width pos displacement payload full move : Nat} (active : Bool)
    (hp : payload < 2^width) (hsafe : active = true → displacement ≤ pos)
    (hfull : ∀ bit, width * pos ≤ bit → bit < width * (pos+1) → full.testBit bit = true)
    (hmove : ∀ bit, width * pos ≤ bit → bit < width * (pos+1) → move.testBit bit = active) :
    routeValue full move (width * displacement) (payload <<< (width * pos)) =
      if active then payload <<< (width * (pos - displacement))
      else payload <<< (width * pos) := by
  cases active with
  | true => exact route_lane_step true hp (hsafe rfl) hfull hmove
  | false =>
    have hstay : ∀ bit, width * pos ≤ bit → bit < width * (pos+1) →
        (full ^^^ move).testBit bit = true := by
      intro bit hlo hhi
      rw [Nat.testBit_xor, hfull bit hlo hhi, hmove bit hlo hhi]
      rfl
    unfold routeValue
    rw [lane_and_constant true hp hstay, lane_and_constant false hp hmove]
    simp

def routeEntry (active : Nat → Bool) (displacement : Nat) (e : Nat × Nat) : Nat × Nat :=
    (if active e.1 then e.1 - displacement else e.1, e.2)

/-- A complete mask/shift update equals simultaneous pointwise routing of every
scattered payload, once the shared mask's meaning on occupied lanes is known. -/
theorem routeValue_scatterEntries {width displacement full move : Nat}
    (active : Nat → Bool) (xs : List (Nat × Nat))
    (hb : ∀ e ∈ xs, e.2 < 2^width)
    (hsafe : ∀ e ∈ xs, active e.1 = true → displacement ≤ e.1)
    (hfull : ∀ e ∈ xs, ∀ bit, width * e.1 ≤ bit → bit < width * (e.1+1) → full.testBit bit = true)
    (hmove : ∀ e ∈ xs, ∀ bit, width * e.1 ≤ bit → bit < width * (e.1+1) → move.testBit bit = active e.1) :
    routeValue full move (width * displacement) (scatterEntries width xs) =
      scatterEntries width (xs.map (routeEntry active displacement)) := by
  induction xs with
  | nil => simp [scatterEntries, routeValue]
  | cons e xs ih =>
    rcases e with ⟨pos, payload⟩
    have hh := route_lane_step_safe (active pos) (hb (pos, payload) (by simp))
      (hsafe (pos, payload) (by simp)) (hfull (pos, payload) (by simp)) (hmove (pos, payload) (by simp))
    have ht : routeValue full move (width * displacement) (scatterEntries width xs) =
        scatterEntries width (xs.map (routeEntry active displacement)) := by
      apply ih
      · intro e he; exact hb e (by simp [he])
      · intro e he; exact hsafe e (by simp [he])
      · intro e he; exact hfull e (by simp [he])
      · intro e he; exact hmove e (by simp [he])
    simp only [scatterEntries, List.map_cons]
    rw [routeValue_or, hh, ht]
    cases ha : active pos <;> simp [routeEntry, ha]
end RouteInvariant

namespace PackedRouting

def selectBit (width stage value address : Nat) : Bool :=
    value.testBit (width * address + stage)

def fullMask (width n : Nat) : Nat := (1 <<< (width * n)) - 1

def routeOne (width n stage counts value : Nat) : Nat :=
    RouteInvariant.routeValue (fullMask width n)
      (PackedDigits.moveMask width n stage counts) (width * 2^stage) value

/-- An actual whole-frontier routing step has exact entrywise semantics; no
unproved mask-meaning assumption remains. -/
theorem routeOne_entries {width n stage counts : Nat} (hw : 0 < width)
    (xs : List (Nat × Nat))
    (hb : ∀ e ∈ xs, e.2 < 2^width) (hpos : ∀ e ∈ xs, e.1 < n)
    (hsafe : ∀ e ∈ xs, selectBit width stage counts e.1 = true → 2^stage ≤ e.1) :
    routeOne width n stage counts (RouteInvariant.scatterEntries width xs) =
      RouteInvariant.scatterEntries width
        (xs.map (RouteInvariant.routeEntry (selectBit width stage counts) (2^stage))) := by
  unfold routeOne
  apply RouteInvariant.routeValue_scatterEntries (selectBit width stage counts) xs hb hsafe
  · intro e he
    exact RouteInvariant.fullMask_on_lane (hpos e he)
  · intro e he bit hlo hhi
    have hoff : bit - width * e.1 < width := by
      simp only [Nat.mul_succ] at hhi
      omega
    have hbit : width * e.1 + (bit - width * e.1) = bit := by omega
    rw [← hbit, PackedDigits.moveMask_field hw (hpos e he) hoff]
    rfl

/-- Counts attached to arbitrary payload entries, with one count per address. -/
def countEntries (c : Nat → Nat) (xs : List (Nat × Nat)) : List (Nat × Nat) :=
    xs.map (fun e => (e.1, c e.1))

theorem select_countEntries {width stage : Nat} {c : Nat → Nat} {xs : List (Nat × Nat)}
    (hc : ∀ e ∈ xs, c e.1 < 2^width) {e : Nat × Nat} (he : e ∈ xs) (hs : stage < width) :
    selectBit width stage (RouteInvariant.scatterEntries width (countEntries c xs)) e.1 =
      (c e.1).testBit stage := by
  unfold selectBit
  apply RouteInvariant.scatterEntries_field
  · intro z hz
    obtain ⟨f, hf, rfl⟩ := List.mem_map.mp hz
    exact hc f hf
  · exact List.mem_map.mpr ⟨e, he, rfl⟩
  · intro z hz ha
    obtain ⟨f, hf, rfl⟩ := List.mem_map.mp hz
    change f.1 = e.1 at ha
    rw [ha]
  · exact hs

/-- Combining sparse-field reads with mask correctness gives count-driven
routing for arbitrary scattered payloads. -/
theorem routeOne_countEntries {width n stage : Nat} (hw : 0 < width) (hs : stage < width)
    (c : Nat → Nat) (xs : List (Nat × Nat))
    (hb : ∀ e ∈ xs, e.2 < 2^width) (hpos : ∀ e ∈ xs, e.1 < n)
    (hc : ∀ e ∈ xs, c e.1 < 2^width)
    (hsafe : ∀ e ∈ xs, (c e.1).testBit stage = true → 2^stage ≤ e.1) :
    routeOne width n stage (RouteInvariant.scatterEntries width (countEntries c xs))
      (RouteInvariant.scatterEntries width xs) =
    RouteInvariant.scatterEntries width
      (xs.map (RouteInvariant.routeEntry (fun pos => (c pos).testBit stage) (2^stage))) := by
  rw [routeOne_entries hw xs hb hpos]
  · congr 1
    apply List.map_congr_left
    intro e he
    unfold RouteInvariant.routeEntry
    rw [select_countEntries hc he hs]
  · intro e he
    rw [select_countEntries hc he hs]
    exact hsafe e he
def address (stage : Nat) (d : Nat → Nat) (i : Nat) : Nat :=
    RouteInvariant.routePosition stage i (d i)

def entries (stage : Nat) (d payload : Nat → Nat) (indices : List Nat) : List (Nat × Nat) :=
    indices.map (fun i => (address stage d i, payload i))

def encoded (width stage : Nat) (d payload : Nat → Nat) (indices : List Nat) : Nat :=
    RouteInvariant.scatterEntries width (entries stage d payload indices)

theorem address_injective {stage : Nat} {d : Nat → Nat} {indices : List Nat}
    (hd : ∀ i ∈ indices, d i ≤ i) (hm : ∀ i j, i ≤ j → d i ≤ d j)
    (hr : ∀ i ∈ indices, ∀ j ∈ indices, i < j → i - d i < j - d j)
    {i j : Nat} (hi : i ∈ indices) (hj : j ∈ indices)
    (he : address stage d i = address stage d j) : i = j := by
  by_cases hij : i < j
  · have hh := RouteInvariant.routePosition_strict (b := stage)
      (hd i hi) (hd j hj) (hm i j (by omega)) (hr i hi j hj hij)
    change address stage d i < address stage d j at hh
    omega
  · by_cases hji : j < i
    · have hh := RouteInvariant.routePosition_strict (b := stage)
        (hd j hj) (hd i hi) (hm j i (by omega)) (hr j hj i hi hji)
      change address stage d j < address stage d i at hh
      omega
    · omega

theorem select_encoded_counts {width stage : Nat} {d : Nat → Nat} {indices : List Nat}
    (hs : stage < width) (hd : ∀ i ∈ indices, d i ≤ i)
    (hm : ∀ i j, i ≤ j → d i ≤ d j)
    (hr : ∀ i ∈ indices, ∀ j ∈ indices, i < j → i - d i < j - d j)
    (hb : ∀ i ∈ indices, d i < 2^width) {i : Nat} (hi : i ∈ indices) :
    selectBit width stage (encoded width stage d d indices) (address stage d i) =
      (d i).testBit stage := by
  unfold selectBit encoded
  apply RouteInvariant.scatterEntries_field
  · intro e he
    obtain ⟨j, hj, rfl⟩ := List.mem_map.mp he
    exact hb j hj
  · exact List.mem_map.mpr ⟨i, hi, rfl⟩
  · intro e he ha
    obtain ⟨j, hj, rfl⟩ := List.mem_map.mp he
    change address stage d j = address stage d i at ha
    have hj' := address_injective hd hm hr hj hi ha
    simp [hj']
  · exact hs

theorem address_next (stage i : Nat) (d : Nat → Nat) :
    address (stage+1) d i =
      if (d i).testBit stage then address stage d i - 2^stage else address stage d i := by
  unfold address
  rw [RouteInvariant.routePosition, Nat.testBit_eq_decide_div_mod_eq]
  rcases Nat.mod_two_eq_zero_or_one (d i / 2^stage) with h | h <;> simp [h]

/-- Complete next-stage semantics with count masks generated from the routed
counts themselves. Original counts stay attached to their original indices. -/
theorem routeOne_encoded {width n stage : Nat} (hw : 0 < width) (hs : stage < width)
    (d payload : Nat → Nat) (indices : List Nat)
    (hpos : ∀ i ∈ indices, i < n)
    (hd : ∀ i ∈ indices, d i ≤ i) (hm : ∀ i j, i ≤ j → d i ≤ d j)
    (hr : ∀ i ∈ indices, ∀ j ∈ indices, i < j → i - d i < j - d j)
    (hc : ∀ i ∈ indices, d i < 2^width)
    (hp : ∀ i ∈ indices, payload i < 2^width) :
    routeOne width n stage (encoded width stage d d indices)
      (encoded width stage d payload indices) = encoded width (stage+1) d payload indices := by
  unfold encoded
  rw [routeOne_entries hw]
  · congr 1
    unfold entries
    rw [List.map_map]
    apply List.map_congr_left
    intro i hi
    change RouteInvariant.routeEntry _ _ (address stage d i, payload i) =
      (address (stage+1) d i, payload i)
    unfold RouteInvariant.routeEntry
    have hh := select_encoded_counts hs hd hm hr hc hi
    change selectBit width stage (RouteInvariant.scatterEntries width (entries stage d d indices))
        (address stage d i) = (d i).testBit stage at hh
    unfold entries at hh
    rw [hh, address_next]
  · intro e he
    obtain ⟨i, hi, rfl⟩ := List.mem_map.mp he
    exact hp i hi
  · intro e he
    obtain ⟨i, hi, rfl⟩ := List.mem_map.mp he
    have hh : address stage d i ≤ i := by
      unfold address
      rw [RouteInvariant.routePosition_eq]
      exact (RouteInvariant.position_bounds (hd i hi)).2
    exact Nat.lt_of_le_of_lt hh (hpos i hi)
  · intro e he
    obtain ⟨i, hi, rfl⟩ := List.mem_map.mp he
    have hh := select_encoded_counts hs hd hm hr hc hi
    change selectBit width stage (RouteInvariant.scatterEntries width (entries stage d d indices))
        (address stage d i) = (d i).testBit stage at hh
    rw [hh]
    intro hbit
    have hb : d i / 2^stage % 2 = 1 := by
      rw [Nat.testBit_eq_decide_div_mod_eq] at hbit
      exact of_decide_eq_true hbit
    exact RouteInvariant.routePosition_can_move (hd i hi) hb
/-- Actual count-driven routing of one payload integer alongside its count field. -/
def routeLoop (width n : Nat) : Nat → Nat → Nat → Nat → Nat × Nat
 | 0, _, counts, value => (counts, value)
 | fuel+1, stage, counts, value =>
   routeLoop width n fuel (stage+1)
     (routeOne width n stage counts counts) (routeOne width n stage counts value)

/-- Full loop semantics: every original count remains attached to its payload,
all intermediate masks are derived from those routed counts, and all stages are paid. -/
theorem routeLoop_encoded {width n fuel stage : Nat} (hw : 0 < width)
    (hs : stage + fuel ≤ width) (d payload : Nat → Nat) (indices : List Nat)
    (hpos : ∀ i ∈ indices, i < n)
    (hd : ∀ i ∈ indices, d i ≤ i) (hm : ∀ i j, i ≤ j → d i ≤ d j)
    (hr : ∀ i ∈ indices, ∀ j ∈ indices, i < j → i - d i < j - d j)
    (hc : ∀ i ∈ indices, d i < 2^width)
    (hp : ∀ i ∈ indices, payload i < 2^width) :
    routeLoop width n fuel stage (encoded width stage d d indices)
      (encoded width stage d payload indices) =
      (encoded width (stage+fuel) d d indices, encoded width (stage+fuel) d payload indices) := by
  induction fuel generalizing stage with
  | zero => simp [routeLoop]
  | succ fuel ih =>
    have hstage : stage < width := by omega
    rw [routeLoop,
      routeOne_encoded hw hstage d d indices hpos hd hm hr hc hc,
      routeOne_encoded hw hstage d payload indices hpos hd hm hr hc hp,
      ih (by omega)]
    have he : stage + 1 + fuel = stage + (fuel + 1) := by omega
    rw [he]

theorem encoded_finished {width stage : Nat} (d payload : Nat → Nat) (indices : List Nat)
    (h : ∀ i ∈ indices, d i < 2^stage) :
    encoded width stage d payload indices = RouteInvariant.scatterEntries width
      (indices.map (fun i => (i - d i, payload i))) := by
  unfold encoded entries
  congr 1
  apply List.map_congr_left
  intro i hi
  unfold address
  rw [RouteInvariant.routePosition_finished (h i hi)]

/-- After enough bits, routing implements the final stable rank addresses i-d(i). -/
theorem routeLoop_finished {width n fuel : Nat} (hw : 0 < width)
    (hs : fuel ≤ width) (hf : n ≤ 2^fuel) (d payload : Nat → Nat) (indices : List Nat)
    (hpos : ∀ i ∈ indices, i < n)
    (hd : ∀ i ∈ indices, d i ≤ i) (hm : ∀ i j, i ≤ j → d i ≤ d j)
    (hr : ∀ i ∈ indices, ∀ j ∈ indices, i < j → i - d i < j - d j)
    (hc : ∀ i ∈ indices, d i < 2^width)
    (hp : ∀ i ∈ indices, payload i < 2^width) :
    routeLoop width n fuel 0 (encoded width 0 d d indices)
      (encoded width 0 d payload indices) =
      (RouteInvariant.scatterEntries width (indices.map (fun i => (i-d i, d i))),
       RouteInvariant.scatterEntries width (indices.map (fun i => (i-d i, payload i)))) := by
  rw [routeLoop_encoded hw (by omega) d payload indices hpos hd hm hr hc hp]
  simp only [Nat.zero_add]
  have hh : ∀ i ∈ indices, d i < 2^fuel := by
    intro i hi
    have hh := hd i hi
    have hi' := hpos i hi
    omega
  rw [encoded_finished d d indices hh, encoded_finished d payload indices hh]
def liveIndices (flags : List Nat) : List Nat :=
    (List.range flags.length).filter (fun i => (flags[i]?).getD 0 == 0)

def deletions (flags : List Nat) (i : Nat) : Nat := PackedDigits.cumulative flags (i+1)

theorem mem_liveIndices {flags : List Nat} {i : Nat} :
    i ∈ liveIndices flags ↔ i < flags.length ∧ (flags[i]?).getD 0 = 0 := by
  simp [liveIndices]

theorem deletion_le_index {flags : List Nat} (hf : ∀ a ∈ flags, a ≤ 1)
    {i : Nat} (hi : i ∈ liveIndices flags) : deletions flags i ≤ i := by
  have hz := (mem_liveIndices.mp hi).2
  have hh := PackedDigits.cumulative_le_index (c := PackedDigits.cumulative flags)
    rfl (PackedDigits.cumulative_step_le hf) i
  simp only [deletions, PackedDigits.cumulative, hz, Nat.add_zero]
  exact hh

theorem deletions_mono (flags : List Nat) :
    ∀ i j, i ≤ j → deletions flags i ≤ deletions flags j := by
  intro i j hij
  exact PackedDigits.cumulative_mono flags (i+1) (j+1) (by omega)

theorem deficit_mono (c : Nat → Nat) (hs : ∀ i, c (i+1) ≤ c i + 1) :
    ∀ i j, i ≤ j → i - c i ≤ j - c j := by
  intro i j
  induction j generalizing i with
  | zero =>
    intro h
    have he : i = 0 := by omega
    simp [he]
  | succ j ih =>
    intro h
    by_cases hij : i ≤ j
    · have hh := ih i hij
      have hc := hs j
      omega
    · have he : i = j + 1 := by omega
      simp [he]

theorem live_ranks_strict {flags : List Nat} (hf : ∀ a ∈ flags, a ≤ 1)
    {i j : Nat} (hi : i ∈ liveIndices flags) (hj : j ∈ liveIndices flags) (hij : i < j) :
    i - deletions flags i < j - deletions flags j := by
  have hzi := (mem_liveIndices.mp hi).2
  have hzj := (mem_liveIndices.mp hj).2
  have hc := PackedDigits.cumulative_le_index (c := PackedDigits.cumulative flags)
    rfl (PackedDigits.cumulative_step_le hf) i
  have hh := deficit_mono (PackedDigits.cumulative flags) (PackedDigits.cumulative_step_le hf)
    (i+1) j (by omega)
  simp only [PackedDigits.cumulative, hzi, Nat.add_zero] at hh
  simp only [deletions, PackedDigits.cumulative, hzi, hzj, Nat.add_zero]
  omega

theorem live_rank_bound {flags : List Nat} (hf : ∀ a ∈ flags, a ≤ 1)
    {i : Nat} (hi : i ∈ liveIndices flags) :
    i - deletions flags i < flags.length - flags.sum := by
  have hi' := (mem_liveIndices.mp hi).1
  have hzi := (mem_liveIndices.mp hi).2
  have hc := PackedDigits.cumulative_le_index (c := PackedDigits.cumulative flags)
    rfl (PackedDigits.cumulative_step_le hf) i
  have hh := deficit_mono (PackedDigits.cumulative flags) (PackedDigits.cumulative_step_le hf)
    (i+1) flags.length (by omega)
  rw [PackedDigits.cumulative_length] at hh
  simp only [PackedDigits.cumulative, hzi, Nat.add_zero] at hh
  simp only [deletions, PackedDigits.cumulative, hzi, Nat.add_zero]
  omega

theorem liveIndices_cons (a : Nat) (flags : List Nat) :
    liveIndices (a :: flags) = if a = 0 then 0 :: (liveIndices flags).map Nat.succ
      else (liveIndices flags).map Nat.succ := by
  simp [liveIndices, List.range_succ_eq_map, List.filter_cons, List.filter_map]
  rfl

theorem deletions_cons (a : Nat) (flags : List Nat) (i : Nat) :
    deletions (a :: flags) (i+1) = a + deletions flags i := by
  exact PackedDigits.cumulative_cons a flags (i+1)
theorem routeLoop_live {width fuel : Nat} (hw : 0 < width) (hfw : fuel ≤ width)
    (flags : List Nat) (payload : Nat → Nat) (hf : ∀ a ∈ flags, a ≤ 1)
    (hn : flags.length < 2^width) (hbits : flags.length ≤ 2^fuel)
    (hp : ∀ i < flags.length, payload i < 2^width) :
    routeLoop width flags.length fuel 0
      (encoded width 0 (deletions flags) (deletions flags) (liveIndices flags))
      (encoded width 0 (deletions flags) payload (liveIndices flags)) =
      (RouteInvariant.scatterEntries width ((liveIndices flags).map
          (fun i => (i - deletions flags i, deletions flags i))),
       RouteInvariant.scatterEntries width ((liveIndices flags).map
          (fun i => (i - deletions flags i, payload i)))) := by
  apply routeLoop_finished hw hfw hbits
  · intro i hi; exact (mem_liveIndices.mp hi).1
  · intro i hi; exact deletion_le_index hf hi
  · exact deletions_mono flags
  · intro i hi j hj hij; exact live_ranks_strict hf hi hj hij
  · intro i hi
    have hd := deletion_le_index hf hi
    have hi' := (mem_liveIndices.mp hi).1
    omega
  · intro i hi; exact hp i (mem_liveIndices.mp hi).1

theorem scatterEntries_shift (width : Nat) (xs : List (Nat × Nat)) :
    RouteInvariant.scatterEntries width (xs.map (fun e => (e.1+1, e.2))) =
      RouteInvariant.scatterEntries width xs <<< width := by
  induction xs with
  | nil => simp [RouteInvariant.scatterEntries]
  | cons e xs ih =>
    rcases e with ⟨pos, payload⟩
    simp only [List.map_cons, RouteInvariant.scatterEntries, Nat.shiftLeft_or_distrib, ih,
      Nat.mul_succ, Nat.shiftLeft_add]

theorem pack_cons_or {width payload : Nat} (hp : payload < 2^width) (xs : List Nat) :
    PackedDigits.pack (2^width) (payload :: xs) =
      payload ||| (PackedDigits.pack (2^width) xs <<< width) := by
  have hh := Nat.shiftLeft_add_eq_or_of_lt hp (PackedDigits.pack (2^width) xs)
  simp only [Nat.shiftLeft_eq] at hh
  simpa [PackedDigits.pack, Nat.shiftLeft_eq, Nat.add_comm, Nat.mul_comm, Nat.or_comm] using hh

/-- The final ranked scatter is exactly the stably filtered packed payload list. -/
theorem rankedScatter_pack {width : Nat} (flags : List Nat) (payload : Nat → Nat)
    (hf : ∀ a ∈ flags, a ≤ 1) (hp : ∀ i < flags.length, payload i < 2^width) :
    RouteInvariant.scatterEntries width ((liveIndices flags).map
      (fun i => (i - deletions flags i, payload i))) =
      PackedDigits.pack (2^width) ((liveIndices flags).map payload) := by
  induction flags generalizing payload with
  | nil => simp [liveIndices, RouteInvariant.scatterEntries, PackedDigits.pack]
  | cons a flags ih =>
    have ha : a ≤ 1 := hf a (by simp)
    have ht : ∀ b ∈ flags, b ≤ 1 := by intro b hb; exact hf b (by simp [hb])
    have hp' : ∀ i < flags.length, payload (i+1) < 2^width := by
      intro i hi; exact hp (i+1) (by simpa using Nat.succ_lt_succ hi)
    have hp0 : payload 0 < 2^width := hp 0 (by simp)
    rcases (show a = 0 ∨ a = 1 by omega) with rfl | rfl
    · have he : ((liveIndices (0 :: flags)).map (fun i => (i - deletions (0 :: flags) i, payload i))) =
        (0, payload 0) :: (((liveIndices flags).map
          (fun i => (i - deletions flags i, payload (i+1)))).map (fun e => (e.1+1, e.2))) := by
        rw [liveIndices_cons]
        simp only [ite_true, List.map_cons, List.map_map]
        have hz : deletions (0 :: flags) 0 = 0 := by simp [deletions, PackedDigits.cumulative]
        rw [hz]
        simp only [Nat.zero_sub]
        congr 1
        apply List.map_congr_left
        intro i hi
        have hd := deletion_le_index ht hi
        change (i+1 - deletions (0 :: flags) (i+1), payload (i+1)) =
          (i - deletions flags i + 1, payload (i+1))
        rw [deletions_cons]
        simp only [Nat.zero_add]
        congr 1
        omega
      rw [he]
      simp only [RouteInvariant.scatterEntries, Nat.mul_zero, Nat.shiftLeft_zero]
      rw [scatterEntries_shift, ih (fun i => payload (i+1)) ht hp']
      rw [liveIndices_cons]
      simp only [ite_true, List.map_cons, List.map_map]
      rw [pack_cons_or hp0]
      rfl
    · have he : ((liveIndices (1 :: flags)).map (fun i => (i - deletions (1 :: flags) i, payload i))) =
        ((liveIndices flags).map (fun i => (i - deletions flags i, payload (i+1)))) := by
        rw [liveIndices_cons]
        simp only [Nat.one_ne_zero, ite_false, List.map_map]
        apply List.map_congr_left
        intro i hi
        change (i+1 - deletions (1 :: flags) (i+1), payload (i+1)) =
          (i - deletions flags i, payload (i+1))
        rw [deletions_cons]
        congr 1
        omega
      rw [he, ih (fun i => payload (i+1)) ht hp']
      rw [liveIndices_cons]
      simp only [Nat.one_ne_zero, ite_false, List.map_map]
      rfl
theorem routeLoop_filter {width fuel : Nat} (hw : 0 < width) (hfw : fuel ≤ width)
    (flags : List Nat) (payload : Nat → Nat) (hf : ∀ a ∈ flags, a ≤ 1)
    (hn : flags.length < 2^width) (hbits : flags.length ≤ 2^fuel)
    (hp : ∀ i < flags.length, payload i < 2^width) :
    routeLoop width flags.length fuel 0
      (encoded width 0 (deletions flags) (deletions flags) (liveIndices flags))
      (encoded width 0 (deletions flags) payload (liveIndices flags)) =
      (PackedDigits.pack (2^width) ((liveIndices flags).map (deletions flags)),
       PackedDigits.pack (2^width) ((liveIndices flags).map payload)) := by
  rw [routeLoop_live hw hfw flags payload hf hn hbits hp,
    rankedScatter_pack flags payload hf hp]
  have hd : ∀ i < flags.length, deletions flags i < 2^width := by
    intro i hi
    have hh := PackedDigits.cumulative_le_index (c := PackedDigits.cumulative flags)
      rfl (PackedDigits.cumulative_step_le hf) (i+1)
    unfold deletions
    omega
  rw [rankedScatter_pack flags (deletions flags) hf hd]

theorem map_range_getD (xs : List Nat) :
    (List.range xs.length).map (fun i => (xs[i]?).getD 0) = xs := by
  apply List.ext_getElem?
  intro i
  by_cases hi : i < xs.length
  · simp [List.getElem?_map, List.getElem?_range hi, List.getElem?_eq_getElem hi]
  · have hr : (List.range xs.length)[i]? = none := List.getElem?_eq_none (by simp; omega)
    have hx : xs[i]? = none := List.getElem?_eq_none (by omega)
    simp [List.getElem?_map, hr, hx]

theorem liveCount_filter (flags : List Nat) :
    (liveIndices flags).length = (flags.filter (fun a => a == 0)).length := by
  have he := List.filter_map (f := fun i => (flags[i]?).getD 0)
    (p := fun a => a == 0) (l := List.range flags.length)
  rw [map_range_getD flags] at he
  have hh := congrArg List.length he
  have hp : ((fun a : Nat => a == 0) ∘ (fun i => (flags[i]?).getD 0)) =
      (fun i : Nat => (flags[i]?).getD 0 == 0) := by
    funext i
    rfl
  rw [hp] at hh
  unfold liveIndices
  simpa only [List.length_map] using hh.symm

theorem zeroCount_sum {flags : List Nat} (hf : ∀ a ∈ flags, a ≤ 1) :
    (flags.filter (fun a => a == 0)).length + flags.sum = flags.length := by
  induction flags with
  | nil => simp
  | cons a flags ih =>
    have ha : a ≤ 1 := hf a (by simp)
    have ht : ∀ b ∈ flags, b ≤ 1 := by intro b hb; exact hf b (by simp [hb])
    have hh := ih ht
    rcases (show a = 0 ∨ a = 1 by omega) with rfl | rfl <;>
      simp <;> omega

theorem liveCount_exact {flags : List Nat} (hf : ∀ a ∈ flags, a ≤ 1) :
    (liveIndices flags).length = flags.length - flags.sum := by
  have hh := zeroCount_sum hf
  rw [← liveCount_filter] at hh
  omega
def clearValues (flags : List Nat) (payload : Nat → Nat) : List Nat :=
    (List.range flags.length).map (fun i => if (flags[i]?).getD 0 = 0 then payload i else 0)

theorem clearValues_cons (a : Nat) (flags : List Nat) (payload : Nat → Nat) :
    clearValues (a :: flags) payload = (if a = 0 then payload 0 else 0) ::
      clearValues flags (fun i => payload (i+1)) := by
  simp [clearValues, List.range_succ_eq_map, List.map_map]

theorem encoded_zero (width : Nat) (d payload : Nat → Nat) (indices : List Nat) :
    encoded width 0 d payload indices = RouteInvariant.scatterEntries width
      (indices.map (fun i => (i, payload i))) := by
  simp [encoded, entries, address, RouteInvariant.routePosition]

/-- Before routing, clearing rejected payloads equals scattering only live slots
at their original addresses. -/
theorem initialScatter_pack {width : Nat} (flags : List Nat) (payload : Nat → Nat)
    (hp : ∀ i < flags.length, payload i < 2^width) :
    encoded width 0 (deletions flags) payload (liveIndices flags) =
      PackedDigits.pack (2^width) (clearValues flags payload) := by
  rw [encoded_zero]
  induction flags generalizing payload with
  | nil => simp [liveIndices, clearValues, RouteInvariant.scatterEntries, PackedDigits.pack]
  | cons a flags ih =>
    have hp' : ∀ i < flags.length, payload (i+1) < 2^width := by
      intro i hi; exact hp (i+1) (by simpa using Nat.succ_lt_succ hi)
    have ht := ih (fun i => payload (i+1)) hp'
    have he : ((liveIndices flags).map (fun i => (i+1, payload (i+1)))) =
        (((liveIndices flags).map (fun i => (i, payload (i+1)))).map (fun e => (e.1+1, e.2))) := by
      rw [List.map_map]
      rfl
    rw [liveIndices_cons, clearValues_cons]
    by_cases ha : a = 0
    · simp only [ha, ite_true, List.map_cons, List.map_map,
        RouteInvariant.scatterEntries, Nat.mul_zero, Nat.shiftLeft_zero]
      change payload 0 ||| RouteInvariant.scatterEntries width
          ((liveIndices flags).map (fun i => (i+1, payload (i+1)))) = _
      rw [he, scatterEntries_shift, ht, pack_cons_or (hp 0 (by simp))]
    · simp only [ha, ite_false, List.map_map]
      change RouteInvariant.scatterEntries width
          ((liveIndices flags).map (fun i => (i+1, payload (i+1)))) = _
      rw [he, scatterEntries_shift, ht]
      simp [PackedDigits.pack, Nat.shiftLeft_eq, Nat.mul_comm]

def aliveDigits (flags : List Nat) : List Nat :=
    (List.range flags.length).map (fun i => if (flags[i]?).getD 0 = 0 then 1 else 0)

theorem clearPacked {width : Nat} (hw : 0 < width) (flags : List Nat) (payload : Nat → Nat)
    (hp : ∀ i < flags.length, payload i < 2^width) :
    (PackedDigits.pack (2^width) ((List.range flags.length).map payload)) &&&
      (PackedDigits.pack (2^width) (aliveDigits flags) * (2^width - 1)) =
      PackedDigits.pack (2^width) (clearValues flags payload) := by
  rw [← PackedDigits.pack_map_mul]
  have hx : PackedDigits.Bounded (2^width) ((List.range flags.length).map payload) := by
    intro a ha
    obtain ⟨i, hi, rfl⟩ := List.mem_map.mp ha
    exact hp i (List.mem_range.mp hi)
  have hm : PackedDigits.Bounded (2^width)
      ((aliveDigits flags).map (fun a => a * (2^width - 1))) := by
    intro a ha
    obtain ⟨b, hb, rfl⟩ := List.mem_map.mp ha
    obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hb
    by_cases hz : (flags[i]?).getD 0 = 0
    · simp only [hz, ite_true, Nat.one_mul]
      exact Nat.sub_lt (Nat.two_pow_pos width) (by decide)
    · simp only [hz, ite_false, Nat.zero_mul]
      exact Nat.two_pow_pos width
  have hlen : ((List.range flags.length).map payload).length =
      ((aliveDigits flags).map (fun a => a * (2^width - 1))).length := by
    simp [aliveDigits]
  rw [← PackedDigits.pack_zip_and hw hlen hx hm]
  congr 1
  unfold aliveDigits clearValues
  rw [List.map_map, List.zipWith_map, List.zipWith_self]
  apply List.map_congr_left
  intro i hi
  have hi' := List.mem_range.mp hi
  change payload i &&& ((if (flags[i]?).getD 0 = 0 then 1 else 0) * (2^width - 1)) =
    if (flags[i]?).getD 0 = 0 then payload i else 0
  by_cases hz : (flags[i]?).getD 0 = 0
  · simp only [hz, ite_true, Nat.one_mul]
    exact Nat.and_two_pow_sub_one_of_lt_two_pow (hp i hi')
  · simp [hz]

theorem clearPacked_encoded {width : Nat} (hw : 0 < width) (flags : List Nat) (payload : Nat → Nat)
    (hp : ∀ i < flags.length, payload i < 2^width) :
    (PackedDigits.pack (2^width) ((List.range flags.length).map payload)) &&&
      (PackedDigits.pack (2^width) (aliveDigits flags) * (2^width - 1)) =
      encoded width 0 (deletions flags) payload (liveIndices flags) := by
  rw [clearPacked hw flags payload hp, initialScatter_pack flags payload hp]
theorem aliveDigits_map (flags : List Nat) :
    aliveDigits flags = flags.map (fun a => if a = 0 then 1 else 0) := by
  calc
    aliveDigits flags = ((List.range flags.length).map (fun i => (flags[i]?).getD 0)).map
        (fun a => if a = 0 then 1 else 0) := by
      rw [List.map_map]
      rfl
    _ = flags.map (fun a => if a = 0 then 1 else 0) := by rw [map_range_getD]

theorem aliveDigits_bounded {width : Nat} (hw : 0 < width) (flags : List Nat) :
    PackedDigits.Bounded (2^width) (aliveDigits flags) := by
  intro a ha
  obtain ⟨i, _, rfl⟩ := List.mem_map.mp ha
  have hh : 1 < 2^width := Nat.one_lt_two_pow (by omega)
  by_cases hz : (flags[i]?).getD 0 = 0
  · simpa [hz] using hh
  · simpa [hz] using Nat.two_pow_pos width

theorem zipWith_repeat_left (f : Nat → Nat → Nat) (a : Nat) (xs : List Nat) :
    List.zipWith f (List.replicate xs.length a) xs = xs.map (f a) := by
  induction xs with
  | nil => simp
  | cons x xs ih => simp [List.replicate_succ, ih]

theorem packed_dead_complement {width : Nat} (hw : 0 < width) (flags : List Nat)
    (hf : ∀ a ∈ flags, a ≤ 1) :
    (PackedDigits.pack (2^width) (List.replicate flags.length 1)) ^^^
      PackedDigits.pack (2^width) (aliveDigits flags) = PackedDigits.pack (2^width) flags := by
  have ho : PackedDigits.Bounded (2^width) (List.replicate flags.length 1) := by
    intro a ha
    have he : a = 1 := (List.mem_replicate.mp ha).2
    have hh : 1 < 2^width := Nat.one_lt_two_pow (by omega)
    simpa [he] using hh
  have hl : (List.replicate flags.length 1).length = (aliveDigits flags).length := by
    simp [aliveDigits]
  rw [← PackedDigits.pack_zip_xor hw hl ho (aliveDigits_bounded hw flags)]
  rw [aliveDigits_map]
  have he : (List.replicate flags.length 1) = List.replicate
      (flags.map (fun a => if a = 0 then 1 else 0)).length 1 := by simp
  rw [he, zipWith_repeat_left, List.map_map]
  congr 1
  calc
    _ = flags.map id := by
      apply List.map_congr_left
      intro a ha
      have hh := hf a ha
      rcases (show a = 0 ∨ a = 1 by omega) with rfl | rfl <;> rfl
    _ = flags := List.map_id flags
/-- The complete non-shortcut arithmetic of compaction, on one payload field. -/
def compactCore (width fuel : Nat) (flags : List Nat) (value : Nat) : Nat × Nat :=
  let n := flags.length
  let ones := PackedDigits.pack (2^width) (List.replicate n 1)
  let alive := PackedDigits.pack (2^width) (aliveDigits flags)
  let counts := PackedDigits.prefixCounts width fuel 1 n (ones ^^^ alive)
  let count := n - ((counts >>> (width * (n-1))) &&& ((1 <<< width)-1))
  let mask := alive * (2^width - 1)
  let result := routeLoop width n fuel 0 (counts &&& mask) (value &&& mask)
  (count, result.2)

/-- Full compaction arithmetic is sound for any finite deletion flags and payloads;
its output is exactly stable filtering, including the count and empty case. -/
theorem compactCore_correct {width fuel : Nat} (hw : 0 < width) (hfw : fuel ≤ width)
    (flags : List Nat) (payload : Nat → Nat) (hf : ∀ a ∈ flags, a ≤ 1)
    (hn : flags.length < 2^width) (hbits : flags.length ≤ 2^fuel)
    (hp : ∀ i < flags.length, payload i < 2^width) :
    compactCore width fuel flags (PackedDigits.pack (2^width) ((List.range flags.length).map payload)) =
      ((liveIndices flags).length, PackedDigits.pack (2^width) ((liveIndices flags).map payload)) := by
  have hd : ∀ i < flags.length, deletions flags i < 2^width := by
    intro i hi
    have hh := PackedDigits.cumulative_le_index (c := PackedDigits.cumulative flags)
      rfl (PackedDigits.cumulative_step_le hf) (i+1)
    unfold deletions
    omega
  have hprefix : PackedDigits.prefixCounts width fuel 1 flags.length (PackedDigits.pack (2^width) flags) =
      PackedDigits.pack (2^width) ((List.range flags.length).map (deletions flags)) := by
    exact PackedDigits.prefixCounts_zero_one hf hn hbits
  have hcount : flags.length - ((PackedDigits.prefixCounts width fuel 1 flags.length
      (PackedDigits.pack (2^width) flags) >>> (width * (flags.length-1))) &&& ((1 <<< width)-1)) =
      (liveIndices flags).length := by
    by_cases hpos : 0 < flags.length
    · rw [PackedDigits.prefixCounts_survivors hf hn hbits hpos, liveCount_exact hf]
    · have he : flags = [] := List.eq_nil_of_length_eq_zero (by omega)
      simp [he, liveIndices]
  dsimp only [compactCore]
  rw [packed_dead_complement hw flags hf, hcount, hprefix,
    clearPacked_encoded hw flags (deletions flags) hd,
    clearPacked_encoded hw flags payload hp,
    routeLoop_filter hw hfw flags payload hf hn hbits hp]
end PackedRouting

/-!
Packed, fixed-prefix certificates for sparse zero-boundary Rule 30 starts.
The parity-scan telescope is proved algebraically. Its bit recurrence is linked
to the official sideways reconstruction; no optimized code is trusted.
Eight scan stages cover depths at most 256. Each finite chunk fixes initial
odd-time boundary bits; the soundness theorem proves exhaustive coverage.
-/
namespace Rule30Submission
open Ruliology.CellularAutomata.Rule30ZeroBoundary

def px (q : Nat) : Nat → Nat
  | 0 => q
  | m + 1 => let p := px q m; p ^^^ (p <<< (2 ^ m))

theorem xor_shuffle (a b c d : Nat) :
    (a ^^^ b) ^^^ (c ^^^ d) = (a ^^^ c) ^^^ (b ^^^ d) := by
  apply Nat.eq_of_testBit_eq
  intro i
  simp only [Nat.testBit_xor]
  cases a.testBit i <;> cases b.testBit i <;> cases c.testBit i <;> cases d.testBit i <;> rfl

theorem xor_cancel_mid (a b c : Nat) : (a ^^^ b) ^^^ (b ^^^ c) = a ^^^ c := by
  apply Nat.eq_of_testBit_eq
  intro i
  simp only [Nat.testBit_xor]
  cases a.testBit i <;> cases b.testBit i <;> cases c.testBit i <;> rfl

theorem px_diff (q m : Nat) : px q m ^^^ (px q m <<< 1) = q ^^^ (q <<< (2 ^ m)) := by
  induction m with
  | zero => rfl
  | succ m ih =>
    simp only [px, Nat.shiftLeft_xor_distrib]
    rw [xor_shuffle]
    have he : (px q m <<< 2 ^ m) <<< 1 = (px q m <<< 1) <<< 2 ^ m := by
      rw [← Nat.shiftLeft_add, ← Nat.shiftLeft_add, Nat.add_comm]
    rw [he, ← Nat.shiftLeft_xor_distrib, ih, Nat.shiftLeft_xor_distrib,
      ← Nat.shiftLeft_add, xor_cancel_mid]
    rw [Nat.pow_succ]
    congr 2
    omega

/-- Prefix parity satisfies a first-order recurrence at all indices below 2^m. -/
theorem px_bit (q m i : Nat) (hi : i < 2 ^ m) :
    (px q m).testBit i = xor (q.testBit i)
      (if i = 0 then false else (px q m).testBit (i - 1)) := by
  have h := congrArg (fun a : Nat => a.testBit i) (px_diff q m)
  simp only [Nat.testBit_xor, Nat.testBit_shiftLeft] at h
  have hbig : decide (i ≥ 2 ^ m) = false := by simp; omega
  rw [hbig] at h
  by_cases hz : i = 0
  · subst hz
    simpa using h
  · have hs : decide (i ≥ 1) = true := by simp; omega
    rw [hs] at h
    simp only [Bool.true_and, Bool.false_and, Bool.xor_false] at h
    rw [ite_eq_right hz]
    revert h
    cases (px q m).testBit i <;> cases (px q m).testBit (i - 1) <;> cases q.testBit i <;> simp


def nextDiag (k r rm : Nat) (b : Bool) : Nat :=
  (((px (r ||| (rm <<< 1)) 8 ^^^ (if b then 2 ^ k - 1 else 0)) &&& (2 ^ k - 1)) <<< 1) |||
    (if b then 1 else 0)

theorem next_zero (k r rm : Nat) (b : Bool) : (nextDiag k r rm b).testBit 0 = b := by
  cases b <;> simp [nextDiag]

theorem next_succ (k r rm i : Nat) (b : Bool) (hi : i < k) :
    (nextDiag k r rm b).testBit (i + 1) = xor ((px (r ||| (rm <<< 1)) 8).testBit i) b := by
  have h1 : (1 : Nat).testBit (i + 1) = false := by
    have h := Nat.testBit_one_eq_true_iff_self_eq_zero (i := i + 1)
    cases hb : (1 : Nat).testBit (i + 1) <;> simp_all
  cases b <;> simp [nextDiag, Nat.testBit_two_pow_sub_one, hi, h1]

theorem next_recurrence (k r rm i : Nat) (b : Bool) (hi : i < k) (hk : k ≤ 256) :
    (nextDiag k r rm b).testBit (i + 1) =
      xor ((nextDiag k r rm b).testBit i) ((r ||| (rm <<< 1)).testBit i) := by
  rw [next_succ k r rm i b hi, px_bit _ 8 i (by omega)]
  cases i with
  | zero =>
    rw [next_zero]
    simp only [↓reduceIte]
    cases (r ||| (rm <<< 1)).testBit 0 <;> cases b <;> rfl
  | succ i =>
    rw [next_succ k r rm i b (by omega)]
    simp only [Nat.add_eq_zero_iff, Nat.one_ne_zero, and_false, ↓reduceIte, Nat.add_sub_cancel]
    cases (r ||| (rm <<< 1)).testBit (i + 1) <;>
      cases (px (r ||| (rm <<< 1)) 8).testBit i <;> cases b <;> rfl

/-- Packed anti-diagonal, bit i = depth i+1 and time k-1-i. -/
def PAD (y : Nat → Bool) (k r : Nat) : Prop :=
  ∀ i, i < k → r.testBit i = recon y (i + 1) (k - 1 - i)

theorem packed_level (y : Nat → Bool) (k r rm : Nat) (hk : k ≤ 256)
    (hr : PAD y k r) (hm : PAD y (k - 1) rm) :
    PAD y (k + 1) (nextDiag k r rm (y k)) := by
  intro i hi
  induction i with
  | zero =>
    rw [next_zero]
    simp [recon]
  | succ i ih =>
    rw [next_recurrence k r rm i (y k) (by omega) hk, ih (by omega)]
    rw [Nat.testBit_or, hr i (by omega), Nat.testBit_shiftLeft]
    have hprev : (decide (i ≥ 1) && rm.testBit (i - 1)) = recon y i (k - 1 - i) := by
      cases i with
      | zero => simp [recon]
      | succ j =>
        simp only [show decide (j + 1 ≥ 1) = true by simp, Bool.true_and, Nat.add_sub_cancel]
        rw [hm j (by omega)]
        congr 1 <;> omega
    rw [hprev, show i + 1 + 1 = i + 2 by omega, recon_two]
    rw [show k + 1 - 1 - i = k + 1 - 1 - (i + 1) + 1 by omega,
      show k - 1 - i = k + 1 - 1 - (i + 1) by omega]



def blackWeight (L : Nat → Bool) (k : Nat) : Nat → Nat
  | 0 => 0
  | n + 1 => (if L (k + 1) then 1 else 0) + blackWeight L (k + 1) n

def pbranch (next : Nat → Nat → Nat → Nat → Bool)
    (k r rm budget : Nat) (b : Bool) : Bool :=
  let rn := nextDiag k r rm b
  if rn.testBit k then
    match budget with
    | 0 => true
    | budget + 1 => next (k + 1) rn r budget
  else next (k + 1) rn r budget

theorem pbranch_sound (y : Nat → Bool) (k fuel budget r rm : Nat)
    (next : Nat → Nat → Nat → Nat → Bool) (hk : k ≤ 256)
    (hnext : ∀ b r' rm', next (k + 1) r' rm' b = true →
      PAD y (k + 1) r' → PAD y k rm' →
      blackWeight (fun d => recon y d 0) (k + 1) fuel ≤ b → False)
    (hr : PAD y k r) (hm : PAD y (k - 1) rm)
    (hweight : blackWeight (fun d => recon y d 0) k (fuel + 1) ≤ budget)
    (hrun : pbranch next k r rm budget (y k) = true) : False := by
  have hstep := packed_level y k r rm hk hr hm
  have hbit : (nextDiag k r rm (y k)).testBit k = recon y (k + 1) 0 := by
    simpa using hstep k (by omega)
  unfold pbranch at hrun
  change (if (nextDiag k r rm (y k)).testBit k then _ else _) = true at hrun
  rw [hbit] at hrun
  simp only [blackWeight] at hweight
  cases hb : recon y (k + 1) 0 with
  | false =>
    simp only [hb, Bool.false_eq_true, ↓reduceIte, Nat.zero_add] at hrun hweight
    exact hnext budget _ _ hrun hstep hr hweight
  | true =>
    simp only [hb, ↓reduceIte] at hrun hweight
    cases budget with
    | zero => omega
    | succ b => exact hnext b _ _ hrun hstep hr (by omega)

def crun (cut code : Nat) : Nat → Nat → Nat → Nat → Nat → Bool
  | 0, _, _, _, _ => false
  | fuel + 1, k, r, rm, budget =>
    if k % 2 = 0 then pbranch (crun cut code fuel) k r rm budget true
    else if k < 2 * cut then pbranch (crun cut code fuel) k r rm budget (code.testBit (k / 2))
    else pbranch (crun cut code fuel) k r rm budget false &&
      pbranch (crun cut code fuel) k r rm budget true

theorem crun_sound (cut code : Nat) (y : Nat → Bool)
    (hcode : ∀ t, t < 2 * cut → t % 2 = 1 → code.testBit (t / 2) = y t) :
    ∀ fuel k r rm budget,
    k + fuel ≤ 256 → crun cut code fuel k r rm budget = true →
    (∀ t, k ≤ t → t < k + fuel → t % 2 = 0 → y t = true) →
    PAD y k r → PAD y (k - 1) rm →
    blackWeight (fun d => recon y d 0) k fuel ≤ budget → False := by
  intro fuel
  induction fuel with
  | zero => intro k r rm budget hk hrun; simp [crun] at hrun
  | succ fuel ih =>
    intro k r rm budget hk hrun heven hr hm hweight
    apply pbranch_sound y k fuel budget r rm (crun cut code fuel) (by omega)
      (fun b r' rm' hrun' hr' hm' hw' => ih (k + 1) r' rm' b (by omega) hrun'
        (fun t ht htf ht2 => heven t (by omega) (by omega) ht2) hr' hm' hw')
      hr hm hweight
    simp only [crun] at hrun
    by_cases hk2 : k % 2 = 0
    · rw [ite_eq_left hk2] at hrun
      rw [heven k (Nat.le_refl _) (by omega) hk2]
      exact hrun
    · rw [ite_eq_right hk2] at hrun
      by_cases hkc : k < 2 * cut
      · rw [ite_eq_left hkc, hcode k hkc (by omega)] at hrun
        exact hrun
      · rw [ite_eq_right hkc] at hrun
        have hb : pbranch (crun cut code fuel) k r rm budget false = true ∧
            pbranch (crun cut code fuel) k r rm budget true = true := by simpa using hrun
        cases hy : y k
        · exact hb.1
        · exact hb.2

theorem blackWeight_gt_of_chunks (cut depth budget : Nat) (hd : depth ≤ 256)
    (hcheck : ∀ code, code < 2 ^ cut → crun cut code depth 0 0 0 budget = true)
    (L : Nat → Bool) (heven : ∀ t, t < depth → t % 2 = 0 → zrow L t 1 = true) :
    budget < blackWeight L 0 depth := by
  apply Nat.lt_of_not_ge
  intro hw
  let y : Nat → Bool := fun t => zrow L t 1
  let f : Nat → Bool := fun s => y (2 * s + 1)
  let code := Ruliology.CellularAutomata.Rule30ZeroBoundaryLanes.pack f cut
  have hcode : ∀ t, t < 2 * cut → t % 2 = 1 → code.testBit (t / 2) = y t := by
    intro t ht hp
    rw [Ruliology.CellularAutomata.Rule30ZeroBoundaryLanes.testBit_pack]
    simp only [show decide (t / 2 < cut) = true by simp; omega, Bool.true_and]
    change y (2 * (t / 2) + 1) = y t
    congr 1
    omega
  have hag : ∀ k n, blackWeight (fun d => recon y d 0) k n = blackWeight L k n := by
    intro k n
    induction n generalizing k with
    | zero => rfl
    | succ n ih =>
      simp only [blackWeight]
      have hb : recon y (k + 1) 0 = L (k + 1) := (history_eq_recon L (k + 1) 0).symm
      simp only [hb, ih]
  apply crun_sound cut code y hcode depth 0 0 0 budget (by omega)
    (hcheck code (Ruliology.CellularAutomata.Rule30ZeroBoundaryLanes.pack_lt f cut))
    (fun t _ ht ht2 => heven t (by omega) ht2)
    (fun i hi => by omega) (fun i hi => by omega)
  rw [hag]
  exact hw

/- Adaptive prefix coverage. Leaf evaluation still uses the unchanged crun. -/
def PrefixMatches (y : Nat → Bool) (cut code : Nat) : Prop :=
  ∀ i, i < cut → code.testBit i = y (2 * i + 1)

def PrefixExcluded (depth budget cut code : Nat) : Prop :=
  ∀ L : Nat → Bool,
    (∀ t, t < depth → t % 2 = 0 → zrow L t 1 = true) →
    PrefixMatches (fun t => zrow L t 1) cut code →
    budget < blackWeight L 0 depth

theorem prefixExcluded_of_crun (depth budget cut code : Nat) (hd : depth ≤ 256)
    (hc : crun cut code depth 0 0 0 budget = true) :
    PrefixExcluded depth budget cut code := by
  intro L heven hp
  apply Nat.lt_of_not_ge
  intro hw
  let y : Nat → Bool := fun t => zrow L t 1
  have hcode : ∀ t, t < 2 * cut → t % 2 = 1 → code.testBit (t / 2) = y t := by
    intro t ht hm
    have h := hp (t / 2) (by omega)
    simpa only [show 2 * (t / 2) + 1 = t by omega] using h
  have hag : ∀ k n, blackWeight (fun d => recon y d 0) k n = blackWeight L k n := by
    intro k n
    induction n generalizing k with
    | zero => rfl
    | succ n ih =>
      simp only [blackWeight]
      have hb : recon y (k + 1) 0 = L (k + 1) := (history_eq_recon L (k + 1) 0).symm
      simp only [hb, ih]
  apply crun_sound cut code y hcode depth 0 0 0 budget (by omega) hc
    (fun t _ ht ht2 => heven t (by omega) ht2)
    (fun i hi => by omega) (fun i hi => by omega)
  rw [hag]
  exact hw

theorem prefixExcluded_split (depth budget cut code : Nat) (hc : code < 2 ^ cut)
    (hzero : PrefixExcluded depth budget (cut + 1) code)
    (hone : PrefixExcluded depth budget (cut + 1) (2 ^ cut + code)) :
    PrefixExcluded depth budget cut code := by
  intro L heven hp
  cases hy : zrow L (2 * cut + 1) 1 with
  | false =>
    apply hzero L heven
    intro i hi
    by_cases hil : i < cut
    · exact hp i hil
    · have heq : i = cut := by omega
      subst i
      simpa only [Nat.testBit_lt_two_pow hc] using hy.symm
  | true =>
    apply hone L heven
    intro i hi
    by_cases hil : i < cut
    · rw [Nat.testBit_two_pow_add_gt hil]
      exact hp i hil
    · have heq : i = cut := by omega
      subst i
      simpa only [Nat.testBit_two_pow_add_eq, Nat.testBit_lt_two_pow hc,
        Bool.not_false] using hy.symm

theorem blackWeight_gt_of_prefix_root (depth budget : Nat)
    (h : PrefixExcluded depth budget 0 0) (L : Nat → Bool)
    (heven : ∀ t, t < depth → t % 2 = 0 → zrow L t 1 = true) :
    budget < blackWeight L 0 depth :=
  h L heven (fun i hi => by omega)

end Rule30Submission

/- Kernel-performance probe only: no soundness theorem for packed frontiers yet. -/
namespace SWARProbe
set_option maxRecDepth 100000
set_option maxHeartbeats 0

def width : Nat := 128
def mask : Nat := Nat.sub (Nat.shiftLeft 1 128) 1
def rep (n : Nat) : Nat := Nat.div (Nat.sub (Nat.shiftLeft 1 (Nat.mul 128 n)) 1) mask

structure Front where
  n : Nat
  r : Nat
  m : Nat
  b : Nat
  deriving DecidableEq

def empty : Front := ⟨0,0,0,0⟩

def prefixCounts : Nat → Nat → Nat → Nat → Nat
  | 0, _, _, d => d
  | fuel+1, step, full, d =>
    prefixCounts fuel (Nat.mul step 2) full
      (Nat.add d (Nat.land (Nat.shiftLeft d (Nat.mul 128 step)) full))

def routeLanes : Nat → Nat → Nat → Nat → Nat → Front → Front
  | 0, _, _, _, _, s => s
  | fuel+1, bit, full, ones, d, s =>
    let move := Nat.mul (Nat.land (Nat.shiftRight d bit) ones) mask
    let stay := Nat.xor full move
    let shift := Nat.mul 128 (Nat.shiftLeft 1 bit)
    let r := Nat.lor (Nat.land s.r stay) (Nat.shiftRight (Nat.land s.r move) shift)
    let m := Nat.lor (Nat.land s.m stay) (Nat.shiftRight (Nat.land s.m move) shift)
    let b := Nat.lor (Nat.land s.b stay) (Nat.shiftRight (Nat.land s.b move) shift)
    let d := Nat.lor (Nat.land d stay) (Nat.shiftRight (Nat.land d move) shift)
    routeLanes fuel (Nat.add bit 1) full ones d ⟨s.n,r,m,b⟩

def compact (fuel a : Nat) (s : Front) : Front :=
  if Nat.beq a 0 then empty
  else if Nat.beq a (rep s.n) then s
  else
    let full := Nat.sub (Nat.shiftLeft 1 (Nat.mul 128 s.n)) 1
    let ones := rep s.n
    let d := prefixCounts fuel 1 full (Nat.xor ones a)
    let count := Nat.sub s.n (Nat.land (Nat.shiftRight d (Nat.mul 128 (Nat.sub s.n 1))) mask)
    let alive := Nat.mul a mask
    routeLanes fuel 0 full ones (Nat.land d alive)
      ⟨count,Nat.land s.r alive,Nat.land s.m alive,Nat.land s.b alive⟩

def scan (x ones shift : Nat) : Nat :=
  Nat.xor x (Nat.land (Nat.shiftLeft x shift)
    (Nat.mul (Nat.xor mask (Nat.sub (Nat.shiftLeft 1 shift) 1)) ones))

def next (k budget : Nat) (s : Front) : Front :=
  let ones := rep s.n
  let q := Nat.lor s.r (Nat.shiftLeft s.m 1)
  let x := scan q ones 1
  let x := scan x ones 2
  let x := scan x ones 4
  let x := scan x ones 8
  let x := scan x ones 16
  let x := scan x ones 32
  let x := scan x ones 64
  let zero := Nat.shiftLeft (Nat.land x (Nat.mul (Nat.sub (Nat.shiftLeft 1 k) 1) ones)) 1
  let one := Nat.xor zero (Nat.mul (Nat.sub (Nat.shiftLeft 1 (Nat.add k 1)) 1) ones)
  let pre : Front := if Nat.beq (Nat.mod k 2) 0 then ⟨s.n, one, s.r, s.b⟩ else
    let wide := Nat.mul 128 s.n
    ⟨Nat.mul 2 s.n, Nat.lor zero (Nat.shiftLeft one wide),
       Nat.lor s.r (Nat.shiftLeft s.r wide), Nat.lor s.b (Nat.shiftLeft s.b wide)⟩
  let ones := rep pre.n
  let bn := Nat.add pre.b (Nat.land (Nat.shiftRight pre.r k) ones)
  let dead := Nat.land (Nat.shiftRight
    (Nat.sub (Nat.lor bn (Nat.mul 128 ones)) (Nat.mul (Nat.add budget 1) ones)) 7) ones
  compact 18 (Nat.xor ones dead) ⟨pre.n,pre.r,pre.m,bn⟩

def run (budget : Nat) : Nat → Nat → Front → Front
 | 0, _, s => s
 | fuel+1, k, s => if Nat.beq s.n 0 then s else run budget fuel (Nat.add k 1) (next k budget s)


theorem run_zero (budget k : Nat) (s : Front) : run budget 0 k s = s := rfl

theorem run_empty (budget fuel k : Nat) : run budget fuel k empty = empty := by
  cases fuel <;> simp [run, empty]

end SWARProbe


/-!
The scalar/list interface for the packed Sparse16 transition.
The Rule30 recurrence is reused from the accepted SparseBase module; the new
work identifies the executable masked parallel scan with that recurrence.
-/
namespace ScalarTransition
open PackedDigits

def repeatField (width count payload : Nat) : Nat :=
  payload * ((2^(width * count) - 1) / (2^width - 1))

theorem repeatField_eq_pack {width : Nat} (hw : 0 < width) (n c : Nat) :
    repeatField width n c = pack (2^width) (List.replicate n c) := by
  unfold repeatField
  rw [Nat.pow_mul, pack_ones_quotient (Nat.one_lt_two_pow (by omega))]
  have h := pack_map_mul (2^width) c (List.replicate n 1)
  simpa [Nat.mul_comm] using h.symm

theorem repeatField_bit {width : Nat} (hw : 0 < width)
    {n c lane bit : Nat} (hc : c < 2^width) (hb : bit < width) :
    (repeatField width n c).testBit (width * lane + bit) =
      (decide (lane < n) && c.testBit bit) := by
  rw [repeatField_eq_pack hw]
  have hbound : Bounded (2^width) (List.replicate n c) := by
    intro a ha
    simpa [(List.mem_replicate.mp ha).2] using hc
  rw [pack_bit hbound lane bit hb]
  by_cases h : lane < n <;> simp [h]

theorem map_getD_zero (f : Nat → Nat) (hf : f 0 = 0) (xs : List Nat) (i : Nat) :
    ((xs.map f)[i]?).getD 0 = f ((xs[i]?).getD 0) := by
  rw [List.getElem?_map]
  cases xs[i]? <;> simp [hf]

def scan (width x ones shift : Nat) : Nat :=
  x ^^^ ((x <<< shift) &&& ((2^width - 1 ^^^ (2^shift - 1)) * ones))

def scalarScan (width shift x : Nat) : Nat := (x ^^^ (x <<< shift)) % 2^width

theorem scalarScan_bounded (width shift x : Nat) :
    scalarScan width shift x < 2^width := Nat.mod_lt _ (Nat.two_pow_pos _)

theorem scan_packed {width : Nat} (hw : 0 < width) (shift : Nat) (hs : shift ≤ width)
    (xs : List Nat) (hx : Bounded (2^width) xs) :
    scan width (pack (2^width) xs) (repeatField width xs.length 1) shift =
      pack (2^width) (xs.map (scalarScan width shift)) := by
  have hmask : (2^width - 1 ^^^ (2^shift - 1)) < 2^width := by
    apply Nat.xor_lt_two_pow
    · exact Nat.sub_lt (Nat.two_pow_pos _) (by decide)
    · exact Nat.lt_of_lt_of_le (Nat.sub_lt (Nat.two_pow_pos _) (by decide))
        (Nat.pow_le_pow_right (by decide) hs)
  have hout : Bounded (2^width) (xs.map (scalarScan width shift)) := by
    intro a ha
    obtain ⟨x, _, rfl⟩ := List.mem_map.mp ha
    exact scalarScan_bounded _ _ _
  have hrep : (2^width - 1 ^^^ (2^shift - 1)) * repeatField width xs.length 1 =
      repeatField width xs.length (2^width - 1 ^^^ (2^shift - 1)) := by
    simp [repeatField]
  apply Nat.eq_of_testBit_eq
  intro i
  have hb : i % width < width := Nat.mod_lt _ hw
  have hi : i = width * (i / width) + i % width := by
    have h := Nat.div_add_mod i width
    omega
  rw [hi]
  simp only [scan, Nat.testBit_xor, Nat.testBit_and, hrep]
  rw [pack_bit hx _ _ hb, repeatField_bit hw hmask hb, pack_bit hout _ _ hb]
  rw [map_getD_zero _ (by simp [scalarScan])]
  simp only [scalarScan, Nat.testBit_mod_two_pow, hb, decide_true, Bool.true_and,
    Nat.testBit_xor, Nat.testBit_two_pow_sub_one]
  by_cases hl : i / width < xs.length
  · simp only [hl, decide_true, Bool.true_and]
    by_cases hshift : shift ≤ i % width
    · have hge : shift ≤ width * (i / width) + i % width := by omega
      have he : width * (i / width) + i % width - shift =
          width * (i / width) + (i % width - shift) := by omega
      simp only [Nat.testBit_shiftLeft, hge, hshift, decide_true, Bool.true_and,
        show ¬i % width < shift by omega, decide_false, Bool.xor_false, Bool.and_true]
      rw [he, pack_bit hx _ _ (by omega)]
    · simp [Nat.testBit_shiftLeft, show i % width < shift by omega,
        show ¬i % width ≥ shift by omega]
  · simp [hl]

theorem scalarScan_px (width shift q m : Nat) :
    scalarScan width shift (Rule30Submission.px q m % 2^width) =
      (Rule30Submission.px q m ^^^ (Rule30Submission.px q m <<< shift)) % 2^width := by
  unfold scalarScan
  rw [Nat.xor_mod_two_pow, Nat.mod_mod, Nat.mod_two_pow_shiftLeft_mod_two_pow,
    ← Nat.xor_mod_two_pow]

def scans (width n : Nat) : Nat → Nat → Nat
  | 0, x => x
  | m+1, x => scan width (scans width n m x) (repeatField width n 1) (2^m)

theorem scans_packed {width : Nat} (hw : 0 < width) (fuel : Nat)
    (hf : ∀ m, m < fuel → 2^m ≤ width) (xs : List Nat)
    (hx : Bounded (2^width) xs) :
    scans width xs.length fuel (pack (2^width) xs) =
      pack (2^width) (xs.map (fun x => Rule30Submission.px x fuel % 2^width)) := by
  induction fuel with
  | zero =>
    simp only [scans, Rule30Submission.px]
    congr 1
    apply List.ext_getElem
    · simp
    · intro i hi hj
      simp only [List.getElem_map]
      exact (Nat.mod_eq_of_lt (hx xs[i] (List.getElem_mem hi))).symm
  | succ m ih =>
    have hbound : Bounded (2^width)
        (xs.map (fun x => Rule30Submission.px x m % 2^width)) := by
      intro a ha
      obtain ⟨a, _, rfl⟩ := List.mem_map.mp ha
      exact Nat.mod_lt _ (Nat.two_pow_pos _)
    rw [scans, ih (fun j hj => hf j (by omega))]
    have hh := scan_packed hw (2^m) (hf m (by omega)) _ hbound
    simp only [List.length_map, List.map_map] at hh
    rw [hh]
    congr 2
    funext x
    exact scalarScan_px width (2^m) x m

theorem px_truncate_stable (q m k : Nat) (hk : k ≤ 2^m) :
    Rule30Submission.px q (m+1) % 2^k = Rule30Submission.px q m % 2^k := by
  apply Nat.eq_of_testBit_eq
  intro i
  simp only [Rule30Submission.px, Nat.testBit_mod_two_pow, Nat.testBit_xor,
    Nat.testBit_shiftLeft]
  by_cases hi : i < k
  · simp [hi, show ¬ i ≥ 2^m by omega]
  · simp [hi]

theorem mod_two_pow_nested (x a b : Nat) (h : a ≤ b) :
    x % 2^b % 2^a = x % 2^a := by
  apply Nat.eq_of_testBit_eq
  intro i
  simp only [Nat.testBit_mod_two_pow]
  by_cases hi : i < a
  · simp [hi, show i < b by omega]
  · simp [hi]

def zeroRow (k q : Nat) : Nat :=
  ((Rule30Submission.px q 7 % 2^128) &&& (2^k - 1)) <<< 1

def oneRow (k q : Nat) : Nat := zeroRow k q ^^^ (2^(k+1) - 1)

theorem zeroRow_eq (k r rm : Nat) (hk : k ≤ 128) :
    zeroRow k (r ||| (rm <<< 1)) = Rule30Submission.nextDiag k r rm false := by
  simp only [zeroRow, Rule30Submission.nextDiag, Bool.false_eq_true, ↓reduceIte,
    Nat.xor_zero, Nat.or_zero, Nat.and_two_pow_sub_one_eq_mod]
  rw [mod_two_pow_nested _ k 128 hk, ← px_truncate_stable _ 7 k (by simpa using hk)]

theorem nextDiag_true_eq (k r rm : Nat) :
    Rule30Submission.nextDiag k r rm true =
      Rule30Submission.nextDiag k r rm false ^^^ (2^(k+1)-1) := by
  apply Nat.eq_of_testBit_eq
  intro i
  simp only [Rule30Submission.nextDiag, ↓reduceIte, Nat.testBit_or, Nat.testBit_xor,
    Nat.testBit_and, Nat.testBit_shiftLeft, Nat.testBit_two_pow_sub_one]
  cases i with
  | zero => simp
  | succ i =>
    have hone : (1 : Nat).testBit (i+1) = false := by
      apply Nat.testBit_lt_two_pow
      exact Nat.one_lt_two_pow (by omega)
    simp only [Nat.add_sub_cancel, show decide (i+1 ≥ 1) = true by simp,
      Bool.true_and, hone, Bool.or_false]
    by_cases hi : i < k <;>
      simp [hi]

theorem oneRow_eq (k r rm : Nat) (hk : k ≤ 128) :
    oneRow k (r ||| (rm <<< 1)) = Rule30Submission.nextDiag k r rm true := by
  rw [oneRow, zeroRow_eq k r rm hk, nextDiag_true_eq]

theorem nextDiag_bounded (k r rm : Nat) (b : Bool) :
    Rule30Submission.nextDiag k r rm b < 2^(k+1) := by
  apply Nat.lt_pow_two_of_testBit
  intro i hi
  have hn : ¬i - 1 < k := by omega
  have hone : (1 : Nat).testBit i = false := by
    apply Nat.testBit_lt_two_pow
    exact Nat.one_lt_two_pow (by omega)
  cases b <;> simp [Rule30Submission.nextDiag, Nat.testBit_shiftLeft,
    Nat.testBit_two_pow_sub_one, hn, hone]

theorem bounded_map {α : Type} {radix : Nat} {xs : List α} {f : α → Nat}
    (h : ∀ x ∈ xs, f x < radix) : Bounded radix (xs.map f) := by
  intro a ha
  obtain ⟨x, hx, rfl⟩ := List.mem_map.mp ha
  exact h x hx

theorem bounded_replicate {radix c : Nat} (hc : c < radix) (n : Nat) :
    Bounded radix (List.replicate n c) := by
  intro a ha
  simpa [(List.mem_replicate.mp ha).2] using hc

theorem pack_map_shift (width shift : Nat) (xs : List Nat) :
    pack (2^width) (xs.map (fun x => x <<< shift)) = pack (2^width) xs <<< shift := by
  simp only [Nat.shiftLeft_eq]
  exact pack_map_mul _ _ _

theorem zipWith_replicate_right {α β γ : Type} (f : α → β → γ)
    (xs : List α) (c : β) :
    List.zipWith f xs (List.replicate xs.length c) = xs.map (fun x => f x c) := by
  induction xs <;> simp_all [List.replicate_succ, List.zipWith]

theorem pack_map_and_const {width : Nat} (hw : 0 < width) (xs : List Nat)
    (hx : Bounded (2^width) xs) (c : Nat) (hc : c < 2^width) :
    pack (2^width) (xs.map (fun x => x &&& c)) =
      pack (2^width) xs &&& repeatField width xs.length c := by
  rw [repeatField_eq_pack hw]
  have hh := pack_zip_and hw (xs := xs) (ys := List.replicate xs.length c)
    (by simp) hx (bounded_replicate hc _)
  simpa only [zipWith_replicate_right] using hh

theorem pack_map_xor_const {width : Nat} (hw : 0 < width) (xs : List Nat)
    (hx : Bounded (2^width) xs) (c : Nat) (hc : c < 2^width) :
    pack (2^width) (xs.map (fun x => x ^^^ c)) =
      pack (2^width) xs ^^^ repeatField width xs.length c := by
  rw [repeatField_eq_pack hw]
  have hh := pack_zip_xor hw (xs := xs) (ys := List.replicate xs.length c)
    (by simp) hx (bounded_replicate hc _)
  simpa only [zipWith_replicate_right] using hh

theorem pack_map_or_const {width : Nat} (hw : 0 < width) (xs : List Nat)
    (hx : Bounded (2^width) xs) (c : Nat) (hc : c < 2^width) :
    pack (2^width) (xs.map (fun x => x ||| c)) =
      pack (2^width) xs ||| repeatField width xs.length c := by
  rw [repeatField_eq_pack hw]
  have hh := pack_zip_or hw (xs := xs) (ys := List.replicate xs.length c)
    (by simp) hx (bounded_replicate hc _)
  simpa only [zipWith_replicate_right] using hh

theorem pack_map_or {α : Type} {width : Nat} (hw : 0 < width)
    (xs : List α) (f g : α → Nat)
    (hf : ∀ x ∈ xs, f x < 2^width) (hg : ∀ x ∈ xs, g x < 2^width) :
    pack (2^width) (xs.map (fun x => f x ||| g x)) =
      pack (2^width) (xs.map f) ||| pack (2^width) (xs.map g) := by
  have hh := pack_zip_or hw (xs := xs.map f) (ys := xs.map g) (by simp)
    (bounded_map hf) (bounded_map hg)
  simpa only [List.zipWith_map, List.zipWith_self] using hh

abbrev State := Nat × Nat × Nat

def qrow (s : State) : Nat := s.1 ||| (s.2.1 <<< 1)

def RowBound (k : Nat) (s : State) : Prop := s.1 < 2^k ∧ s.2.1 < 2^k

theorem qrow_bounded (k : Nat) (s : State) (h : RowBound k s) :
    qrow s < 2^(k+1) := by
  apply Nat.or_lt_two_pow
  · exact Nat.lt_of_lt_of_le h.1 (Nat.pow_le_pow_right (by decide) (by omega))
  · have hh := Nat.mul_lt_mul_of_pos_right h.2 (by decide : 0 < 2)
    simpa [Nat.shiftLeft_eq, Nat.pow_succ] using hh

theorem qrows_packed (k : Nat) (hk : k < 128) (xs : List State)
    (hx : ∀ s ∈ xs, RowBound k s) :
    pack (2^128) (xs.map qrow) =
      pack (2^128) (xs.map Prod.fst) |||
      (pack (2^128) (xs.map (fun s => s.2.1)) <<< 1) := by
  have hpow : 2^(k+1) ≤ 2^128 := Nat.pow_le_pow_right (by decide) (by omega)
  have hr : ∀ s ∈ xs, s.1 < 2^128 := by
    intro s hs
    exact Nat.lt_of_lt_of_le (hx s hs).1 (Nat.pow_le_pow_right (by decide) (by omega))
  have hm : ∀ s ∈ xs, (s.2.1 <<< 1) < 2^128 := by
    intro s hs
    have hh := Nat.mul_lt_mul_of_pos_right (hx s hs).2 (by decide : 0 < 2)
    have hshift : (s.2.1 <<< 1) < 2^(k+1) := by
      simpa [Nat.shiftLeft_eq, Nat.pow_succ] using hh
    exact Nat.lt_of_lt_of_le hshift hpow
  rw [show xs.map qrow = xs.map (fun s => s.1 ||| (s.2.1 <<< 1)) from rfl,
    pack_map_or (by decide) xs _ _ hr hm]
  rw [← pack_map_shift]
  simp only [List.map_map]
  rfl

def packedZero (k n r m : Nat) : Nat :=
  (scans 128 n 7 (r ||| (m <<< 1)) &&& repeatField 128 n (2^k-1)) <<< 1

def packedOne (k n r m : Nat) : Nat :=
  packedZero k n r m ^^^ repeatField 128 n (2^(k+1)-1)

theorem packedZero_correct (k : Nat) (hk : k < 128) (xs : List State)
    (hx : ∀ s ∈ xs, RowBound k s) :
    packedZero k xs.length (pack (2^128) (xs.map Prod.fst))
      (pack (2^128) (xs.map (fun s => s.2.1))) =
      pack (2^128) (xs.map (fun s => Rule30Submission.nextDiag k s.1 s.2.1 false)) := by
  have hq : Bounded (2^128) (xs.map qrow) := bounded_map (by
    intro s hs
    exact Nat.lt_of_lt_of_le (qrow_bounded k s (hx s hs))
      (Nat.pow_le_pow_right (by decide) (by omega)))
  have hf : ∀ m, m < 7 → 2^m ≤ 128 := by
    intro m hm
    exact Nat.le_trans (Nat.pow_le_pow_right (by decide) (show m ≤ 7 by omega)) (by decide)
  have hscan := scans_packed (by decide : 0 < 128) 7 hf (xs.map qrow) hq
  simp only [List.length_map, List.map_map, Function.comp_def] at hscan
  have hmod : Bounded (2^128) (xs.map (fun s => Rule30Submission.px (qrow s) 7 % 2^128)) :=
    bounded_map (by intros; exact Nat.mod_lt _ (Nat.two_pow_pos _))
  have hmask : 2^k-1 < 2^128 := Nat.lt_of_lt_of_le
    (Nat.sub_lt (Nat.two_pow_pos _) (by decide))
    (Nat.pow_le_pow_right (by decide) (by omega))
  unfold packedZero
  rw [← qrows_packed k hk xs hx, hscan]
  rw [show xs.length = (xs.map (fun s => Rule30Submission.px (qrow s) 7 % 2^128)).length by simp,
    ← pack_map_and_const (by decide) _ hmod _ hmask, ← pack_map_shift]
  simp only [List.map_map]
  congr 1
  apply List.map_congr_left
  intro s hs
  exact zeroRow_eq k s.1 s.2.1 (by omega)

theorem packedOne_correct (k : Nat) (hk : k < 128) (xs : List State)
    (hx : ∀ s ∈ xs, RowBound k s) :
    packedOne k xs.length (pack (2^128) (xs.map Prod.fst))
      (pack (2^128) (xs.map (fun s => s.2.1))) =
      pack (2^128) (xs.map (fun s => Rule30Submission.nextDiag k s.1 s.2.1 true)) := by
  have hz : Bounded (2^128) (xs.map (fun s => Rule30Submission.nextDiag k s.1 s.2.1 false)) :=
    bounded_map (by
      intro s _
      exact Nat.lt_of_lt_of_le (nextDiag_bounded _ _ _ _)
        (Nat.pow_le_pow_right (by decide) (by omega)))
  have hmask : 2^(k+1)-1 < 2^128 := Nat.lt_of_lt_of_le
    (Nat.sub_lt (Nat.two_pow_pos _) (by decide))
    (Nat.pow_le_pow_right (by decide) (by omega))
  unfold packedOne
  rw [packedZero_correct k hk xs hx]
  rw [show xs.length = (xs.map (fun s => Rule30Submission.nextDiag k s.1 s.2.1 false)).length by simp,
    ← pack_map_xor_const (by decide) _ hz _ hmask]
  simp only [List.map_map]
  congr 1
  apply List.map_congr_left
  intro s _
  exact (nextDiag_true_eq k s.1 s.2.1).symm

theorem pack_map_add {α : Type} (radix : Nat) (xs : List α) (f g : α → Nat) :
    pack radix (xs.map (fun x => f x + g x)) =
      pack radix (xs.map f) + pack radix (xs.map g) := by
  have h := pack_zip_add (radix := radix) (xs := xs.map f) (ys := xs.map g) (by simp)
  simpa only [List.zipWith_map, List.zipWith_self] using h

theorem pack_map_sub {α : Type} (radix : Nat) (xs : List α) (f g : α → Nat)
    (h : ∀ x ∈ xs, g x ≤ f x) :
    pack radix (xs.map (fun x => f x - g x)) =
      pack radix (xs.map f) - pack radix (xs.map g) := by
  have he : xs.map (fun x => (f x - g x) + g x) = xs.map f := by
    apply List.map_congr_left
    intro x hx
    exact Nat.sub_add_cancel (h x hx)
  have hh := pack_map_add radix xs (fun x => f x - g x) g
  rw [he] at hh
  omega

def costBit (k row : Nat) : Nat := (row >>> k) &&& 1

theorem costBit_le_one (k row : Nat) : costBit k row ≤ 1 := Nat.and_le_right

theorem costBit_eq (k row : Nat) :
    costBit k row = if row.testBit k then 1 else 0 := by
  simp only [costBit, Nat.and_one_is_mod, Nat.shiftRight_eq_div_pow]
  have hh := Nat.testBit_eq_decide_div_mod_eq (x := row) (i := k)
  rw [hh]
  by_cases h : row / 2^k % 2 = 1 <;> simp [h]
  omega

theorem packedCost_correct (k : Nat) (hk : k < 128) (xs : List State)
    (hr : ∀ s ∈ xs, s.1 < 2^128) :
    pack (2^128) (xs.map (fun s => s.2.2)) +
      ((pack (2^128) (xs.map Prod.fst) >>> k) &&& repeatField 128 xs.length 1) =
    pack (2^128) (xs.map (fun s => s.2.2 + costBit k s.1)) := by
  rw [repeatField_eq_pack (by decide)]
  have hp := pack_pick_bit (by decide : 0 < 128) (bounded_map hr) k hk
  simp only [List.length_map, List.map_map] at hp
  rw [hp]
  exact (pack_map_add _ xs _ _).symm

theorem marker_eq (b : Nat) (hb : b < 128) : b ||| 128 = 128 + b := by
  have hh := Nat.two_pow_add_eq_or_of_lt (i := 7) (b := b) (by simpa using hb) 1
  simpa [Nat.or_comm] using hh.symm

theorem deadBit_eq (budget b : Nat) (hbudget : budget < 128) (hb : b < 128) :
    (((b ||| 128) - (budget+1)) >>> 7) &&& 1 = if budget < b then 1 else 0 := by
  rw [marker_eq b hb]
  simp only [Nat.and_one_is_mod, Nat.shiftRight_eq_div_pow]
  change (128+b-(budget+1)) / 128 % 2 = _
  by_cases h : budget < b
  · rw [ite_eq_left h]
    omega
  · rw [ite_eq_right h]
    omega

def packedDead (budget n weights : Nat) : Nat :=
  (((weights ||| repeatField 128 n 128) - repeatField 128 n (budget+1)) >>> 7) &&&
    repeatField 128 n 1

theorem packedDead_correct (budget : Nat) (hbudget : budget < 128)
    (xs : List Nat) (hx : ∀ b ∈ xs, b < 128) :
    packedDead budget xs.length (pack (2^128) xs) =
      pack (2^128) (xs.map (fun b => if budget < b then 1 else 0)) := by
  have hbound : Bounded (2^128) xs := by
    intro b hb
    exact Nat.lt_trans (hx b hb) (by decide)
  have hm : Bounded (2^128) (xs.map (fun b => (b ||| 128) - (budget+1))) :=
    bounded_map (by
      intro b hb
      rw [marker_eq b (hx b hb)]
      have hh := hx b hb
      omega)
  have hs := pack_map_sub (2^128) xs (fun b => b ||| 128) (fun _ => budget+1) (by
    intro b hb
    rw [marker_eq b (hx b hb)]
    omega)
  simp only [List.map_const'] at hs
  unfold packedDead
  rw [← pack_map_or_const (by decide) xs hbound 128 (by decide),
    repeatField_eq_pack (by decide) xs.length (budget+1), ← hs,
    repeatField_eq_pack (by decide) xs.length 1]
  have hp := pack_pick_bit (by decide : 0 < 128) hm 7 (by decide)
  simp only [List.length_map, List.map_map] at hp
  rw [hp]
  congr 1
  apply List.map_congr_left
  intro b hb
  exact deadBit_eq budget b hbudget (hx b hb)

theorem packedAlive_correct (budget : Nat) (hbudget : budget < 128)
    (xs : List Nat) (hx : ∀ b ∈ xs, b < 128) :
    repeatField 128 xs.length 1 ^^^ packedDead budget xs.length (pack (2^128) xs) =
      pack (2^128) (xs.map (fun b => if b ≤ budget then 1 else 0)) := by
  rw [packedDead_correct budget hbudget xs hx, Nat.xor_comm]
  have hd : Bounded (2^128) (xs.map (fun b => if budget < b then 1 else 0)) :=
    bounded_map (by intro b _; split <;> decide)
  have hp := pack_map_xor_const (by decide : 0 < 128) _ hd 1 (by decide)
  simp only [List.length_map, List.map_map] at hp
  rw [← hp]
  congr 1
  apply List.map_congr_left
  intro b _
  by_cases hb : b ≤ budget
  · simp [hb, show ¬ budget < b by omega]
  · simp [hb, show budget < b by omega]

def rowStep (k : Nat) (b : Bool) (s : State) : State :=
  (Rule30Submission.nextDiag k s.1 s.2.1 b, s.1, s.2.2)

def addCost (k : Nat) (s : State) : State :=
  (s.1, s.2.1, s.2.2 + costBit k s.1)

def successor (k : Nat) (b : Bool) (s : State) : State := addCost k (rowStep k b s)

theorem successor_PAD (y : Nat → Bool) (k : Nat) (hk : k ≤ 128) (s : State)
    (hr : Rule30Submission.PAD y k s.1) (hm : Rule30Submission.PAD y (k-1) s.2.1) :
    Rule30Submission.PAD y (k+1) (successor k (y k) s).1 ∧
    Rule30Submission.PAD y k (successor k (y k) s).2.1 := by
  exact ⟨Rule30Submission.packed_level y k s.1 s.2.1 (by omega) hr hm, hr⟩

theorem successor_cost (y : Nat → Bool) (k : Nat) (hk : k ≤ 128) (s : State)
    (hr : Rule30Submission.PAD y k s.1) (hm : Rule30Submission.PAD y (k-1) s.2.1) :
    (successor k (y k) s).2.2 = s.2.2 +
      (if Ruliology.CellularAutomata.Rule30ZeroBoundary.recon y (k+1) 0 then 1 else 0) := by
  have hh := Rule30Submission.packed_level y k s.1 s.2.1 (by omega) hr hm k (by omega)
  change s.2.2 + costBit k (Rule30Submission.nextDiag k s.1 s.2.1 (y k)) = _
  rw [costBit_eq]
  simpa using congrArg (fun b => s.2.2 + if b then 1 else 0) hh

theorem pack_append_or {width : Nat} (xs ys : List Nat) (hx : Bounded (2^width) xs) :
    pack (2^width) (xs ++ ys) =
      pack (2^width) xs ||| (pack (2^width) ys <<< (width * xs.length)) := by
  rw [pack_append, Nat.shiftLeft_eq, ← Nat.pow_mul]
  have hh := Nat.two_pow_add_eq_or_of_lt
    (i := width * xs.length) (b := pack (2^width) xs)
    (by simpa [Nat.pow_mul] using pack_lt hx) (pack (2^width) ys)
  simpa [Nat.add_comm, Nat.mul_comm, Nat.or_comm] using hh

def preStates (k : Nat) (xs : List State) : List State :=
  if k % 2 = 0 then xs.map (rowStep k true)
  else xs.map (rowStep k false) ++ xs.map (rowStep k true)

def preN (k n : Nat) : Nat := if k % 2 = 0 then n else 2*n

def preR (k n r m : Nat) : Nat :=
  if k % 2 = 0 then packedOne k n r m
  else packedZero k n r m ||| (packedOne k n r m <<< (128*n))

def preCopy (k n v : Nat) : Nat := if k % 2 = 0 then v else v ||| (v <<< (128*n))

theorem preStates_length (k : Nat) (xs : List State) :
    (preStates k xs).length = preN k xs.length := by
  unfold preStates preN
  split <;> simp <;> omega

theorem preStates_rows (k : Nat) (hk : k < 128) (xs : List State)
    (hx : ∀ s ∈ xs, RowBound k s) :
    pack (2^128) ((preStates k xs).map Prod.fst) =
      preR k xs.length (pack (2^128) (xs.map Prod.fst))
        (pack (2^128) (xs.map (fun s => s.2.1))) := by
  unfold preStates preR
  split
  · simp only [List.map_map, rowStep, Function.comp_def]
    exact (packedOne_correct k hk xs hx).symm
  · simp only [List.map_append, List.map_map, rowStep, Function.comp_def]
    have hz : Bounded (2^128) (xs.map (fun s => Rule30Submission.nextDiag k s.1 s.2.1 false)) :=
      bounded_map (by
        intro s _
        exact Nat.lt_of_lt_of_le (nextDiag_bounded _ _ _ _)
          (Nat.pow_le_pow_right (by decide) (by omega)))
    rw [pack_append_or _ _ hz]
    simp only [List.length_map]
    rw [packedZero_correct k hk xs hx, packedOne_correct k hk xs hx]

theorem preStates_previous (k : Nat) (xs : List State)
    (hx : ∀ s ∈ xs, s.1 < 2^128) :
    pack (2^128) ((preStates k xs).map (fun s => s.2.1)) =
      preCopy k xs.length (pack (2^128) (xs.map Prod.fst)) := by
  unfold preStates preCopy
  split
  · simp [List.map_map, rowStep, Function.comp_def]
  · simp only [List.map_append, List.map_map, rowStep, Function.comp_def]
    rw [pack_append_or _ _ (bounded_map hx)]
    simp only [List.length_map]

theorem preStates_weights (k : Nat) (xs : List State)
    (hx : ∀ s ∈ xs, s.2.2 < 2^128) :
    pack (2^128) ((preStates k xs).map (fun s => s.2.2)) =
      preCopy k xs.length (pack (2^128) (xs.map (fun s => s.2.2))) := by
  unfold preStates preCopy
  split
  · simp [List.map_map, rowStep, Function.comp_def]
  · simp only [List.map_append, List.map_map, rowStep, Function.comp_def]
    rw [pack_append_or _ _ (bounded_map hx)]
    simp only [List.length_map]

def scalarNext (k budget : Nat) (xs : List State) : List State :=
  ((preStates k xs).map (addCost k)).filter (fun s => decide (s.2.2 ≤ budget))

def scalarRun (budget : Nat) : Nat → Nat → List State → List State
  | 0, _, xs => xs
  | fuel+1, k, xs => scalarRun budget fuel (k+1) (scalarNext k budget xs)

theorem scalarNext_mem (k budget : Nat) (xs : List State) (s : State) (b : Bool)
    (hs : s ∈ xs) (he : k % 2 = 0 → b = true)
    (hb : (successor k b s).2.2 ≤ budget) :
    successor k b s ∈ scalarNext k budget xs := by
  apply List.mem_filter.mpr
  refine ⟨?_, by simpa using hb⟩
  apply List.mem_map.mpr
  refine ⟨rowStep k b s, ?_, rfl⟩
  unfold preStates
  split
  · next h => rw [he h]; exact List.mem_map.mpr ⟨s, hs, rfl⟩
  · apply List.mem_append.mpr
    cases b with
    | false => exact Or.inl (List.mem_map.mpr ⟨s, hs, rfl⟩)
    | true => exact Or.inr (List.mem_map.mpr ⟨s, hs, rfl⟩)

/-- Exhaustive coverage: an admissible Rule30 history with enough budget survives. -/
theorem scalarRun_nonempty (y : Nat → Bool) (budget : Nat) :
    ∀ fuel k xs s,
    k + fuel ≤ 128 → s ∈ xs →
    (∀ t, k ≤ t → t < k + fuel → t % 2 = 0 → y t = true) →
    Rule30Submission.PAD y k s.1 → Rule30Submission.PAD y (k-1) s.2.1 →
    s.2.2 + Rule30Submission.blackWeight
      (fun d => Ruliology.CellularAutomata.Rule30ZeroBoundary.recon y d 0) k fuel ≤ budget →
    scalarRun budget fuel k xs ≠ [] := by
  intro fuel
  induction fuel with
  | zero =>
    intro k xs s _ hs _ _ _ _ hempty
    simp only [scalarRun] at hempty
    rw [hempty] at hs
    exact List.not_mem_nil hs
  | succ fuel ih =>
    intro k xs s hk hs he hr hm hw hempty
    let sn := successor k (y k) s
    have hp := successor_PAD y k (by omega) s hr hm
    have hc := successor_cost y k (by omega) s hr hm
    have hsum : sn.2.2 + Rule30Submission.blackWeight
        (fun d => Ruliology.CellularAutomata.Rule30ZeroBoundary.recon y d 0)
        (k+1) fuel ≤ budget := by
      dsimp [sn]
      rw [hc]
      simp only [Rule30Submission.blackWeight] at hw
      omega
    have hmem : sn ∈ scalarNext k budget xs := scalarNext_mem k budget xs s (y k)
      hs (fun h => he k (Nat.le_refl _) (by omega) h) (by change sn.2.2 ≤ budget; omega)
    exact ih (k+1) (scalarNext k budget xs) sn (by omega) hmem
      (fun t ht htf ht2 => he t (by omega) (by omega) ht2)
      hp.1 hp.2 hsum hempty

/-- Link an empty scalar frontier directly to the official zero-boundary model. -/
theorem blackWeight_gt_of_scalarRun (depth budget : Nat) (hd : depth ≤ 128)
    (hcheck : scalarRun budget depth 0 [(0,0,0)] = [])
    (L : Nat → Bool)
    (heven : ∀ t, t < depth → t % 2 = 0 →
      Ruliology.CellularAutomata.Rule30ZeroBoundary.zrow L t 1 = true) :
    budget < Rule30Submission.blackWeight L 0 depth := by
  apply Nat.lt_of_not_ge
  intro hw
  let y : Nat → Bool := fun t => Ruliology.CellularAutomata.Rule30ZeroBoundary.zrow L t 1
  have hag : ∀ k n, Rule30Submission.blackWeight
      (fun d => Ruliology.CellularAutomata.Rule30ZeroBoundary.recon y d 0) k n =
      Rule30Submission.blackWeight L k n := by
    intro k n
    induction n generalizing k with
    | zero => rfl
    | succ n ih =>
      simp only [Rule30Submission.blackWeight]
      have hb : Ruliology.CellularAutomata.Rule30ZeroBoundary.recon y (k+1) 0 = L (k+1) :=
        (Ruliology.CellularAutomata.Rule30ZeroBoundary.history_eq_recon L (k+1) 0).symm
      simp only [hb, ih]
  apply scalarRun_nonempty y budget depth 0 [(0,0,0)] (0,0,0) (by omega)
    (by simp) (fun t _ ht ht2 => heven t (by omega) ht2)
    (fun i hi => by omega) (fun i hi => by omega) _ hcheck
  simpa only [hag, Nat.zero_add] using hw

end ScalarTransition


namespace ScalarExecutable
open PackedDigits ScalarTransition

def encode (xs : List State) : SWARProbe.Front :=
  ⟨xs.length, pack (2^128) (xs.map Prod.fst),
    pack (2^128) (xs.map (fun s => s.2.1)),
    pack (2^128) (xs.map (fun s => s.2.2))⟩

def preFront (k : Nat) (s : SWARProbe.Front) : SWARProbe.Front :=
  ⟨preN k s.n, preR k s.n s.r s.m, preCopy k s.n s.r, preCopy k s.n s.b⟩

def nextFactored (k budget : Nat) (s : SWARProbe.Front) : SWARProbe.Front :=
  let pre := preFront k s
  let ones := repeatField 128 pre.n 1
  let bn := pre.b + ((pre.r >>> k) &&& ones)
  SWARProbe.compact 18 (ones ^^^ packedDead budget pre.n bn) ⟨pre.n,pre.r,pre.m,bn⟩

theorem rep_eq (n : Nat) : SWARProbe.rep n = repeatField 128 n 1 := by
  simp [SWARProbe.rep, SWARProbe.mask, repeatField, Nat.shiftLeft_eq]
  rfl

theorem scan_eq (x ones shift : Nat) :
    SWARProbe.scan x ones shift = ScalarTransition.scan 128 x ones shift := by
  simp [SWARProbe.scan, ScalarTransition.scan, SWARProbe.mask, Nat.shiftLeft_eq]

theorem scans_seven (n x : Nat) :
    scans 128 n 7 x =
      scan 128 (scan 128 (scan 128 (scan 128 (scan 128 (scan 128 (scan 128 x
        (repeatField 128 n 1) 1) (repeatField 128 n 1) 2) (repeatField 128 n 1) 4)
        (repeatField 128 n 1) 8) (repeatField 128 n 1) 16)
        (repeatField 128 n 1) 32) (repeatField 128 n 1) 64 := rfl

theorem next_eq_factored (k budget : Nat) (s : SWARProbe.Front) :
    SWARProbe.next k budget s = nextFactored k budget s := by
  have hone (a n : Nat) : a * repeatField 128 n 1 = repeatField 128 n a := by
    simp [repeatField]
  change (let ones := SWARProbe.rep s.n
    let q := s.r ||| (s.m <<< 1)
    let x := SWARProbe.scan q ones 1
    let x := SWARProbe.scan x ones 2
    let x := SWARProbe.scan x ones 4
    let x := SWARProbe.scan x ones 8
    let x := SWARProbe.scan x ones 16
    let x := SWARProbe.scan x ones 32
    let x := SWARProbe.scan x ones 64
    let z := (x &&& (((1 <<< k)-1)*ones)) <<< 1
    let o := z ^^^ (((1 <<< (k+1))-1)*ones)
    let pre : SWARProbe.Front := if decide (k%2=0) then ⟨s.n,o,s.r,s.b⟩
      else ⟨2*s.n,z ||| (o <<< (128*s.n)),s.r ||| (s.r <<< (128*s.n)),s.b ||| (s.b <<< (128*s.n))⟩
    let ones := SWARProbe.rep pre.n
    let bn := pre.b + ((pre.r >>> k) &&& ones)
    let dead := (((bn ||| (128*ones)) - ((budget+1)*ones)) >>> 7) &&& ones
    SWARProbe.compact 18 (ones ^^^ dead) ⟨pre.n,pre.r,pre.m,bn⟩) = _
  simp only [rep_eq, scan_eq, ← scans_seven, Nat.one_shiftLeft, hone, decide_eq_true_eq]
  change (let zero := (scans 128 s.n 7 (s.r ||| (s.m <<< 1)) &&&
          repeatField 128 s.n (2^k-1)) <<< 1
    let one := zero ^^^ repeatField 128 s.n (2^(k+1)-1)
    let pre : SWARProbe.Front := if k%2=0 then ⟨s.n,one,s.r,s.b⟩
      else ⟨2*s.n,zero ||| (one <<< (128*s.n)),
        s.r ||| (s.r <<< (128*s.n)),s.b ||| (s.b <<< (128*s.n))⟩
    let bn := pre.b + ((pre.r >>> k) &&& repeatField 128 pre.n 1)
    SWARProbe.compact 18
      (repeatField 128 pre.n 1 ^^^ packedDead budget pre.n bn)
      ⟨pre.n,pre.r,pre.m,bn⟩) = _
  by_cases h : k%2=0 <;>
    simp only [nextFactored, preFront, preN, preR, preCopy, packedOne, packedZero,
      h, ↓reduceIte]

theorem preFront_encode (k : Nat) (hk : k < 128) (xs : List State)
    (hr : ∀ s ∈ xs, RowBound k s) (hb : ∀ s ∈ xs, s.2.2 < 2^128) :
    preFront k (encode xs) = encode (preStates k xs) := by
  have hrb : ∀ s ∈ xs, s.1 < 2^128 := by
    intro s hs
    exact Nat.lt_of_lt_of_le (hr s hs).1 (Nat.pow_le_pow_right (by decide) (by omega))
  unfold preFront encode
  congr 1
  · exact (preStates_length k xs).symm
  · exact (preStates_rows k hk xs hr).symm
  · exact (preStates_previous k xs hrb).symm
  · exact (preStates_weights k xs hb).symm

def chargeFront (k : Nat) (s : SWARProbe.Front) : SWARProbe.Front :=
  ⟨s.n,s.r,s.m,s.b + ((s.r >>> k) &&& repeatField 128 s.n 1)⟩

theorem chargeFront_encode (k : Nat) (hk : k < 128) (xs : List State)
    (hr : ∀ s ∈ xs, s.1 < 2^128) :
    chargeFront k (encode xs) = encode (xs.map (addCost k)) := by
  unfold chargeFront encode
  simp only [List.length_map, List.map_map, addCost, Function.comp_def]
  congr 1
  exact packedCost_correct k hk xs hr

theorem preStates_all (k : Nat) (xs : List State) (P : State → Prop)
    (h : ∀ s ∈ xs, ∀ b, P (rowStep k b s)) :
    ∀ s ∈ preStates k xs, P s := by
  intro s hs
  unfold preStates at hs
  split at hs
  · obtain ⟨a, ha, rfl⟩ := List.mem_map.mp hs
    exact h a ha true
  · rcases List.mem_append.mp hs with hs | hs
    · obtain ⟨a, ha, rfl⟩ := List.mem_map.mp hs
      exact h a ha false
    · obtain ⟨a, ha, rfl⟩ := List.mem_map.mp hs
      exact h a ha true

theorem preStates_bounds (k budget : Nat) (xs : List State)
    (hr : ∀ s ∈ xs, RowBound k s) (hb : ∀ s ∈ xs, s.2.2 ≤ budget) :
    ∀ s ∈ preStates k xs, s.1 < 2^(k+1) ∧ s.2.1 < 2^k ∧ s.2.2 ≤ budget := by
  apply preStates_all
  intro s hs b
  exact ⟨nextDiag_bounded k s.1 s.2.1 b, (hr s hs).1, hb s hs⟩

/-- Exact frozen executable `next`, with only stable compaction left uninterpreted. -/
theorem next_before_compact (k budget : Nat) (hk : k < 128) (hbudget : budget < 127)
    (xs : List State) (hr : ∀ s ∈ xs, RowBound k s) (hb : ∀ s ∈ xs, s.2.2 ≤ budget) :
    let ys := (preStates k xs).map (addCost k)
    SWARProbe.next k budget (encode xs) =
      SWARProbe.compact 18
        (pack (2^128) (ys.map (fun s => if s.2.2 ≤ budget then 1 else 0))) (encode ys) := by
  let pre := preStates k xs
  let ys := pre.map (addCost k)
  have hpre := preStates_bounds k budget xs hr hb
  have hpr : ∀ s ∈ pre, s.1 < 2^128 := by
    intro s hs
    exact Nat.lt_of_lt_of_le (hpre s hs).1
      (Nat.pow_le_pow_right (by decide) (by omega))
  have hwb : ∀ s ∈ xs, s.2.2 < 2^128 := by
    intro s hs
    have hh := hb s hs
    omega
  have hyb : ∀ s ∈ ys, s.2.2 < 128 := by
    intro s hs
    obtain ⟨a, ha, rfl⟩ := List.mem_map.mp hs
    have h := (hpre a ha).2.2
    have hc := costBit_le_one k a.1
    change a.2.2 + costBit k a.1 < 128
    omega
  have hc := chargeFront_encode k hk pre hpr
  have hn : ys.length = pre.length := List.length_map _
  have halive := packedAlive_correct budget (by omega)
    (ys.map (fun s => s.2.2)) (by
      intro b hb
      obtain ⟨s, hs, rfl⟩ := List.mem_map.mp hb
      exact hyb s hs)
  simp only [List.length_map, List.map_map, Function.comp_def] at halive
  rw [next_eq_factored]
  unfold nextFactored
  rw [preFront_encode k hk xs hr hwb]
  change SWARProbe.compact 18
    (repeatField 128 pre.length 1 ^^^
      packedDead budget pre.length (chargeFront k (encode pre)).b)
    (chargeFront k (encode pre)) = _
  rw [hc]
  change SWARProbe.compact 18
    (repeatField 128 pre.length 1 ^^^
      packedDead budget pre.length (pack (2^128) (ys.map (fun s => s.2.2))))
    (encode ys) = _
  rw [← hn, halive]

theorem next_correct_of_compact (k budget : Nat) (hk : k < 128) (hbudget : budget < 127)
    (xs : List State) (hr : ∀ s ∈ xs, RowBound k s) (hb : ∀ s ∈ xs, s.2.2 ≤ budget)
    (hcompact : let ys := (preStates k xs).map (addCost k)
      SWARProbe.compact 18
        (pack (2^128) (ys.map (fun s => if s.2.2 ≤ budget then 1 else 0))) (encode ys) =
      encode (ys.filter (fun s => decide (s.2.2 ≤ budget)))) :
    SWARProbe.next k budget (encode xs) = encode (scalarNext k budget xs) := by
  rw [next_before_compact k budget hk hbudget xs hr hb]
  exact hcompact

end ScalarExecutable


namespace CompactExecutable
open PackedDigits PackedRouting

theorem rep_packed (n : Nat) :
    SWARProbe.rep n = pack (2^128) (List.replicate n 1) := by
  rw [ScalarExecutable.rep_eq, ScalarTransition.repeatField_eq_pack (by decide)]

theorem prefixCounts_eq (fuel step n d : Nat) :
    SWARProbe.prefixCounts fuel step ((1 <<< (128*n))-1) d =
      PackedDigits.prefixCounts 128 fuel step n d := by
  induction fuel generalizing step d with
  | zero => rfl
  | succ fuel ih =>
    exact ih (step*2) (d + ((d <<< (128*step)) &&& ((1 <<< (128*n))-1)))

theorem routeOne_eq (n stage d value : Nat) :
    routeOne 128 n stage d value =
      let move := ((d >>> stage) &&& SWARProbe.rep n) * SWARProbe.mask
      (value &&& (((1 <<< (128*n))-1) ^^^ move)) |||
        ((value &&& move) >>> (128*(1 <<< stage))) := by
  rw [rep_packed, Nat.one_shiftLeft]
  simp only [routeOne, RouteInvariant.routeValue, fullMask, moveMask, SWARProbe.mask, Nat.one_shiftLeft]
  rfl

theorem routeLanes_step (fuel stage n d : Nat) (s : SWARProbe.Front) :
    SWARProbe.routeLanes (fuel+1) stage ((1 <<< (128*n))-1) (SWARProbe.rep n) d s =
      SWARProbe.routeLanes fuel (stage+1) ((1 <<< (128*n))-1) (SWARProbe.rep n)
        (routeOne 128 n stage d d)
        ⟨s.n, routeOne 128 n stage d s.r, routeOne 128 n stage d s.m,
          routeOne 128 n stage d s.b⟩ := by
  simp only [routeOne_eq]
  rfl

/-- Each actual payload field follows the same count-driven scalar loop. -/
theorem routeLanes_fields (fuel stage n d : Nat) (s : SWARProbe.Front) :
    let out := SWARProbe.routeLanes fuel stage ((1 <<< (128*n))-1) (SWARProbe.rep n) d s
    out.n = s.n ∧
    out.r = (routeLoop 128 n fuel stage d s.r).2 ∧
    out.m = (routeLoop 128 n fuel stage d s.m).2 ∧
    out.b = (routeLoop 128 n fuel stage d s.b).2 := by
  induction fuel generalizing stage d s with
  | zero => simp [SWARProbe.routeLanes, routeLoop]
  | succ fuel ih =>
    rw [routeLanes_step]
    exact ih (stage+1) (routeOne 128 n stage d d)
      ⟨s.n,routeOne 128 n stage d s.r,routeOne 128 n stage d s.m,routeOne 128 n stage d s.b⟩

theorem compact_nonshortcut_fields (fuel : Nat) (flags : List Nat) (s : SWARProbe.Front)
    (hn : s.n = flags.length)
    (hz : pack (2^128) (aliveDigits flags) ≠ 0)
    (hall : pack (2^128) (aliveDigits flags) ≠ SWARProbe.rep s.n) :
    let out := SWARProbe.compact fuel (pack (2^128) (aliveDigits flags)) s
    out.n = (compactCore 128 fuel flags s.r).1 ∧
    out.r = (compactCore 128 fuel flags s.r).2 ∧
    out.m = (compactCore 128 fuel flags s.m).2 ∧
    out.b = (compactCore 128 fuel flags s.b).2 := by
  have hzero : Nat.beq (pack (2^128) (aliveDigits flags)) 0 = false := by
    cases h : Nat.beq (pack (2^128) (aliveDigits flags)) 0 with
    | false => rfl
    | true => exact False.elim (hz (Nat.eq_of_beq_eq_true h))
  have hone : Nat.beq (pack (2^128) (aliveDigits flags)) (SWARProbe.rep s.n) = false := by
    cases h : Nat.beq (pack (2^128) (aliveDigits flags)) (SWARProbe.rep s.n) with
    | false => rfl
    | true => exact False.elim (hall (Nat.eq_of_beq_eq_true h))
  let raw : SWARProbe.Front :=
    let full := (1 <<< (128*s.n))-1
    let ones := SWARProbe.rep s.n
    let d := SWARProbe.prefixCounts fuel 1 full (ones ^^^ pack (2^128) (aliveDigits flags))
    let count := s.n - ((d >>> (128*(s.n-1))) &&& SWARProbe.mask)
    let alive := pack (2^128) (aliveDigits flags) * SWARProbe.mask
    SWARProbe.routeLanes fuel 0 full ones (d &&& alive)
      ⟨count,s.r &&& alive,s.m &&& alive,s.b &&& alive⟩
  have hraw : SWARProbe.compact fuel (pack (2^128) (aliveDigits flags)) s = raw := by
    unfold SWARProbe.compact
    rw [hzero, hone]
    rfl
  rw [hraw]
  dsimp only [raw]
  rw [hn, prefixCounts_eq, rep_packed]
  have hmask : SWARProbe.mask = 2^128-1 := by decide +kernel
  rw [hmask]
  let counts := PackedDigits.prefixCounts 128 fuel 1 flags.length
    (pack (2^128) (List.replicate flags.length 1) ^^^ pack (2^128) (aliveDigits flags))
  let alive := pack (2^128) (aliveDigits flags) * (2^128-1)
  let count := flags.length - ((counts >>> (128*(flags.length-1))) &&& (2^128-1))
  have hh := routeLanes_fields fuel 0 flags.length (counts &&& alive)
    ⟨count,s.r &&& alive,s.m &&& alive,s.b &&& alive⟩
  simp only [rep_packed] at hh
  simpa only [compactCore, counts, alive, count, Nat.one_shiftLeft] using hh

end CompactExecutable


namespace CompactCorrect
open PackedDigits PackedRouting ScalarTransition ScalarExecutable

def flags (xs : List State) (keep : State → Bool) : List Nat :=
    xs.map (fun s => if keep s then 0 else 1)

def digits (xs : List State) (keep : State → Bool) : List Nat :=
    xs.map (fun s => if keep s then 1 else 0)

def readState (xs : List State) (i : Nat) : State := (xs[i]?).getD (0,0,0)

theorem map_range_read (xs : List State) : (List.range xs.length).map (readState xs) = xs := by
  apply List.ext_getElem?
  intro i
  by_cases hi : i < xs.length
  · simp [readState, List.getElem?_map, List.getElem?_range hi, List.getElem?_eq_getElem hi]
  · have hr : (List.range xs.length)[i]? = none := List.getElem?_eq_none (by simp; omega)
    have hx : xs[i]? = none := List.getElem?_eq_none (by omega)
    simp [List.getElem?_map, hr, hx]

theorem flag_at (xs : List State) (keep : State → Bool) (i : Nat) (hi : i < xs.length) :
    ((flags xs keep)[i]?).getD 0 = if keep (readState xs i) then 0 else 1 := by
  simp [flags, readState, List.getElem?_map, List.getElem?_eq_getElem hi]

theorem flags_zero_one (xs : List State) (keep : State → Bool) :
    ∀ a ∈ flags xs keep, a ≤ 1 := by
  intro a ha
  obtain ⟨s, _, rfl⟩ := List.mem_map.mp ha
  cases keep s <;> decide

theorem aliveDigits_flags (xs : List State) (keep : State → Bool) :
    aliveDigits (flags xs keep) = digits xs keep := by
  rw [aliveDigits_map]
  unfold flags digits
  rw [List.map_map]
  apply List.map_congr_left
  intro s _
  change (if (if keep s then (0 : Nat) else 1) = 0 then 1 else 0) = (if keep s then 1 else 0)
  cases keep s <;> rfl

theorem liveIndices_flags (xs : List State) (keep : State → Bool) :
    liveIndices (flags xs keep) = (List.range xs.length).filter (fun i => keep (readState xs i)) := by
  unfold liveIndices
  simp only [flags, List.length_map]
  apply List.filter_congr
  intro i hi
  have hi' := List.mem_range.mp hi
  have hh := flag_at xs keep i hi'
  change (((flags xs keep)[i]?).getD 0 == 0) = keep (readState xs i)
  rw [hh]
  cases keep (readState xs i) <;> rfl

theorem live_states (xs : List State) (keep : State → Bool) :
    (liveIndices (flags xs keep)).map (readState xs) = xs.filter keep := by
  rw [liveIndices_flags]
  have he := List.filter_map (f := readState xs) (p := keep) (l := List.range xs.length)
  rw [map_range_read] at he
  exact he.symm

theorem indexed_payload (xs : List State) (payload : State → Nat) :
    (List.range xs.length).map (fun i => payload (readState xs i)) =
      xs.map payload := by
  have hh := congrArg (List.map payload) (map_range_read xs)
  simpa only [List.map_map, Function.comp_def] using hh

theorem live_payload (xs : List State) (keep : State → Bool) (payload : State → Nat) :
    (liveIndices (flags xs keep)).map (fun i => payload (readState xs i)) =
      (xs.filter keep).map payload := by
  have hh := congrArg (List.map payload) (live_states xs keep)
  simpa only [List.map_map, Function.comp_def] using hh

/-- No boundedness assumption is needed for detecting a zero packed list. -/
theorem pack_zero_all {radix : Nat} (hr : 0 < radix) {xs : List Nat}
    (hz : pack radix xs = 0) : ∀ a ∈ xs, a = 0 := by
  induction xs with
  | nil => simp
  | cons a xs ih =>
    have he : a = 0 := by simp only [pack] at hz; omega
    have ht : pack radix xs = 0 := by
      by_cases ht : pack radix xs = 0
      · exact ht
      · have hp := Nat.mul_pos hr (Nat.pos_of_ne_zero ht)
        simp only [pack] at hz
        omega
    intro b hb
    rcases List.mem_cons.mp hb with rfl | hb
    · exact he
    · exact ih ht b hb

theorem pack_injective {radix : Nat} {xs ys : List Nat}
    (hx : Bounded radix xs) (hy : Bounded radix ys) (hlen : xs.length = ys.length)
    (he : pack radix xs = pack radix ys) : xs = ys := by
  induction xs generalizing ys with
  | nil => cases ys <;> simp_all
  | cons a xs ih =>
    cases ys with
    | nil => simp at hlen
    | cons b ys =>
      have ha : a < radix := hx a (by simp)
      have hb : b < radix := hy b (by simp)
      have hxt : Bounded radix xs := by intro c hc; exact hx c (by simp [hc])
      have hyt : Bounded radix ys := by intro c hc; exact hy c (by simp [hc])
      have hab := congrArg (fun v => v % radix) he
      rw [pack_head xs ha, pack_head ys hb] at hab
      have htail := congrArg (fun v => v / radix) he
      rw [pack_tail xs ha, pack_tail ys hb] at htail
      have htt := ih hxt hyt (by simpa using hlen) htail
      simp [hab, htt]
theorem readState_mem {xs : List State} {i : Nat} (hi : i < xs.length) : readState xs i ∈ xs := by
  unfold readState
  rw [List.getElem?_eq_getElem hi]
  exact List.getElem_mem hi

theorem core_typed (xs : List State) (keep : State → Bool) (payload : State → Nat)
    (hn : xs.length ≤ 2^18) (hp : ∀ s ∈ xs, payload s < 2^128) :
    compactCore 128 18 (flags xs keep) (pack (2^128) (xs.map payload)) =
      ((xs.filter keep).length, pack (2^128) ((xs.filter keep).map payload)) := by
  have hl : (flags xs keep).length = xs.length := by simp [flags]
  have hsmall : (flags xs keep).length < 2^128 := by
    rw [hl]
    have hh : 2^18 < 2^128 := by decide
    omega
  have hbits : (flags xs keep).length ≤ 2^18 := by rw [hl]; exact hn
  have hpayload : ∀ i < (flags xs keep).length, payload (readState xs i) < 2^128 := by
    intro i hi
    exact hp _ (readState_mem (by simpa [hl] using hi))
  have hh := compactCore_correct (by decide : 0 < 128) (by decide : 18 ≤ 128)
    (flags xs keep) (fun i => payload (readState xs i)) (flags_zero_one xs keep) hsmall hbits hpayload
  have hcount : (liveIndices (flags xs keep)).length = (xs.filter keep).length := by
    have hc := congrArg List.length (live_states xs keep)
    simpa only [List.length_map] using hc
  rw [hl, indexed_payload, live_payload, hcount] at hh
  exact hh

theorem digits_bounded (xs : List State) (keep : State → Bool) : Bounded (2^128) (digits xs keep) := by
  intro a ha
  obtain ⟨s, _, rfl⟩ := List.mem_map.mp ha
  cases keep s <;> decide

theorem filter_eq_nil_of_digits_zero (xs : List State) (keep : State → Bool)
    (hz : pack (2^128) (digits xs keep) = 0) : xs.filter keep = [] := by
  apply List.filter_eq_nil_iff.mpr
  intro s hs hk
  have hh := pack_zero_all (by decide : 0 < 2^128) hz
    (if keep s then 1 else 0) (List.mem_map.mpr ⟨s, hs, rfl⟩)
  simp [hk] at hh

theorem filter_eq_self_of_digits_ones (xs : List State) (keep : State → Bool)
    (hz : pack (2^128) (digits xs keep) = pack (2^128) (List.replicate xs.length 1)) :
    xs.filter keep = xs := by
  have ho : Bounded (2^128) (List.replicate xs.length 1) := by
    intro a ha
    have he : a = 1 := (List.mem_replicate.mp ha).2
    simp [he]
  have he := pack_injective (digits_bounded xs keep) ho (by simp [digits]) hz
  apply List.filter_eq_self.mpr
  intro s hs
  have hm : (if keep s then 1 else 0) ∈ digits xs keep := List.mem_map.mpr ⟨s, hs, rfl⟩
  rw [he] at hm
  have hh : (if keep s then (1 : Nat) else 0) = 1 := (List.mem_replicate.mp hm).2
  cases hk : keep s with
  | false => simp [hk] at hh
  | true => rfl
theorem front_ext {a b : SWARProbe.Front}
    (hn : a.n = b.n) (hr : a.r = b.r) (hm : a.m = b.m) (hb : a.b = b.b) : a = b := by
  cases a
  cases b
  simp_all

/-- The frozen executable compact18 is exactly stable filtering for arbitrary
state predicates, with explicit capacity and payload-size bounds. -/
theorem compact_correct (xs : List State) (keep : State → Bool) (hn : xs.length ≤ 2^18)
    (hr : ∀ s ∈ xs, s.1 < 2^128)
    (hm : ∀ s ∈ xs, s.2.1 < 2^128)
    (hb : ∀ s ∈ xs, s.2.2 < 2^128) :
    SWARProbe.compact 18 (pack (2^128) (digits xs keep)) (encode xs) = encode (xs.filter keep) := by
  by_cases hz : pack (2^128) (digits xs keep) = 0
  · have he := filter_eq_nil_of_digits_zero xs keep hz
    rw [hz, he]
    rfl
  · have hzero : Nat.beq (pack (2^128) (digits xs keep)) 0 = false := by
      cases h : Nat.beq (pack (2^128) (digits xs keep)) 0 with
      | false => rfl
      | true => exact False.elim (hz (Nat.eq_of_beq_eq_true h))
    by_cases hall : pack (2^128) (digits xs keep) = SWARProbe.rep (encode xs).n
    · have hone : Nat.beq (pack (2^128) (digits xs keep)) (SWARProbe.rep (encode xs).n) = true := by
        simp [hall]
      have he := filter_eq_self_of_digits_ones xs keep
        (by simpa only [encode, CompactExecutable.rep_packed] using hall)
      rw [he]
      unfold SWARProbe.compact
      rw [hzero, hone]
      rfl
    · have hflags : (encode xs).n = (flags xs keep).length := by simp [encode, flags]
      have hh := CompactExecutable.compact_nonshortcut_fields 18 (flags xs keep) (encode xs) hflags
        (by simpa only [aliveDigits_flags] using hz)
        (by simpa only [aliveDigits_flags] using hall)
      have cr := core_typed xs keep Prod.fst hn hr
      have cm := core_typed xs keep (fun s => s.2.1) hn hm
      have cb := core_typed xs keep (fun s => s.2.2) hn hb
      dsimp only at hh
      simp only [aliveDigits_flags, encode] at hh
      rw [cr, cm, cb] at hh
      apply front_ext
      · exact hh.1
      · exact hh.2.1
      · exact hh.2.2.1
      · exact hh.2.2.2
end CompactCorrect


namespace CheckpointSoundness
open PackedDigits ScalarTransition ScalarExecutable
open Ruliology.CellularAutomata.Rule30ZeroBoundary

def Valid (k budget : Nat) (xs : List State) : Prop :=
  ∀ s ∈ xs, RowBound k s ∧ s.2.2 ≤ budget

theorem scalarNext_valid (k budget : Nat) (xs : List State) (hx : Valid k budget xs) :
    Valid (k+1) budget (scalarNext k budget xs) := by
  intro s hs
  obtain ⟨hmem, hbudget⟩ := List.mem_filter.mp hs
  obtain ⟨a, ha, rfl⟩ := List.mem_map.mp hmem
  have hpre := preStates_bounds k budget xs (fun s hs => (hx s hs).1)
    (fun s hs => (hx s hs).2) a ha
  refine ⟨⟨hpre.1, ?_⟩, by simpa using hbudget⟩
  exact Nat.lt_of_lt_of_le hpre.2.1 (Nat.pow_le_pow_right (by decide) (by omega))

/-- The exact interface supplied by compaction plus the scalar adapter. -/
def StepCorrect : Prop :=
  ∀ k budget xs, k < 128 → budget < 127 → Valid k budget xs →
    preN k xs.length ≤ 2^18 →
    SWARProbe.next k budget (encode xs) = encode (scalarNext k budget xs)

/-- This frontier admits no fitting reconstruction over the remaining horizon. -/
def Excluded (k fuel budget : Nat) (front : SWARProbe.Front) : Prop :=
  ∀ xs, encode xs = front → Valid k budget xs →
    ∀ y : Nat → Bool,
    (∀ t, k ≤ t → t < k+fuel → t%2=0 → y t=true) →
    ∀ s ∈ xs,
    Rule30Submission.PAD y k s.1 → Rule30Submission.PAD y (k-1) s.2.1 →
    s.2.2 + Rule30Submission.blackWeight (fun d => recon y d 0) k fuel ≤ budget → False

theorem excluded_empty (k fuel budget : Nat) (front : SWARProbe.Front)
    (hn : front.n = 0) : Excluded k fuel budget front := by
  intro xs hx _ _ _ s hs _ _ _
  have he := congrArg SWARProbe.Front.n hx
  change xs.length = front.n at he
  rw [hn] at he
  have hxnil := List.length_eq_zero_iff.mp he
  rw [hxnil] at hs
  exact List.not_mem_nil hs

/-- One already checked packed transition transports exclusion backward. -/
theorem excluded_step (hsem : StepCorrect) (k fuel budget : Nat)
    (front nextFront : SWARProbe.Front) (hk : k+fuel+1 ≤ 128) (hb : budget < 127)
    (hcap : preN k front.n ≤ 2^18)
    (hnext : SWARProbe.next k budget front = nextFront)
    (hexcluded : Excluded (k+1) fuel budget nextFront) :
    Excluded k (fuel+1) budget front := by
  intro xs hx hv y he s hs hr hm hw
  have hn := congrArg SWARProbe.Front.n hx
  change xs.length = front.n at hn
  have heq : encode (scalarNext k budget xs) = nextFront := by
    rw [← hsem k budget xs (by omega) hb hv (by simpa [hn] using hcap), hx, hnext]
  let sn := successor k (y k) s
  have hp := successor_PAD y k (by omega) s hr hm
  have hc := successor_cost y k (by omega) s hr hm
  have hsum : sn.2.2 + Rule30Submission.blackWeight (fun d => recon y d 0)
      (k+1) fuel ≤ budget := by
    dsimp [sn]
    rw [hc]
    simp only [Rule30Submission.blackWeight] at hw
    omega
  have hmem : sn ∈ scalarNext k budget xs := scalarNext_mem k budget xs s (y k)
    hs (fun h => he k (Nat.le_refl _) (by omega) h)
    (by change sn.2.2 ≤ budget; omega)
  exact hexcluded (scalarNext k budget xs) heq (scalarNext_valid k budget xs hv)
    y (fun t ht htf ht2 => he t (by omega) (by omega) ht2) sn hmem hp.1 hp.2 hsum

/-- Official zero-boundary conclusion from a root exclusion certificate. -/
theorem excluded_root_weight (depth budget : Nat)
    (hexcluded : Excluded 0 depth budget ⟨1,0,0,0⟩)
    (L : Nat → Bool) (heven : ∀ t, t < depth → t%2=0 → zrow L t 1=true) :
    budget < Rule30Submission.blackWeight L 0 depth := by
  apply Nat.lt_of_not_ge
  intro hw
  let y : Nat → Bool := fun t => zrow L t 1
  have hag : ∀ k n, Rule30Submission.blackWeight (fun d => recon y d 0) k n =
      Rule30Submission.blackWeight L k n := by
    intro k n
    induction n generalizing k with
    | zero => rfl
    | succ n ih =>
      simp only [Rule30Submission.blackWeight]
      have hb : recon y (k+1) 0 = L (k+1) := (history_eq_recon L (k+1) 0).symm
      simp only [hb, ih]
  have hv : Valid 0 budget [(0,0,0)] := by
    intro s hs
    simp only [List.mem_singleton] at hs
    subst s
    constructor
    · simp [RowBound]
    · exact Nat.zero_le _
  apply hexcluded [(0,0,0)] rfl hv y
    (fun t _ ht hp => heven t (by omega) hp) (0,0,0) (by simp)
    (fun i hi => by omega) (fun i hi => by omega)
  simpa only [hag, Nat.zero_add] using hw

end CheckpointSoundness


namespace CheckpointSoundness
open PackedDigits ScalarTransition ScalarExecutable

/-- Stable compaction supplies the last hypothesis of the actual transition. -/
theorem step_correct_of_filter
    (hcompact : ∀ (xs : List State) (keep : State → Bool), xs.length ≤ 2^18 →
      (∀ s ∈ xs, s.1 < 2^128) → (∀ s ∈ xs, s.2.1 < 2^128) →
      (∀ s ∈ xs, s.2.2 < 2^128) →
      SWARProbe.compact 18 (pack (2^128) (xs.map (fun s => if keep s then 1 else 0)))
        (encode xs) = encode (xs.filter keep)) : StepCorrect := by
  intro k budget xs hk hb hv hcap
  apply next_correct_of_compact k budget hk hb xs
    (fun s hs => (hv s hs).1) (fun s hs => (hv s hs).2)
  let pre := preStates k xs
  let ys := pre.map (addCost k)
  have hp := preStates_bounds k budget xs (fun s hs => (hv s hs).1)
    (fun s hs => (hv s hs).2)
  have hn : ys.length ≤ 2^18 := by
    simpa only [ys, pre, List.length_map, preStates_length] using hcap
  have hr : ∀ s ∈ ys, s.1 < 2^128 := by
    intro s hs
    obtain ⟨a, ha, rfl⟩ := List.mem_map.mp hs
    exact Nat.lt_of_lt_of_le (hp a ha).1 (Nat.pow_le_pow_right (by decide) (by omega))
  have hm : ∀ s ∈ ys, s.2.1 < 2^128 := by
    intro s hs
    obtain ⟨a, ha, rfl⟩ := List.mem_map.mp hs
    exact Nat.lt_of_lt_of_le (hp a ha).2.1 (Nat.pow_le_pow_right (by decide) (by omega))
  have hw : ∀ s ∈ ys, s.2.2 < 2^128 := by
    intro s hs
    obtain ⟨a, ha, rfl⟩ := List.mem_map.mp hs
    have hcost := (hp a ha).2.2
    have hc := costBit_le_one k a.1
    change a.2.2 + costBit k a.1 < 2^128
    omega
  simpa only [decide_eq_true_eq] using
    hcompact ys (fun s => decide (s.2.2 ≤ budget)) hn hr hm hw

end CheckpointSoundness


namespace CheckpointSoundness

/-- Unconditional closure of the packed/scalar transition interface. -/
theorem step_correct : StepCorrect :=
  step_correct_of_filter CompactCorrect.compact_correct

end CheckpointSoundness

namespace SWARProbe
open Lean Elab Term
meta def hexDigit (c : UInt8) : Nat :=
  if c.toNat ≤ 57 then c.toNat - 48 else c.toNat - 87
elab "hexNat " p:str : term => do
  let data := p.getString.toUTF8
  let mut parts : Array Nat := #[]
  for i in [0:(data.size + 15) / 16] do
    let mut v := 0
    for j in [0:8] do
      let k := 16 * i + 2 * j
      if k + 1 < data.size then
        let byte := 16 * hexDigit data[k]! + hexDigit data[k+1]!
        v := v + (byte <<< (8 * j))
    parts := parts.push v
  let mut width := 64
  while parts.size > 1 do
    let mut merged := #[]
    for i in [0:(parts.size + 1) / 2] do
      let upper := if 2 * i + 1 < parts.size then parts[2 * i + 1]! else 0
      merged := merged.push (parts[2 * i]! + (upper <<< width))
    parts := merged
    width := width * 2
  return mkNatLit (parts[0]?.getD 0)

elab "laneNat " stride:num p:str : term => do
  let nbytes := stride.getNat
  let data := p.getString.toUTF8
  let mut parts : Array Nat := #[]
  for i in [0:data.size / (2 * nbytes)] do
    let mut v := 0
    for j in [0:nbytes] do
      let k := 2 * (nbytes * i + j)
      let byte := 16 * hexDigit data[k]! + hexDigit data[k+1]!
      v := v + (byte <<< (8 * j))
    parts := parts.push v
  let mut width := 128
  while parts.size > 1 do
    let mut merged := #[]
    for i in [0:(parts.size + 1) / 2] do
      let upper := if 2 * i + 1 < parts.size then parts[2 * i + 1]! else 0
      merged := merged.push (parts[2 * i]! + (upper <<< width))
    parts := merged
    width := width * 2
  return mkNatLit (parts[0]?.getD 0)

/- Transport decoding runs only during elaboration. It emits ordinary Nat literals;
   all mathematical equalities still undergo ordinary kernel checking. -/
meta def base64Digit (c : UInt8) : Nat :=
  let n := c.toNat
  if 65 ≤ n && n ≤ 90 then n - 65
  else if 97 ≤ n && n ≤ 122 then n - 71
  else if 48 ≤ n && n ≤ 57 then n + 4
  else if n = 43 then 62 else if n = 47 then 63 else 0

meta def decodeBase64 (text : String) : ByteArray := Id.run do
  let data := text.toUTF8
  let mut out := ByteArray.emptyWithCapacity (data.size / 4 * 3)
  for i in [0:data.size / 4] do
    let j := 4 * i
    let a := base64Digit data[j]!
    let b := base64Digit data[j+1]!
    let c := base64Digit data[j+2]!
    let d := base64Digit data[j+3]!
    out := out.push (UInt8.ofNat (a * 4 + b / 16))
    if data[j+2]!.toNat != 61 then
      out := out.push (UInt8.ofNat (b * 16 + c / 4))
    if data[j+3]!.toNat != 61 then
      out := out.push (UInt8.ofNat (c * 64 + d))
  return out

meta def decodeLz4 (data : ByteArray) (expected : Nat) : Except String ByteArray := do
  let mut out := ByteArray.emptyWithCapacity expected
  let mut pos := 0
  for _ in [0:data.size+1] do
    if pos = data.size then break
    if pos > data.size then throw "LZ4 token past input"
    let token := data[pos]!.toNat
    pos := pos + 1
    let mut literals := token / 16
    if literals = 15 then
      for _ in [0:data.size+1] do
        if pos ≥ data.size then throw "LZ4 truncated literal length"
        let extra := data[pos]!.toNat
        pos := pos + 1
        literals := literals + extra
        if extra != 255 then break
    if pos + literals > data.size || out.size + literals > expected then
      throw "LZ4 invalid literal range"
    for j in [0:literals] do out := out.push data[pos+j]!
    pos := pos + literals
    if pos = data.size then break
    if pos + 2 > data.size then throw "LZ4 truncated offset"
    let offset := data[pos]!.toNat + 256 * data[pos+1]!.toNat
    pos := pos + 2
    if offset = 0 || offset > out.size then throw "LZ4 invalid offset"
    let mut count := token % 16 + 4
    if token % 16 = 15 then
      for _ in [0:data.size+1] do
        if pos ≥ data.size then throw "LZ4 truncated match length"
        let extra := data[pos]!.toNat
        pos := pos + 1
        count := count + extra
        if extra != 255 then break
    if out.size + count > expected then throw "LZ4 output overflow"
    for _ in [0:count] do
      let v := out[out.size-offset]!
      out := out.push v
  if pos != data.size || out.size != expected then throw "LZ4 size mismatch"
  return out

elab "packedLane " stride:num count:num p:str : term => do
  let nbytes := stride.getNat
  if nbytes = 0 || nbytes > 16 then throwError "invalid lane byte width"
  let expected := count.getNat
  if expected % nbytes != 0 then throwError "unaligned lane bytes"
  let data ← match decodeLz4 (decodeBase64 p.getString) expected with
    | .ok data => pure data
    | .error message => throwError message
  let mut parts : Array Nat := #[]
  for i in [0:data.size / nbytes] do
    let mut v := 0
    for j in [0:nbytes] do
      v := v + (data[nbytes*i+j]!.toNat <<< (8*j))
    parts := parts.push v
  let mut width := 128
  while parts.size > 1 do
    let mut merged := #[]
    for i in [0:(parts.size + 1) / 2] do
      let upper := if 2*i+1 < parts.size then parts[2*i+1]! else 0
      merged := merged.push (parts[2*i]! + (upper <<< width))
    parts := merged
    width := width * 2
  return mkNatLit (parts[0]?.getD 0)


theorem run_join (budget fuel k : Nat) (s t z : Front)
    (hn : s.n ≠ 0) (hs : next k budget s = t)
    (ht : run budget fuel (k+1) t = z) :
    run budget (fuel+1) k s = z := by
  simp only [run]
  have hb : Nat.beq s.n 0 = false := by
    cases h : Nat.beq s.n 0 with
    | false => rfl
    | true => exact False.elim (hn (Nat.eq_of_beq_eq_true h))
  rw [hb]
  exact hs.symm ▸ ht

