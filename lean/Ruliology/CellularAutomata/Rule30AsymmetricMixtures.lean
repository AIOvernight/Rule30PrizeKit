theorem sub_of_and {A B : Nat} (h : A &&& B = A) : Sub A B := by
  intro x hx
  have hh := congrArg (fun n : Nat => n.testBit x) h
  rw [Nat.testBit_and, hx, Bool.true_and] at hh
  exact hh

def driver (a : Nat × Nat) : List Bool := word a.1 a.2
def Good (a : Nat × Nat) : Prop := (a.1=1 ∧ 10≤a.2) ∨ (a.1=2 ∧ 8≤a.2)
def blocks (as : List (Nat × Nat)) : List Bool := as.flatMap driver
def Admissible (as : List (Nat × Nat)) : Prop := ∀ a∈as, Good a

