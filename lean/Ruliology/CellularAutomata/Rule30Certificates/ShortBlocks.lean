namespace Ruliology.CellularAutomata.Rule30ShortBlockBound
open Rule30RunEnvelopes Rule30StripCertificates Rule30Jen Rule30FrontDichotomy Rule30FrontWitness
open Rule30SparseFrontSets Rule30FrontData Rule30FrontBound

theorem block_bound (u : List Bool) (hu : u.length≤9) : BlockBound u := by
  intro t hw hc j hj hb
  rcases capture_or_early t 102 (by decide) hw with ⟨a,ha,hblack⟩ | ⟨r,he,hm⟩
  · let n := 102-a-46
    have htime : t+a+46+n=t+102 := by dsimp [n];omega
    have hwhite : ∀ s, s<46+n → cell (t+a+s) 0=false := by
      intro s hs
      have hh := hw (a+s) (by dsimp [n] at hs;omega)
      simpa only [Nat.add_assoc] using hh
    have hm1 := mem_M1 (enc_encRow 14 (t+a) 0).1 (by
      rw [(enc_encRow 14 (t+a) 0).2 0 (by decide)]
      simpa using hblack)
    obtain ⟨r2,he2,hs2⟩ := enc_applyWord (List.replicate (46+n) false) (t+a) _ M1
      (enc_encRow 14 (t+a) 0) hm1 (fun s hs => by
        rw [List.length_replicate] at hs
        rw [hwhite s hs,List.getD_eq_getElem?_getD,List.getElem?_replicate,if_pos hs]
        rfl)
    rw [List.length_replicate] at he2
    have hs2' : Sstar.testBit r2=true := by
      rw [replicate_add_false,apply_append] at hs2
      exact sstar_whites n r2 ((applyWord_mono 14 _ Rule30FrontArrivalCapture.hcap) r2 hs2)
    have hh := Rule30ShortStripeBound.all_short (t+a+(46+n)) r2 he2 hs2' j (by omega)
    apply white_witness (t+102+j)
    simpa only [show t+a+(46+n)=t+102 by omega] using hh
  · have hr := enc_unique he (enc_encRow 24 (t+102) 0)
    rw [hr] at hm
    exact white_witness (t+102+j) (Rule30ShortCaptureBound.all_short (t+102) hm j (by omega))
end Ruliology.CellularAutomata.Rule30ShortBlockBound


