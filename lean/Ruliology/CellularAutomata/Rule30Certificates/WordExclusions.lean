  { w := c0000000001_w, b := c0000000001_b, nranks := c0000000001_nranks, rankP := c0000000001_rankP, posP := c0000000001_posP, perP := c0000000001_perP, wordP := c0000000001_wordP }

theorem c0000000001_check : c0000000001.check = true := by decide +kernel
theorem c0000000001_checkG : c0000000001.checkG = true := by decide +kernel

