    ∀ j : Nat, j<9 → ¬ (∀ i : Nat, i<14 → cell (t+j) (1+(i:Int))=true) := by
  have e0 := enc_encRow 24 t 0
  have m0 := hr

  have e1 : Enc 22 (t+1) (1:Int) (coreStep 24 (encRow t 0 24)) := by simpa using enc_core_step e0

  let r1 := coreStep 24 (encRow t 0 24)

  have m1 := core_sound edge0 m0

  have e2 : Enc 20 (t+2) (2:Int) (coreStep 22 r1) := by simpa using enc_core_step e1

  let r2 := coreStep 22 r1

  have m2 := core_sound edge1 m1

  have e3 : Enc 18 (t+3) (3:Int) (coreStep 20 r2) := by simpa using enc_core_step e2

  let r3 := coreStep 20 r2

  have m3 := core_sound edge2 m2

  have e4 : Enc 16 (t+4) (4:Int) (coreStep 18 r3) := by simpa using enc_core_step e3

