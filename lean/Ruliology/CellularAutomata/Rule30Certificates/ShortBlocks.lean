theorem sync24_forever (x : Nat) (hx : x.testBit 0 = true) (n : Nat) :
    evolve (n+33) x %2^24 ∈ C33 := by
  induction n with
  | zero => exact sync24 x hx
  | succ n ih =>
    change f (evolve (n+33) x) %2^24 ∈ C33
    exact fixed_sound clock_closed ih


